                                        Margin="0,0,3,0"
                                        Padding="3,0"
                                        Content="✓ Enter"
                                        AutomationProperties.AutomationId="CanvasPolygonCompleteButton"
                                        AutomationProperties.Name="폴리곤 완료 Enter"
                                        ToolTip="폴리곤 완료 (Enter)"
                                        Command="{Binding CompletePolygonDraftCommand}" />
                                <Button Grid.Column="2"
                                        Style="{StaticResource CanvasPolygonCancelButtonStyle}"
                                        Height="34"
                                        Padding="3,0"
                                        Content="✕ Esc"
                                        AutomationProperties.AutomationId="CanvasPolygonCancelButton"
                                        AutomationProperties.Name="폴리곤 취소 Esc"
                                        ToolTip="폴리곤 취소 (Esc)"
                                        Command="{Binding CancelPolygonDraftCommand}" />
                            </Grid>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
            <Border x:Name="CanvasAnnotationToolRail"
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.RowSpan="9"
                    Panel.ZIndex="10"
                    HorizontalAlignment="Left"
                    Width="{Binding AnnotationToolRailWidth.Value}"
                    Background="{DynamicResource DatasetSurfaceBrush}"
                    BorderBrush="{DynamicResource DatasetBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="1,8,0,8"
                    AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfShell.Canvas.AnnotationTools], RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}">
                <Border.Style>
                    <Style TargetType="Border"><Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Visibility" Value="{Binding AnnotationWorkspaceVisibility}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </Border.Style>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                    <ListBox x:Name="CanvasAnnotationToolListBox"
                             Style="{StaticResource CanvasAnnotationToolListBoxStyle}"
                             ItemContainerStyle="{StaticResource CanvasAnnotationToolItemStyle}"
                             ItemTemplate="{StaticResource CanvasAnnotationToolItemTemplate}"
                             ItemsSource="{Binding AnnotationTools}"
                             SelectedItem="{Binding SelectedAnnotationTool, Mode=OneWay}"
                             mvvm:InputCommandBehaviors.SelectedItemChangedCommand="{Binding AnnotationToolSelectionChangedCommand}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                    <StackPanel x:Name="CanvasRailCommands" Margin="0,4,0,0">
                        <ui:Button x:Name="CanvasUndoAnnotationButton"
                                   Style="{StaticResource CanvasCommandButtonStyle}"
                                   Height="Auto" MinHeight="46" Padding="0" Margin="0,0,0,4"
                                   Background="Transparent" BorderBrush="Transparent" FontSize="9"
                                   ToolTip="{Binding UndoAnnotationTool.ToolTip}"
                                   AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfAnnotationTool.Undo], RelativeSource={RelativeSource AncestorType=Window}}"
                                   IsEnabled="{Binding UndoAnnotationTool.IsActionEnabled}"
                                   Command="{Binding UndoAnnotationCommand}">
                            <iconPacks:PackIconMaterial Style="{StaticResource CanvasCommandIconStyle}" Kind="UndoVariant" Margin="0" HorizontalAlignment="Center" />
                        </ui:Button>
                        <ui:Button x:Name="CanvasRedoAnnotationButton"
                                   Style="{StaticResource CanvasCommandButtonStyle}"
                                   Height="Auto" MinHeight="46" Padding="0" Margin="0,0,0,4"
                                   Background="Transparent" BorderBrush="Transparent" FontSize="9"
                                   ToolTip="{Binding RedoAnnotationTool.ToolTip}"
                                   AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfAnnotationTool.Redo], RelativeSource={RelativeSource AncestorType=Window}}"
                                   IsEnabled="{Binding RedoAnnotationTool.IsActionEnabled}"
                                   Command="{Binding RedoAnnotationCommand}">
                            <iconPacks:PackIconMaterial Style="{StaticResource CanvasCommandIconStyle}" Kind="RedoVariant" Margin="0" HorizontalAlignment="Center" />
                        </ui:Button>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="CanvasViewerFooter" Grid.Column="1" Grid.ColumnSpan="2"
                    Grid.Row="8"
                    BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="0,1,0,0"
                    MinHeight="34"
                    Padding="12,3"
                    Background="{DynamicResource PanelHeaderBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>

                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel><WrapPanel x:Name="CanvasViewerZoomControls" VerticalAlignment="Center" UseLayoutRounding="False" Margin="0,-2,-10,-2"><ui:Button x:Name="ZoomOutCanvasButton"
                               Style="{StaticResource CanvasCommandButtonStyle}" Height="Auto" MinHeight="24" FontSize="12" Width="30" MinWidth="30" Padding="4" Margin="0,2,10,2"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ZoomOut], RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ZoomOut], RelativeSource={RelativeSource AncestorType=Window}}"
                               Command="{Binding DataContext.ZoomOutCommand, ElementName=MainCanvasView}">
                        <TextBlock Text="−" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"/>
                    </ui:Button><TextBlock x:Name="CanvasZoomPercentText"
                               Text="{Binding DataContext.ZoomPercentText, ElementName=MainCanvasView}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular"
                               Width="44" Margin="0,2,10,2"
                               TextAlignment="Center"
                               VerticalAlignment="Center" /><ui:Button x:Name="ZoomInCanvasButton"
                               Style="{StaticResource CanvasCommandButtonStyle}" Height="Auto" MinHeight="24" FontSize="12" Width="30" MinWidth="30" Padding="4" Margin="0,2,10,2"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ZoomIn], RelativeSource={RelativeSource AncestorType=Window}}"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ZoomIn], RelativeSource={RelativeSource AncestorType=Window}}"
                               Command="{Binding DataContext.ZoomInCommand, ElementName=MainCanvasView}">
                        <TextBlock Text="+" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"/>
                    </ui:Button><ui:Button x:Name="FitCanvasButton"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.Fit], RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CanvasCommandButtonStyle}" Height="24" MinHeight="24" MinWidth="0" FontSize="12" Padding="8,2" Margin="0,2,10,2"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.Fit.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                               IsEnabled="{Binding IsFitEnabled}"
                               Command="{Binding FitCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock TargetUpdated="OnCanvasFooterCaptionTargetUpdated" Text="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.Fit], RelativeSource={RelativeSource AncestorType=Window}, NotifyOnTargetUpdated=True}" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </ui:Button><ui:Button x:Name="ActualSizeCanvasButton"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ActualSize], RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CanvasCommandButtonStyle}" Height="24" MinHeight="24" MinWidth="0" FontSize="12" Padding="8,2" Margin="0,2,10,2"
                               AutomationProperties.AutomationId="ActualSizeCanvasButton"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ActualSize.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                               IsEnabled="{Binding IsActualSizeEnabled}"
                               Command="{Binding ActualSizeCommand}">
                        <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.ActualSize], RelativeSource={RelativeSource AncestorType=Window}}" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"/>
                    </ui:Button><CheckBox x:Name="CanvasKeepZoomCheckBox" Style="{StaticResource RecipeCheckBoxStyle}" MinHeight="24" FontSize="12" MaxWidth="290" VerticalAlignment="Center" Margin="0,2,10,2" IsChecked="{Binding DataContext.LabelingPreferencesViewModel.KeepZoomOnImageMove, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" AutomationProperties.AutomationId="CanvasKeepZoomCheckBox" AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.KeepZoom], RelativeSource={RelativeSource AncestorType=Window}}"><TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.KeepZoom], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="NoWrap"/></CheckBox><Border x:Name="CanvasFooterFlexibleSpace" Width="0" Height="0" Margin="0,2,10,2" IsHitTestVisible="False"/><CheckBox x:Name="CanvasOverlayVisibilityCheckBox" TextBlock.LineHeight="17.4" TextBlock.LineStackingStrategy="BlockLineHeight"
                              Style="{StaticResource RecipeCheckBoxStyle}"
                              MinWidth="0" MinHeight="24" Height="24" FontSize="12"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.OverlayVisibility], RelativeSource={RelativeSource AncestorType=Window}}"
                              Content="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.OverlayVisibility], RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.OverlayVisibility.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,2,10,2"
                              VerticalAlignment="Center"
                              AutomationProperties.AutomationId="CanvasOverlayVisibilityCheckBox"
                              IsEnabled="{Binding IsFitEnabled}"
                              IsChecked="{Binding AreOverlaysVisible, Mode=TwoWay}" /><Slider x:Name="CanvasOverlayOpacitySlider"
                            Style="{StaticResource RecipeSliderStyle}"
                            MinWidth="0" MinHeight="0" Height="18"
                            Width="90"
                            IsEnabled="{Binding IsFitEnabled}"
                            Minimum="0"
                            Maximum="{Binding OverlayOpacityMaximum}"
                            SmallChange="0.01"
                            TickFrequency="0.01"
                            Margin="2,4,12,4"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="CanvasOverlayOpacitySlider" AutomationProperties.HelpText="{Binding OverlayOpacityText}"
                            AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.OverlayOpacity], RelativeSource={RelativeSource AncestorType=Window}}"
                            ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.OverlayOpacity.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                            Value="{Binding OverlayOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" /><TextBlock x:Name="CanvasOverlayOpacityPercentText" Visibility="Collapsed"
                               Text="{Binding OverlayOpacityText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="10.5"
                               Width="38"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center" /><TextBlock x:Name="CanvasHoldOriginalHintText" Text="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.HoldOriginal], RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding TemporaryOriginalViewToolTip}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource RecipeDisabledTextBrush}" VerticalAlignment="Center" Margin="0,2,10,2"/><ui:Button x:Name="DisplayAdjustmentCanvasButton"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.BrightnessContrast], RelativeSource={RelativeSource AncestorType=Window}}"
                               Style="{StaticResource CanvasCommandButtonStyle}" Height="24" MinHeight="24" MinWidth="0" FontSize="12" Padding="8,2" Margin="0,2,10,2"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.DisplayAdjustment.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                               AutomationProperties.AutomationId="DisplayAdjustmentCanvasButton"
                               IsEnabled="{Binding IsDisplayAdjustmentEnabled}"
                               Command="{Binding ToggleDisplayAdjustmentCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock TargetUpdated="OnCanvasFooterCaptionTargetUpdated" Text="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.BrightnessContrast], RelativeSource={RelativeSource AncestorType=Window}, NotifyOnTargetUpdated=True}" LineHeight="17.4" LineStackingStrategy="BlockLineHeight"/>
                        </StackPanel>
                    </ui:Button></WrapPanel><TextBlock x:Name="CanvasLabelingPreferenceStatusText" Text="{Binding DataContext.LabelingPreferencesViewModel.StatusText, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
            </Border>
            <Border x:Name="CanvasInferenceFooter" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="8" Height="34" Padding="12,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrushDark}" Background="{DynamicResource PanelHeaderBrush}"
                    Visibility="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.FileName, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.FileName, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox x:Name="CanvasSavedGroundTruthCheckBox" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource RecipeCheckBoxStyle}" FontSize="12" MinHeight="24" VerticalAlignment="Center"
                              Visibility="{Binding IsSavedGroundTruthApplicable, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsSavedGroundTruthAvailable}" IsChecked="{Binding ShowSavedGroundTruth, Mode=TwoWay}"
                              Content="{Binding DataContext.LanguageViewModel[WpfCanvas.Reference.GT.Toggle], RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding GroundTruthOverlayStatusText}" AutomationProperties.HelpText="{Binding GroundTruthOverlayStatusText}" AutomationProperties.AutomationId="CanvasSavedGroundTruthCheckBox" />
                    <CheckBox x:Name="CanvasInferenceHeatmapCheckBox" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource RecipeCheckBoxStyle}" FontSize="12" MinHeight="24" VerticalAlignment="Center"
                              Visibility="{Binding IsInferenceHeatmapApplicable, Converter={StaticResource BooleanToVisibilityConverter}}" IsEnabled="{Binding IsInferenceHeatmapAvailable}" IsChecked="{Binding ShowInferenceHeatmap, Mode=TwoWay}"
                              Content="{Binding DataContext.LanguageViewModel[WpfCanvas.Reference.HM.Toggle], RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="{Binding HeatmapOverlayStatusText}" AutomationProperties.HelpText="{Binding HeatmapOverlayStatusText}" AutomationProperties.AutomationId="CanvasInferenceHeatmapCheckBox" />
                    <ui:Button x:Name="PreviousInferenceImageButton" Grid.Column="2" Style="{StaticResource CanvasCommandButtonStyle}" Width="28" MinWidth="28" Height="24" Margin="0,0,10,0" Padding="4,0" Command="{Binding PreviousInferenceImageCommand}" ToolTip="{Binding DataContext.LanguageViewModel[WpfInference.Image.Previous], RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfInference.Image.Previous], RelativeSource={RelativeSource AncestorType=Window}}" Content="←" />
                    <ui:Button x:Name="NextInferenceImageButton" Grid.Column="3" Style="{StaticResource CanvasCommandButtonStyle}" Width="28" MinWidth="28" Height="24" Margin="0" Padding="4,0" Command="{Binding NextInferenceImageCommand}" ToolTip="{Binding DataContext.LanguageViewModel[WpfInference.Image.Next], RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfInference.Image.Next], RelativeSource={RelativeSource AncestorType=Window}}" Content="→" />
                </Grid>
            </Border>
            <Border x:Name="DatasetCanvasImagePathPanel" Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="9" BorderBrush="{DynamicResource DatasetBorderBrush}" BorderThickness="0,1,0,0" Padding="14,10" Background="{DynamicResource DatasetSurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Expander x:Name="DatasetCanvasImagePathExpander"
                          Header="{Binding DataContext.LanguageViewModel[WpfDatasetHome.ImagePath], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeMutedTextBrush}" IsExpanded="True" Style="{DynamicResource DatasetExpanderStyle}">
                    <TextBox x:Name="DatasetCanvasImagePathBox"
                             Text="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.ImagePath, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay, TargetNullValue=''}"
                             AutomationProperties.AutomationId="DatasetCanvasImagePathBox"
                             AutomationProperties.Name="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.FileName, RelativeSource={RelativeSource AncestorType=Window}}"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" MaxHeight="70" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             Padding="0" Margin="0,4,0,0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource RecipeTextBrush}" FontFamily="{DynamicResource UiFontFamily}" FontSize="12" />
                </Expander>
            </Border>
        </Grid>
    </Border>
</UserControl>
