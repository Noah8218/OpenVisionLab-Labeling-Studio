<UserControl x:Class="MvcVisionSystem.WpfCanvasPanel"
             x:Name="CanvasPanelRoot"
             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:canvas="clr-namespace:OpenVisionLab.ImageCanvas.Views;assembly=OpenVisionLab.ImageCanvas"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="CanvasCommandButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Template" Value="{DynamicResource WpfUiDarkButtonTemplate}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CanvasCommandIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CanvasBoxDrawingMethodComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,0,22,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayText}"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource RecipeComboBoxItemStyle}">
                        <Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                        <Setter Property="Padding" Value="8,6" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid x:Name="ToolOptionSurface" SnapsToDevicePixels="True">
                            <Border x:Name="ToolOptionBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7" />
                            <TextBlock Text="{Binding SelectedItem.DisplayText, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       IsHitTestVisible="False" />
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Width="8"
                                                  Height="4"
                                                  Stretch="Fill"
                                                  Fill="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,7,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource DatasetInputBrush}"
                                        BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToolOptionBorder" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToolOptionBorder" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToolOptionBorder" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                                <Setter TargetName="ToolOptionBorder" Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmartMaskPointToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource RecipeFilterToggleStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InferenceChoiceRadioStyle" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Background" Value="{DynamicResource RecipeButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChoiceChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SelectionMark"
                                           Text="✓"
                                           Visibility="Collapsed"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource RecipeAccentBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource RecipeButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource RecipeAccentBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ChoiceChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                                <Setter TargetName="ChoiceChrome" Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmartMaskReferenceModeButtonStyle"
               TargetType="ToggleButton"
               BasedOn="{StaticResource SmartMaskPointToggleStyle}">
            <Setter Property="MinWidth" Value="108" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style x:Key="CanvasPolygonConfirmButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{DynamicResource WpfDarkButtonTemplate}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="CanvasPolygonCancelButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource CanvasPolygonConfirmButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <SolidColorBrush x:Key="DetectionOverlayConfirmableBackgroundBrush" Color="#33031D12" />
        <SolidColorBrush x:Key="DetectionOverlayConfirmableBorderBrush" Color="#5524D366" />
        <SolidColorBrush x:Key="DetectionOverlayConfirmableAccentBrush" Color="#24D366" />
        <SolidColorBrush x:Key="DetectionOverlayConfirmableChipBrush" Color="#1F24D366" />
        <SolidColorBrush x:Key="DetectionOverlayDuplicateBackgroundBrush" Color="#331E1705" />
        <SolidColorBrush x:Key="DetectionOverlayDuplicateBorderBrush" Color="#806A2A" />
        <SolidColorBrush x:Key="DetectionOverlayDuplicateAccentBrush" Color="#F5C542" />
        <SolidColorBrush x:Key="DetectionOverlayDuplicateChipBrush" Color="#33F5C542" />
        <SolidColorBrush x:Key="DetectionOverlayReviewBackgroundBrush" Color="#331E1302" />
        <SolidColorBrush x:Key="DetectionOverlayReviewBorderBrush" Color="#805A3B0A" />
        <SolidColorBrush x:Key="DetectionOverlayReviewAccentBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="DetectionOverlayReviewChipBrush" Color="#33F59E0B" />

        <Style x:Key="DetectionOverlayPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DetectionOverlayBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DetectionOverlayBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Confirmable">
                    <Setter Property="Background" Value="{StaticResource DetectionOverlayConfirmableBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DetectionOverlayConfirmableBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Duplicate">
                    <Setter Property="Background" Value="{StaticResource DetectionOverlayDuplicateBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DetectionOverlayDuplicateBorderBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Review">
                    <Setter Property="Background" Value="{StaticResource DetectionOverlayReviewBackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource DetectionOverlayReviewBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetectionOverlaySummaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DetectionOverlaySummaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Confirmable">
                    <Setter Property="Foreground" Value="{StaticResource DetectionOverlayConfirmableAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Duplicate">
                    <Setter Property="Foreground" Value="{StaticResource DetectionOverlayDuplicateAccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DetectionOverlayStatusKey}" Value="Review">
                    <Setter Property="Foreground" Value="{StaticResource DetectionOverlayReviewAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetectionOverlayActionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource CanvasCommandButtonStyle}">
            <Setter Property="Height" Value="22" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Margin" Value="0,0,3,0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Button}">
                        <Border x:Name="DetectionOverlayActionButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="Background"
                                        Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="Background"
                                        Value="{DynamicResource SelectedRowBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="Background"
                                        Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="DetectionOverlayActionButtonChrome"
                                        Property="BorderBrush"
                                        Value="{DynamicResource ToolbarButtonBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="DetectionOverlayActionButtonChrome" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="CanvasToolContextButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="CanvasToolContextToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource RecipeFilterToggleStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CanvasToolContextPrimaryButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipePrimaryButtonStyle}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="CanvasAnnotationCommandButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource CanvasToolContextButtonStyle}">
            <Setter Property="Width" Value="30" />
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="CanvasWorkflowModeButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource CanvasCommandButtonStyle}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Padding" Value="6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CanvasAnnotationSaveButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource CanvasCommandButtonStyle}">
            <Setter Property="Height" Value="27" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="8,0,4,0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="True">
                    <Setter Property="Background" Value="#DC2626" />
                    <Setter Property="BorderBrush" Value="#EF4444" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EF4444" />
                    <Setter Property="BorderBrush" Value="#F87171" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="Opacity" Value="0.62" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CanvasAnnotationToolListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MaxHeight" Value="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="CanvasAnnotationToolItemStyle" TargetType="ListBoxItem">
            <Setter Property="MaxWidth" Value="68" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Content.AutomationId, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Content.AccessibleName, RelativeSource={RelativeSource Self}}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Content.ToolTip, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsEnabled" Value="{Binding IsActionEnabled}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                <iconPacks:PackIconMaterial x:Name="ToolSelectionIndicator"
                                                            Kind="Check"
                                                            Width="9"
                                                            Height="9"
                                                            Margin="0,1,0,0"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Top"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            IsHitTestVisible="False"
                                                            Visibility="Collapsed" />
                                <Border x:Name="ToolFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ToolSelectionIndicator" Property="Visibility" Value="Visible" />
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ToolFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                                <Setter TargetName="ItemChrome" Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                                <Setter TargetName="ToolFocusCue" Property="BorderBrush" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="CanvasAnnotationToolItemTemplate">
            <Grid MinHeight="44"
                  AutomationProperties.Name="{Binding DisplayText}"
                  AutomationProperties.HelpText="{Binding ToolTip}"
                  ToolTip="{Binding ToolTip}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding ShortcutText}"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                           FontSize="8"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="3,1,0,0" />
                <iconPacks:PackIconMaterial x:Name="ToolIcon"
                                            Kind="{Binding IconKind}"
                                            Width="18"
                                            Height="18"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Margin="0,3,0,0" />
                <TextBlock x:Name="ToolCaption" Grid.Row="1"
                           Text="{Binding DisplayText}"
                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                           FontSize="10"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="None"
