<ui:FluentWindow x:Class="MvcVisionSystem.WpfDatasetInterchangeWindow"
                 x:Name="DatasetInterchangeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="&#xB370;&#xC774;&#xD130;&#xC14B; &#xBCC0;&#xD658; &#xC0AC;&#xC804;&#xAC80;&#xC0AC;"
                 Width="1240"
                 Height="780"
                 MinWidth="1040"
                 MinHeight="680"
                 Background="{DynamicResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0D0F" />
            <SolidColorBrush x:Key="PanelBrush" Color="#171717" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#101820" />
            <SolidColorBrush x:Key="BorderBrushDark" Color="#303030" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7B7B7" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
            <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#252525" />
            <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="GridHeaderBrush" Color="#202020" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="ProblemBrush" Color="#EF4444" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="InterchangeButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Template" Value="{StaticResource WpfUiDarkButtonTemplate}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,4" />
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="InterchangeLabelStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="InterchangeTextBoxStyle" TargetType="{x:Type TextBox}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                <Setter Property="CaretBrush" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="7,3" />
                <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
            </Style>

            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource CanvasBrush}" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="CanUserSortColumns" Value="False" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="RowHeight" Value="40" />
                <Setter Property="IsReadOnly" Value="True" />
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Padding" Value="9,7" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="20,18,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="38"
                    Height="38"
                    Background="{DynamicResource CanvasBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,0,11,0">
                <iconPacks:PackIconMaterial Kind="SwapHorizontal"
                                            Width="21"
                                            Height="21"
                                            Foreground="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="&#xB370;&#xC774;&#xD130;&#xC14B; &#xBCC0;&#xD658; &#xC0AC;&#xC804;&#xAC80;&#xC0AC;"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Text="Dry-run&#xC740; &#xC784;&#xC2DC; &#xACA9;&#xB9AC; &#xACF5;&#xAC04;&#xC5D0;&#xC11C;&#xB9CC; &#xC2E4;&#xD589;&#xB418;&#xBA70;, &#xC801;&#xC6A9;&#xC744; &#xB204;&#xB974;&#xAE30; &#xC804;&#xC5D0;&#xB294; &#xC2E4;&#xC81C; &#xB300;&#xC0C1;&#xC744; &#xBCC0;&#xACBD;&#xD558;&#xC9C0; &#xC54A;&#xC2B5;&#xB2C8;&#xB2E4;."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="10.5"
                           Margin="0,3,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding DatasetName}"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="10.5"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Right" />
                <TextBlock Text="{Binding DatasetPurposeText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="9.5"
                           HorizontalAlignment="Right"
                           Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="1. &#xBCC0;&#xD658; &#xACC4;&#xC57D;"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />
                        <TextBlock Text="&#xD615;&#xC2DD; &#xBC0F; &#xBC29;&#xD5A5;"
                                   Style="{StaticResource InterchangeLabelStyle}" />
                        <ComboBox x:Name="DatasetInterchangeOperationCombo"
                                  ItemsSource="{Binding Operations}"
                                  SelectedItem="{Binding SelectedOperation}"
                                  DisplayMemberPath="DisplayText"
                                  AutomationProperties.AutomationId="DatasetInterchangeOperationCombo"
                                  AutomationProperties.Name="&#xBCC0;&#xD658; &#xD615;&#xC2DD; &#xBC0F; &#xBC29;&#xD5A5;" />
                        <TextBlock Text="{Binding OperationContractText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="9.5"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,16" />

                        <TextBlock Text="{Binding SourceLabelText}"
                                   Style="{StaticResource InterchangeLabelStyle}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DatasetInterchangeSourcePathBox"
                                     Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsExport}"
                                     Style="{StaticResource InterchangeTextBoxStyle}"
                                     AutomationProperties.AutomationId="DatasetInterchangeSourcePathBox"
                                     AutomationProperties.Name="&#xBCC0;&#xD658; &#xC6D0;&#xBCF8; &#xACBD;&#xB85C;" />
                            <ui:Button Grid.Column="1"
                                       Width="72"
                                       Margin="7,0,0,0"
                                       Style="{StaticResource InterchangeButtonStyle}"
                                       Command="{Binding BrowseSourceCommand}"
                                       Visibility="{Binding IsImport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="&#xBCC0;&#xD658; &#xC6D0;&#xBCF8; &#xC120;&#xD0DD;">
                                <TextBlock Text="&#xC120;&#xD0DD;" />
                            </ui:Button>
                        </Grid>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding RequiresImageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xC6D0;&#xBCF8; &#xC774;&#xBBF8;&#xC9C0; &#xD3F4;&#xB354;"
                                       Style="{StaticResource InterchangeLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding ImageRoot, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource InterchangeTextBoxStyle}"
                                         AutomationProperties.Name="&#xC6D0;&#xBCF8; &#xC774;&#xBBF8;&#xC9C0; &#xD3F4;&#xB354;" />
                                <ui:Button Grid.Column="1"
                                           Width="72"
                                           Margin="7,0,0,0"
                                           Style="{StaticResource InterchangeButtonStyle}"
                                           Command="{Binding BrowseImageRootCommand}"
                                           AutomationProperties.Name="&#xC6D0;&#xBCF8; &#xC774;&#xBBF8;&#xC9C0; &#xD3F4;&#xB354; &#xC120;&#xD0DD;">
                                    <TextBlock Text="&#xC120;&#xD0DD;" />
                                </ui:Button>
                            </Grid>
                        </StackPanel>

                        <TextBlock Text="{Binding TargetLabelText}"
                                   Style="{StaticResource InterchangeLabelStyle}"
                                   Margin="0,14,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DatasetInterchangeTargetPathBox"
                                     Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsImport}"
                                     Style="{StaticResource InterchangeTextBoxStyle}"
                                     AutomationProperties.AutomationId="DatasetInterchangeTargetPathBox"
                                     AutomationProperties.Name="&#xBCC0;&#xD658; &#xB300;&#xC0C1; &#xACBD;&#xB85C;" />
                            <ui:Button Grid.Column="1"
                                       Width="72"
                                       Margin="7,0,0,0"
                                       Style="{StaticResource InterchangeButtonStyle}"
                                       Command="{Binding BrowseTargetCommand}"
                                       Visibility="{Binding IsExport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.Name="&#xBCC0;&#xD658; &#xB300;&#xC0C1; &#xC120;&#xD0DD;">
                                <TextBlock Text="&#xC120;&#xD0DD;" />
                            </ui:Button>
                        </Grid>

                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding IsImport, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="&#xAC00;&#xC838;&#xC624;&#xAE30; &#xBD84;&#xD560;"
                                       Style="{StaticResource InterchangeLabelStyle}" />
                            <ComboBox ItemsSource="{Binding Splits}"
                                      SelectedItem="{Binding TargetSplit}"
                                      AutomationProperties.Name="&#xAC00;&#xC838;&#xC624;&#xAE30; &#xB300;&#xC0C1; &#xBD84;&#xD560;" />
                        </StackPanel>

                        <Border Background="{DynamicResource CanvasBrush}"
                                BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="11,9"
                                Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="&#xC801;&#xC6A9; &#xC804; &#xBCF4;&#xC7A5;"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="&#xC6D0;&#xBCF8; &#xD574;&#xC2DC;, &#xC694;&#xCCAD; &#xB300;&#xC0C1; &#xBBF8;&#xBCC0;&#xACBD;, &#xAC74;&#xB108;&#xB700; &#xB808;&#xCF54;&#xB4DC;, &#xD615;&#xC2DD; &#xC190;&#xC2E4; &#xACBD;&#xACE0;&#xB97C; &#xD655;&#xC778;&#xD569;&#xB2C8;&#xB2E4;."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="9.5"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="{DynamicResource CanvasBrush}"
                        BorderBrush="{DynamicResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <iconPacks:PackIconMaterial Kind="ClipboardCheckOutline"
                                                    Width="20"
                                                    Height="20"
                                                    Foreground="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Top"
                                                    Margin="0,1,11,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="DatasetInterchangeStatusText"
                                       Text="{Binding StatusText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       AutomationProperties.AutomationId="DatasetInterchangeStatusText" />
                            <TextBlock Text="{Binding StatusDetailText}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="10.5"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="{Binding MetricText}"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontFamily="Segoe UI"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Margin="0,9,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="11,9">
                        <TextBlock Text="{Binding SourceIntegrityText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                    <Border Grid.Column="2"
                            Background="{DynamicResource PanelBrush}"
                            BorderBrush="{DynamicResource BorderBrushDark}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="11,9">
                        <TextBlock Text="{Binding TargetIntegrityText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="10"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource BorderBrushDark}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="2. &#xCC28;&#xB2E8; &#xBC0F; &#xC8FC;&#xC758; &#xD56D;&#xBAA9;"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10" />
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding Findings}"
                                  AutomationProperties.Name="&#xBCC0;&#xD658; &#xC0AC;&#xC804;&#xAC80;&#xC0AC; &#xACB0;&#xACFC;">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#xAD6C;&#xBD84;"
                                                    Binding="{Binding SeverityText}"
                                                    Width="72" />
                                <DataGridTextColumn Header="&#xC0C1;&#xC138;"
                                                    Binding="{Binding Text}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xC0AC;&#xC804;&#xAC80;&#xC0AC; &#xACB0;&#xACFC;&#xC640; &#xC785;&#xB825;&#xC774; &#xC77C;&#xCE58;&#xD560; &#xB54C;&#xB9CC; &#xC801;&#xC6A9;&#xC774; &#xD65C;&#xC131;&#xD654;&#xB429;&#xB2C8;&#xB2E4;."
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button x:Name="DatasetInterchangeDryRunButton"
                           MinWidth="112"
                           Style="{StaticResource InterchangeButtonStyle}"
                           Command="{Binding DryRunCommand}"
                           AutomationProperties.AutomationId="DatasetInterchangeDryRunButton"
                           AutomationProperties.Name="Dry-run &#xC0AC;&#xC804;&#xAC80;&#xC0AC;">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="FlaskOutline" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="Dry-run" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="DatasetInterchangeApplyButton"
                           MinWidth="112"
                           Margin="8,0,0,0"
                           Style="{StaticResource InterchangeButtonStyle}"
                           Command="{Binding ApplyCommand}"
                           IsEnabled="{Binding CanApply}"
                           AutomationProperties.AutomationId="DatasetInterchangeApplyButton"
                           AutomationProperties.Name="&#xBCC0;&#xD658; &#xC801;&#xC6A9;">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="CheckBold" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="&#xC801;&#xC6A9;" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
