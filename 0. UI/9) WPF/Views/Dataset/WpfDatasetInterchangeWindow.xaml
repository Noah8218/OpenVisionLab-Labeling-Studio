<ui:FluentWindow x:Class="MvcVisionSystem.WpfDatasetInterchangeWindow"
                 x:Name="DatasetInterchangeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:local="clr-namespace:MvcVisionSystem"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Background="{DynamicResource RecipeSurfaceBrush}" FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.CommandBindings>
        <CommandBinding Command="{x:Static SystemCommands.CloseWindowCommand}" Executed="OnCloseWindowExecuted" />
    </ui:FluentWindow.CommandBindings>
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="Escape" Command="{x:Static SystemCommands.CloseWindowCommand}" />
    </ui:FluentWindow.InputBindings>
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ErrorBrush" Color="#EF4444" />
            <SolidColorBrush x:Key="InterchangeFooterBrush" Color="#1B212A" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <local:KoreanWordBoundaryConverter x:Key="InterchangeWordBoundaryConverter" />
            <DataTemplate x:Key="InterchangeFormatTemplate">
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding DisplayText}" />
                            <Style.Triggers><DataTrigger Binding="{Binding TemplatedParent.Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Text" Value="{Binding FormatText}" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <Style x:Key="InterchangeButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            </Style>
            <Style x:Key="InterchangePrimaryButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipePrimaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" /><Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="InterchangeLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /><Setter Property="FontSize" Value="12" />
                <Setter Property="LineHeight" Value="17.4" />
                <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,0,0,4" />
                <Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="0,0,0,6" /></DataTrigger></Style.Triggers>
            </Style>
            <Style x:Key="InterchangeTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
                <Setter Property="MinHeight" Value="30" /><Setter Property="Height" Value="Auto" /><Setter Property="FontSize" Value="13" /><Setter Property="Padding" Value="8,5" />
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="AcceptsReturn" Value="False" /><Setter Property="AcceptsTab" Value="False" />
                <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Setter Property="CaretBrush" Value="{DynamicResource RecipeTextBrush}" /><Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="MinHeight" Value="38" /></DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                    <Trigger Property="IsReadOnly" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /></Trigger>
                    <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
                <Setter Property="Height" Value="Auto" /><Setter Property="MinHeight" Value="30" />
                <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="MinHeight" Value="38" /></DataTrigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /></Trigger></Style.Triggers>
            </Style>
            <Style x:Key="InterchangeLossConfirmationStyle" TargetType="CheckBox">
                <Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="38" /><Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28"><Border x:Name="CheckChrome" Margin="4" CornerRadius="4" Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" /><Path x:Name="CheckMark" Data="M 8,14 L 12,18 L 20,9" Stroke="{DynamicResource RecipeTextBrush}" StrokeThickness="2" Visibility="Collapsed" /></Grid>
                        <ContentPresenter Grid.Column="1" ContentSource="Content" Margin="6,0" VerticalAlignment="Center" />
                        <Border x:Name="CheckFocusCue" Grid.ColumnSpan="2" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipePrimaryBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeAccentBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeButtonPressedBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CheckFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="RowBackground" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource RecipePageBrush}" />
                <Setter Property="HeadersVisibility" Value="Column" /><Setter Property="FontSize" Value="13" /><Setter Property="CanUserSortColumns" Value="False" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="MinColumnWidth" Value="80" />
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="{DynamicResource RecipeButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="InterchangeWrappedCellTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="8,7" />
                <Setter Property="TextTrimming" Value="None" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>
    <ui:FluentWindow.Style>
        <Style TargetType="{x:Type ui:FluentWindow}" BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
            <Setter Property="Title" Value="{Binding LanguageViewModel[WpfDatasetInterchange.Summary.Title.Export]}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImport}" Value="True"><Setter Property="Title" Value="{Binding LanguageViewModel[WpfDatasetInterchange.Summary.Title.Import]}" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Style>
    <DockPanel LastChildFill="True" Background="{DynamicResource RecipeSurfaceBrush}">
        <ui:TitleBar x:Name="DatasetInterchangeTitleBar" DockPanel.Dock="Top" Height="52" FontSize="15" FontWeight="SemiBold"
                     Title="{Binding Title, ElementName=DatasetInterchangeWindow}" ShowMinimize="False" ShowMaximize="False"
                     Background="{DynamicResource RecipeSurfaceBrush}" Foreground="{DynamicResource RecipeTextBrush}"
                     ButtonsForeground="{DynamicResource RecipeTextBrush}" ButtonsBackground="{DynamicResource RecipeButtonHoverBrush}" />
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="24,16,24,16" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" Margin="0,0,12,0" CornerRadius="7" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1">
                    <iconPacks:PackIconMaterial Kind="SwapHorizontal" Width="21" Height="21" Foreground="{DynamicResource RecipeAccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding [WpfDatasetInterchange.Title], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding [WpfDatasetInterchange.Description], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,5,12,0"
                               Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="MaxWidth" Value="140" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="MaxWidth" Value="300" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <TextBlock Text="{Binding DatasetName}" Foreground="{DynamicResource RecipeTextBrush}" TextWrapping="Wrap" FontWeight="SemiBold" TextAlignment="Right" />
                    <TextBlock Text="{Binding DatasetPurposeText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" TextAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="20,6,20,16" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Margin" Value="24,0,24,0" /></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition>
                        <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="*" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Width" Value="2*" /><Setter Property="MinWidth" Value="300" /><Setter Property="MaxWidth" Value="430" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Width" Value="14" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                    </ColumnDefinition>
                    <ColumnDefinition>
                        <ColumnDefinition.Style><Style TargetType="ColumnDefinition"><Setter Property="Width" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Width" Value="3*" /></DataTrigger></Style.Triggers></Style></ColumnDefinition.Style>
                    </ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="7">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="16" /></DataTrigger></Style.Triggers></Style></Border.Style>
                    <ScrollViewer x:Name="DatasetInterchangeSettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Margin" Value="0,0,14,0" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                            <TextBlock Text="{Binding [WpfDatasetInterchange.Section.Contract], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" Margin="0,0,0,14" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Text="{Binding [WpfDatasetInterchange.Summary.Label.Format], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource InterchangeLabelStyle}" />
                            <ComboBox x:Name="DatasetInterchangeOperationCombo" ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" ItemTemplate="{StaticResource InterchangeFormatTemplate}" Tag="{Binding IsDetailsExpanded}"
                                      AutomationProperties.AutomationId="DatasetInterchangeOperationCombo" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.FormatDirection], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                            <TextBlock Text="{Binding OperationContractText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,10,0,16" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Margin" Value="0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsExport}" Value="True" /><Condition Binding="{Binding IsDetailsExpanded}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding SourceLabelText}" Style="{StaticResource InterchangeLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DatasetInterchangeSourcePathBox" Text="{Binding SourcePath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsExport}" Style="{StaticResource InterchangeTextBoxStyle}"
                                             AutomationProperties.AutomationId="DatasetInterchangeSourcePathBox" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.SourcePath], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    <ui:Button Grid.Column="1" MinWidth="76" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource InterchangeButtonStyle}" Command="{Binding BrowseSourceCommand}" Visibility="{Binding IsImport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.SourceSelect], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                                        <TextBlock Text="{Binding [WpfDatasetInterchange.Button.Select], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding RequiresImageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding [WpfDatasetInterchange.Label.SourceImages], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource InterchangeLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding ImageRoot, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InterchangeTextBoxStyle}" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.SourceImages], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    <ui:Button Grid.Column="1" MinWidth="76" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource InterchangeButtonStyle}" Command="{Binding BrowseImageRootCommand}" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.SourceImagesSelect], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                                        <TextBlock Text="{Binding [WpfDatasetInterchange.Button.Select], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel>
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Margin" Value="0,16,0,0" /></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsImport}" Value="True" /><Condition Binding="{Binding IsDetailsExpanded}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding TargetLabelText}" Style="{StaticResource InterchangeLabelStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox x:Name="DatasetInterchangeTargetPathBox" Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsImport}" Style="{StaticResource InterchangeTextBoxStyle}"
                                             AutomationProperties.AutomationId="DatasetInterchangeTargetPathBox" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.TargetPath], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    <ui:Button Grid.Column="1" MinWidth="76" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource InterchangeButtonStyle}" Command="{Binding BrowseTargetCommand}" Visibility="{Binding IsExport, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.TargetSelect], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                                        <TextBlock Text="{Binding [WpfDatasetInterchange.Button.Select], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                    </ui:Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel Margin="0,16,0,0" Visibility="{Binding IsImport, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [WpfDatasetInterchange.Label.ImportSplit], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource InterchangeLabelStyle}" />
                                    <ComboBox ItemsSource="{Binding SplitChoices}" DisplayMemberPath="Text" SelectedValuePath="Key" SelectedValue="{Binding TargetSplit, Mode=TwoWay}" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.ImportSplitTarget], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                                </StackPanel>
                            </StackPanel>
                            <Border Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12" Margin="0,16,0,0" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding [WpfDatasetInterchange.Label.Guarantees], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding [WpfDatasetInterchange.Guarantees.Detail], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <StackPanel Margin="0,12,0,0">
                                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsDetailsExpanded}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                <TextBlock Text="{Binding [WpfDatasetInterchange.Summary.Procedure], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="12" TextWrapping="Wrap" />
                                <TextBlock Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding LanguageViewModel[WpfDatasetInterchange.Operation.ExportContract]}" /><Style.Triggers><DataTrigger Binding="{Binding IsImport}" Value="True"><Setter Property="Text" Value="{Binding LanguageViewModel[WpfDatasetInterchange.Operation.ImportContract]}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Grid Grid.Column="2" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <iconPacks:PackIconMaterial Kind="ClipboardCheckOutline" Width="21" Height="21" Foreground="{DynamicResource RecipeAccentBrush}" Margin="0,2,12,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DatasetInterchangeStatusText" Text="{Binding StatusText}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="DatasetInterchangeStatusText" />
                                <TextBlock Text="{Binding StatusDetailText, Mode=OneWay, Converter={StaticResource InterchangeWordBoundaryConverter}}" AutomationProperties.Name="{Binding StatusDetailText, Mode=OneWay}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                <TextBlock Text="{Binding MetricText}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,10">
                            <TextBlock Text="{Binding SourceIntegrityText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,10">
                            <TextBlock Text="{Binding TargetIntegrityText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding [WpfDatasetInterchange.Section.BlockedFindings], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Label.PreflightResult], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding [WpfDatasetInterchange.Label.Category], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Binding="{Binding SeverityText}" Width="110" ElementStyle="{StaticResource InterchangeWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="{Binding [WpfDatasetInterchange.Label.Detail], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                                                        Binding="{Binding Text, Mode=OneWay, Converter={StaticResource InterchangeWordBoundaryConverter}}" ClipboardContentBinding="{Binding Text, Mode=OneWay}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource InterchangeWrappedCellTextStyle}">
                                                <Setter Property="AutomationProperties.Name" Value="{Binding Text, Mode=OneWay}" />
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Grid.Row="1" Text="{Binding [WpfDatasetInterchange.EmptyFindings], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" Margin="16" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Findings.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="150" Margin="0,12,0,0" Visibility="{Binding RequiresLossWarningConfirmation, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel>
                                    <CheckBox x:Name="DatasetInterchangeLossConfirmationCheckBox" IsChecked="{Binding ConfirmLossyExport, Mode=TwoWay}" Foreground="{DynamicResource RecipeTextBrush}" Style="{StaticResource InterchangeLossConfirmationStyle}"
                                              AutomationProperties.AutomationId="DatasetInterchangeLossConfirmationCheckBox" AutomationProperties.Name="{Binding LossWarningConfirmationText}">
                                        <TextBlock Text="{Binding LossWarningConfirmationText}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Text="{Binding LossManifestText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="34,6,0,0" />
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{StaticResource InterchangeFooterBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding [WpfDatasetInterchange.ApplyBoundary], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:Button x:Name="DatasetInterchangeDetailsToggleButton" Grid.Row="1" HorizontalAlignment="Left" Style="{StaticResource InterchangeButtonStyle}"
                               Command="{Binding ToggleDetailsCommand}" Content="{Binding DetailsToggleText}"
                               AutomationProperties.AutomationId="DatasetInterchangeDetailsToggleButton" AutomationProperties.Name="{Binding DetailsToggleText}" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button x:Name="DatasetInterchangeCancelButton" Style="{StaticResource InterchangeButtonStyle}" Margin="0,0,8,0"
                                   Command="{x:Static SystemCommands.CloseWindowCommand}" Content="{Binding [Common.Cancel], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                                   AutomationProperties.AutomationId="DatasetInterchangeCancelButton" AutomationProperties.Name="{Binding [Common.Cancel], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                        <ui:Button x:Name="DatasetInterchangeDryRunButton" MinWidth="96" MinHeight="30" Style="{StaticResource InterchangePrimaryButtonStyle}" Command="{Binding DryRunCommand}"
                                   Content="{Binding [WpfDatasetInterchange.Summary.DryRun], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                                   AutomationProperties.AutomationId="DatasetInterchangeDryRunButton" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Action.DryRunAutomation], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                        <ui:Button x:Name="DatasetInterchangeApplyButton" Visibility="{Binding IsDetailsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" MinWidth="150" Margin="8,0,0,0" Style="{StaticResource InterchangePrimaryButtonStyle}" Command="{Binding ApplyCommand}" IsEnabled="{Binding CanApply}"
                                   AutomationProperties.AutomationId="DatasetInterchangeApplyButton" AutomationProperties.Name="{Binding [WpfDatasetInterchange.Action.ApplyAutomation], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CheckBold" Width="16" Height="16" Margin="0,0,8,0" /><TextBlock Text="{Binding [WpfDatasetInterchange.Action.Apply], Source={x:Static local:WpfLocalizationViewModel.Instance}}" /></StackPanel>
                        </ui:Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
