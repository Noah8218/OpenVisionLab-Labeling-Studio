<UserControl x:Class="MvcVisionSystem.WpfRecipeLibraryPanel" x:Name="RecipeLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             AutomationProperties.AutomationId="RecipeLibraryPanel" FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
             Background="{DynamicResource RecipePageBrush}" Foreground="{DynamicResource RecipeTextBrush}" SizeChanged="OnRecipeLibrarySizeChanged"
             DataContext="{Binding DataContext.DatasetSelectionViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
             Visibility="{Binding DataContext.ShellViewModel.RecipeLibraryVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" /></ResourceDictionary.MergedDictionaries>
            <local:RecipeLibraryCompactLayoutConverter x:Key="RecipeCompactLayoutConverter" />
            <Style TargetType="Button" BasedOn="{StaticResource RecipeSecondaryButtonStyle}" />
            <Style TargetType="ToggleButton" BasedOn="{StaticResource RecipeFilterToggleStyle}" />
            <Style TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}" />
            <Style TargetType="TextBlock"><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></Style>
            <Style x:Key="RecipeReadinessStyle" TargetType="Border"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /><Setter Property="CornerRadius" Value="11" /><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="TextElement.FontSize" Value="11" /><Style.Triggers><Trigger Property="Tag" Value="✓"><Setter Property="Background" Value="{DynamicResource DatasetReadyBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource SuccessBrush}" /></Trigger><Trigger Property="Tag" Value="…"><Setter Property="Background" Value="{DynamicResource DatasetNeededBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" /></Trigger><Trigger Property="Tag" Value="!"><Setter Property="Background" Value="{DynamicResource DatasetNeededBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource WarningBrush}" /></Trigger></Style.Triggers></Style>
            <Style x:Key="RecipeWideOnlyStyle" TargetType="FrameworkElement"><Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>
            <Style x:Key="RecipeCheckedCueStyle" TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
            <Style x:Key="RecipeDisclosureStyle" TargetType="Expander">
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton Style="{StaticResource RecipeFilterToggleStyle}" Template="{StaticResource RecipeButtonTemplate}" HorizontalContentAlignment="Left" MinHeight="18" Padding="0" FontSize="12" Foreground="{DynamicResource RecipeMutedTextBrush}" Background="Transparent" BorderBrush="Transparent" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="DisclosureGlyph" Text="▸" FontSize="12" Margin="0,0,5,0" /><ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" /></StackPanel>
                        </ToggleButton>
                        <ContentPresenter x:Name="DisclosureContent" Margin="0,8,0,0" Content="{TemplateBinding Content}" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="DisclosureContent" Property="Visibility" Value="Visible" /><Setter TargetName="DisclosureGlyph" Property="Text" Value="▾" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value></Setter>
            </Style>
            <Style x:Key="RecipePipelineLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0" /><Setter Property="VerticalAlignment" Value="Center" /></Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.ContextMenu>
        <ContextMenu FontFamily="{DynamicResource UiFontFamily}" FontSize="13" x:Name="RecipeLibraryContextMenu" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Background="{DynamicResource RecipeSurfaceBrush}" Foreground="{DynamicResource RecipeTextBrush}">
            <ContextMenu.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" /></ResourceDictionary.MergedDictionaries>
                    <Style TargetType="Button" BasedOn="{StaticResource RecipeSecondaryButtonStyle}" />
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource RecipeFilterToggleStyle}" />
                    <Style TargetType="TextBlock"><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></Style>
                </ResourceDictionary>
            </ContextMenu.Resources>
            <ContextMenu.Template><ControlTemplate TargetType="ContextMenu"><Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12"><ItemsPresenter /></Border></ControlTemplate></ContextMenu.Template>
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Template><ControlTemplate TargetType="MenuItem"><ContentPresenter ContentSource="Header" /></ControlTemplate></MenuItem.Template>
                <MenuItem.Header><StackPanel Width="340">
                        <WrapPanel><Button x:Name="RecipeLibraryEditMetadataButton" Content="{Binding EditRecipeMetadataText}" Command="{Binding EditMetadataCommand}" Margin="0,0,8,8" Visibility="{Binding EditRecipeMetadataVisibility}" AutomationProperties.AutomationId="RecipeLibraryEditMetadataButton" Click="CloseAdditionalActions" /><Button x:Name="RecipeLibraryFavoriteButton" Content="{Binding SelectedDatasetFavoriteActionText}" Command="{Binding ToggleFavoriteCommand}" CommandParameter="{Binding SelectedDataset}" Margin="0,0,0,8" AutomationProperties.AutomationId="RecipeLibraryFavoriteButton" Click="CloseAdditionalActions" /></WrapPanel>
            <Expander x:Name="RecipeLibraryOptionsExpander" Header="{Binding RecipeListOptionsText}" Style="{StaticResource RecipeDisclosureStyle}" Margin="0,12,0,0" IsExpanded="True">
                <WrapPanel>
                    <ToggleButton x:Name="RecipeLibraryFavoritesFilter" Margin="0,0,8,6" IsChecked="{Binding FavoritesOnly, Mode=TwoWay}" AutomationProperties.AutomationId="RecipeLibraryFavoritesFilter" AutomationProperties.Name="{Binding FavoritesOnlyText}"><StackPanel Orientation="Horizontal"><TextBlock Text="☆" Margin="0,0,5,0" /><TextBlock Text="✓" Style="{StaticResource RecipeCheckedCueStyle}" Margin="0,0,5,0" /><TextBlock Text="{Binding FavoritesOnlyText}" /></StackPanel></ToggleButton>
                    <ToggleButton x:Name="RecipeLibraryAttentionFilter" Margin="0,0,8,6" IsChecked="{Binding NeedsAttentionOnly, Mode=TwoWay}" ToolTip="{Binding NeedsAttentionToolTipText}" AutomationProperties.AutomationId="RecipeLibraryAttentionFilter"><StackPanel Orientation="Horizontal"><TextBlock Text="✓" Style="{StaticResource RecipeCheckedCueStyle}" Margin="0,0,5,0" /><TextBlock Text="{Binding NeedsAttentionOnlyText}" /></StackPanel></ToggleButton>
                    <ComboBox x:Name="RecipeLibrarySortFilter" Width="148" Height="30" Style="{StaticResource RecipeComboBoxStyle}" Background="{DynamicResource DatasetInputBrush}" BorderBrush="{DynamicResource DatasetInputBorderBrush}" Margin="0,0,8,6" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding SortModeKey, Mode=TwoWay}" AutomationProperties.AutomationId="RecipeLibrarySortFilter" />
                    <Button x:Name="RecipeLibraryClearSearchButton" Style="{StaticResource RecipeQuietButtonStyle}" Content="{Binding RecipeResetText}" Command="{Binding ResetFiltersCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="RecipeLibraryClearSearchButton" Click="CloseAdditionalActions" />
                    <Button x:Name="RecipeLibraryRefreshButton" Content="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Margin="0,0,8,6" AutomationProperties.AutomationId="RecipeLibraryRefreshButton" Click="CloseAdditionalActions" />
                    <Button x:Name="RecipeLibraryPracticeButton" Content="{Binding RecipePracticeText}" ToolTip="{Binding RecipePracticeToolTipText}" Command="{Binding CreateNewCommand}" Margin="0,0,0,6" AutomationProperties.AutomationId="RecipeLibraryPracticeButton" Click="CloseAdditionalActions" />
                </WrapPanel>
            </Expander>
                        <Expander x:Name="RecipeLibraryHistoryExpander" Header="{Binding SavedWorkHistoryTitleText}" Style="{StaticResource RecipeDisclosureStyle}" Margin="0,8,0,8"><Border x:Name="RecipeLibraryWorkHistoryCard" Background="{DynamicResource RecipePageBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="{Binding SelectedDataset.CountText}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.StatusText}" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.ReviewWorkHistoryText}" Margin="0,6,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.InferenceWorkHistoryText}" Margin="0,6,0,0" TextWrapping="Wrap" /></StackPanel></Border></Expander>
                <DockPanel Margin="0,10,0,0"><TextBlock DockPanel.Dock="Right" Text="{Binding RecipeListKeyboardHelpText}" MaxWidth="180" TextWrapping="Wrap" Margin="12,0,0,0" FontSize="12" Foreground="{DynamicResource RecipeMutedTextBrush}" /><TextBlock Text="{Binding SearchResultsText}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource RecipeMutedTextBrush}" /></DockPanel>
                </StackPanel></MenuItem.Header>
            </MenuItem>
        </ContextMenu>
    </UserControl.ContextMenu>
    <UserControl.Tag><Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" Converter="{StaticResource RecipeCompactLayoutConverter}" /></UserControl.Tag>
    <UserControl.InputBindings><KeyBinding Key="Enter" Command="{Binding OpenCommand}" /><KeyBinding Key="Escape" Command="{Binding SearchEscapeCommand}" /></UserControl.InputBindings>
    <Grid x:Name="RecipeLibraryLayout" Margin="24,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding RecipeStartTitleText}" FontSize="20" LineHeight="29" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding RecipeStartSummaryText}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RecipeLibraryImportButton" Height="31" Content="{Binding RecipeImportText}" Margin="0,0,8,0"
                            Command="{Binding DataContext.MenuViewModel.ImportEntry.Command, RelativeSource={RelativeSource AncestorType=DockPanel}}"
                            IsEnabled="{Binding DataContext.ProjectConfigViewModel.IsProjectArchiveCommandEnabled, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.AutomationId="RecipeLibraryImportButton" />
                    <Button x:Name="RecipeLibraryCreateButton" Style="{StaticResource RecipePrimaryButtonStyle}" Height="31" MinHeight="31" Padding="10,5" Command="{Binding CreateNewCommand}" AutomationProperties.AutomationId="RecipeLibraryCreateButton" AutomationProperties.Name="{Binding RecipeCreateText}" IsDefault="False">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="+ " VerticalAlignment="Center" /><TextBlock Text="{Binding RecipeCreateText}" VerticalAlignment="Center" /></StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="120" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Grid Margin="0,0,8,0">
                    <TextBox x:Name="RecipeLibrarySearchBox" Height="31" MinHeight="30" Padding="8,5" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="RecipeLibrarySearchBox" AutomationProperties.Name="{Binding RecipeSearchPlaceholderText}" ToolTip="Ctrl+F" />
                    <TextBlock x:Name="RecipeLibrarySearchPlaceholder" Text="{Binding RecipeSearchPlaceholderText}" Margin="8,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource RecipeMutedTextBrush}" TextTrimming="CharacterEllipsis" Visibility="{Binding SearchPlaceholderVisibility}" IsHitTestVisible="False" />
                </Grid>
                <ListBox x:Name="RecipeLibraryPurposeFilter" AlternationCount="4" Grid.Column="1" ItemsSource="{Binding PurposeFilterOptions}" SelectedValuePath="Key" SelectedValue="{Binding PurposeFilterKey, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center" AutomationProperties.AutomationId="RecipeLibraryPurposeFilter" AutomationProperties.Name="{Binding PurposeFilterLabelText}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="8,1" /><Setter Property="Height" Value="24" /><Setter Property="Margin" Value="0,0,4,0" /><Setter Property="FontSize" Value="12" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Value}" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="FilterChrome" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" /></Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="3"><Setter Property="Margin" Value="0" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FilterChrome" Property="BorderThickness" Value="2" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Grid x:Name="RecipeLibraryRows" Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid x:Name="RecipeLibraryColumnHeaders" Grid.Row="0" Margin="14,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ActualWidth, ElementName=RecipeLibraryView, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=thumbnail}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=identity}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="{Binding ActualWidth, ElementName=RecipeLibraryView, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=task}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" MinWidth="{Binding ActualWidth, ElementName=RecipeLibraryView, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=progress}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" MinWidth="{Binding ActualWidth, ElementName=RecipeLibraryView, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=model}" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="2" Text="{Binding RecipeListIdentityHeaderText}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                    <TextBlock Grid.Column="4" Text="{Binding RecipeListPurposeHeaderText}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                    <TextBlock Grid.Column="6" Text="{Binding RecipeListDataHeaderText}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                    <TextBlock Grid.Column="8" Text="{Binding RecipeListModelHeaderText}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                    <TextBlock Grid.Column="9" Width="90" Margin="16,0,0,0" Style="{StaticResource RecipeWideOnlyStyle}" Text="{Binding RecipeListModifiedHeaderText}" FontSize="12" LineHeight="17.4" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                </Grid>
                <ListBox x:Name="RecipeLibraryListBox" Grid.Row="1" ItemsSource="{Binding FilteredDatasets}" SelectedItem="{Binding SelectedDataset, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Padding="0" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="RecipeLibraryList" AutomationProperties.Name="{Binding RecipeStartTitleText}">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="mvvm:EventCommandBehavior.EventName" Value="MouseDoubleClick" />
                        <Setter Property="mvvm:EventCommandBehavior.Command" Value="{Binding DataContext.OpenRecipeOnDoubleClickCommand, RelativeSource={RelativeSource AncestorType=local:WpfRecipeLibraryPanel}}" />
                        <Setter Property="mvvm:EventCommandBehavior.PassEventArgsToCommand" Value="True" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,10" /><Setter Property="Margin" Value="0,0,0,6" /><Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="FocusVisualStyle" Value="{x:Null}" /><Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" /><Setter Property="AutomationProperties.Name" Value="{Binding RecipeName}" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Grid><Border x:Name="RecipeRowBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter Margin="{TemplateBinding Padding}" /></Border><Border x:Name="RecipeRowFocus" Margin="-3" BorderBrush="{DynamicResource RecipeFocusBrush}" BorderThickness="2" CornerRadius="10" IsHitTestVisible="False" Visibility="Collapsed" /></Grid><ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSelectedCardBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedCardBorderBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="RecipeRowFocus" Property="Visibility" Value="Visible" /></Trigger>
                        </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate DataType="{x:Type local:WpfDatasetSelectionItem}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=thumbnail}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=identity}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=task}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=progress}" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=model}" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Grid.ColumnSpan="2" Width="64" Height="44" HorizontalAlignment="Left" CornerRadius="5" Background="{DynamicResource RecipeButtonBrush}" ClipToBounds="True" VerticalAlignment="Center" SizeChanged="OnPreviewFrameSizeChanged"><Grid><Image Source="{Binding PreviewImageSource}" Stretch="UniformToFill" Visibility="{Binding PreviewImageVisibility}" AutomationProperties.AutomationId="RecipeLibraryItemPreviewImage" /><TextBlock Text="{Binding DataContext.RecipeNoPreviewText, RelativeSource={RelativeSource AncestorType=UserControl}}" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NoPreviewVisibility}" /></Grid></Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Height="18.85" Text="{Binding ProductCodeDisplayText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource RecipeDisabledTextBrush}" />
                                <TextBlock Height="18.85" Text="{Binding RecipeName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Height="18.85" Text="{Binding RecipeDescriptionDisplayText}" FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                            </StackPanel>
                            <Border Grid.Column="4" HorizontalAlignment="Left" Padding="8,1" CornerRadius="12" Background="{DynamicResource RecipeButtonBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" VerticalAlignment="Center"><TextBlock Text="{Binding PurposeText}" FontSize="12" LineHeight="17.4" TextWrapping="Wrap" /></Border>
                            <StackPanel Grid.Column="6" VerticalAlignment="Center"><TextBlock Text="{Binding LabelingProgressText}" FontSize="12" TextWrapping="Wrap" /><Border Height="6" Margin="0,4,0,0" Background="{DynamicResource ProgressTrackBrush}" CornerRadius="3" Visibility="{Binding ProgressVisibility}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ReviewedProgressWidth}" /><ColumnDefinition Width="{Binding LabeledProgressWidth}" /><ColumnDefinition Width="{Binding RemainingProgressWidth}" /></Grid.ColumnDefinitions><Border Grid.Column="0" Background="{DynamicResource SuccessBrush}" /><Border Grid.Column="1" Background="{DynamicResource AccentBrush}" /></Grid></Border></StackPanel>
                            <StackPanel Grid.Column="8" VerticalAlignment="Center"><TextBlock Text="{Binding RecipeListModelText}" FontSize="12" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontWeight" Value="Bold" /><Style.Triggers><DataTrigger Binding="{Binding HasInspectionModel}" Value="False"><Setter Property="FontWeight" Value="Normal" /><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding InspectionMetricsText}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" /></StackPanel>
                            <TextBlock Grid.Column="9" Width="90" Margin="16,0,0,0" Style="{StaticResource RecipeWideOnlyStyle}" Text="{Binding RecipeListModifiedDateText}" FontSize="12" Foreground="{DynamicResource RecipeMutedTextBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="24" Visibility="{Binding EmptyStateVisibility}"><TextBlock Text="{Binding EmptyStateTitleText}" FontSize="18" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock Text="{Binding EmptyStateDetailText}" Margin="0,8,0,16" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" /><Button x:Name="RecipeLibraryCreateFirstButton" Style="{StaticResource RecipePrimaryButtonStyle}" Content="{Binding CreateFirstDatasetButtonText}" Command="{Binding CreateNewCommand}" HorizontalAlignment="Center" AutomationProperties.AutomationId="RecipeLibraryCreateFirstButton" /></StackPanel>
                <TextBlock x:Name="RecipeLibraryNoResultsText" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,28" Text="{Binding SearchNoResultsText}" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" Visibility="{Binding FilteredEmptyStateVisibility}" />
            </Grid>
        </Grid>
        <Border x:Name="RecipeLibraryDetailsPanel" Grid.Column="2" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Border.Style><Style TargetType="Border"><Setter Property="Width" Value="400" /><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=RecipeLibraryView}" Value="True"><Setter Property="Width" Value="340" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel x:Name="RecipeLibraryDetailsHeader" Margin="16,16,16,0" Visibility="{Binding MetadataDetailsVisibility}">
                        <Border x:Name="RecipeLibraryCover" Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=cover}" Background="{DynamicResource RecipeButtonBrush}" CornerRadius="6" ClipToBounds="True" SizeChanged="OnPreviewFrameSizeChanged"><Grid><Image Source="{Binding SelectedDataset.CoverImageSource}" Stretch="UniformToFill" Visibility="{Binding SelectedDataset.PreviewImageVisibility}" AutomationProperties.Name="{Binding SelectedDataset.RecipeName}" /><TextBlock Text="{Binding RecipeNoPreviewText}" TextAlignment="Center" VerticalAlignment="Center" Visibility="{Binding SelectedDataset.NoPreviewVisibility}" Foreground="{DynamicResource RecipeMutedTextBrush}" /></Grid></Border>
                        <WrapPanel Margin="0,12,0,0"><TextBlock Text="{Binding SelectedDataset.ProductCodeDisplayText}" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource RecipeDisabledTextBrush}" /><Border Padding="8,1" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" Background="{DynamicResource RecipeButtonBrush}"><TextBlock Text="{Binding SelectedDataset.PurposeText}" FontSize="12" LineHeight="17.4" /></Border></WrapPanel>
                        <TextBlock x:Name="RecipeLibraryDetailsName" Text="{Binding SelectedDataset.RecipeName}" Margin="0,4,0,0" FontSize="18" LineHeight="26.1" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectedDataset.RecipeDescriptionDisplayText}" FontSize="12" LineHeight="17.4" Margin="0,2,0,0" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                        <TextBlock Text="{Binding SelectedDataset.MissingPreviewImageText}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding SelectedDataset.MissingPreviewImageVisibility}" />
                </StackPanel>
                <ScrollViewer x:Name="RecipeLibraryDetailsScrollViewer" Grid.Row="1" Padding="16,14" Visibility="{Binding MetadataDetailsVisibility}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <Grid x:Name="RecipeLibraryPipeline" Margin="0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="8" /><ColumnDefinition Width="70" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="22" /><RowDefinition Height="Auto" MinHeight="22" /><RowDefinition Height="Auto" MinHeight="22" /><RowDefinition Height="Auto" MinHeight="22" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Tag="{Binding SelectedDataset.DatasetReadinessGlyph}" Style="{StaticResource RecipeReadinessStyle}"><TextBlock Text="{Binding SelectedDataset.DatasetReadinessGlyph}" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="2" Text="{Binding DatasetWorkHistoryLabelText}" Style="{StaticResource RecipePipelineLabelStyle}" /><TextBlock Grid.Column="4" Text="{Binding SelectedDataset.DatasetWorkHistoryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Row="1" Tag="{Binding SelectedDataset.LabelingReadinessGlyph}" Style="{StaticResource RecipeReadinessStyle}" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedDataset.LabelingReadinessGlyph}" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LabelingWorkHistoryLabelText}" Margin="0,8,0,0" Style="{StaticResource RecipePipelineLabelStyle}" /><TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedDataset.LabelingWorkHistoryText}" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Row="2" Tag="{Binding SelectedDataset.TrainingReadinessGlyph}" Style="{StaticResource RecipeReadinessStyle}" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedDataset.TrainingReadinessGlyph}" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TrainingWorkHistoryLabelText}" Margin="0,8,0,0" Style="{StaticResource RecipePipelineLabelStyle}" /><TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SelectedDataset.RecipeTrainingStageText}" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <Border Grid.Row="3" Tag="{Binding SelectedDataset.InspectionReadinessGlyph}" Style="{StaticResource RecipeReadinessStyle}" Margin="0,8,0,0"><TextBlock Text="{Binding SelectedDataset.InspectionReadinessGlyph}" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding InspectionModelLabelText}" Margin="0,8,0,0" Style="{StaticResource RecipePipelineLabelStyle}" /><TextBlock Grid.Row="3" Grid.Column="4" Margin="0,8,0,0" TextWrapping="Wrap" VerticalAlignment="Center"><Run Text="{Binding SelectedDataset.InspectionModelText, Mode=OneWay}" /><Run><Run.Style><Style TargetType="Run"><Setter Property="Text" Value=" · " /><Style.Triggers><DataTrigger Binding="{Binding SelectedDataset.InspectionMetricsText}" Value=""><Setter Property="Text" Value="" /></DataTrigger></Style.Triggers></Style></Run.Style></Run><Run Text="{Binding SelectedDataset.InspectionMetricsText, Mode=OneWay}" /></TextBlock>
                            <Grid x:Name="RecipeLibraryDecisionCriteriaRow" Grid.Row="4" Grid.ColumnSpan="5" Margin="0,8,0,0"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding SelectedDataset.HasInspectionModel}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="8" /><ColumnDefinition Width="70" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Tag="{Binding SelectedDataset.DecisionCriteriaReadinessGlyph}" Style="{StaticResource RecipeReadinessStyle}"><TextBlock Text="{Binding SelectedDataset.DecisionCriteriaReadinessGlyph}" LineHeight="16" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="2" Text="{Binding DecisionCriteriaLabelText}" Style="{StaticResource RecipePipelineLabelStyle}" /><TextBlock Grid.Column="4" Text="{Binding SelectedDataset.DecisionCriteriaText}" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" /></Grid>
                        </Grid>
                        <TextBlock x:Name="RecipeLibraryClassCount" Text="{Binding SelectedDataset.ClassCountText}" Margin="0,16,0,8" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                        <ItemsControl x:Name="RecipeLibraryClassChips" ItemsSource="{Binding SelectedDataset.ClassItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Margin="0,0,-8,-8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource RecipeButtonBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="8,1" Margin="0,0,8,8"><StackPanel Orientation="Horizontal"><Border Width="12" Height="12" Background="{Binding DrawBrush}" CornerRadius="3" Margin="0,0,5,0" VerticalAlignment="Center" /><TextBlock Text="{Binding Number}" FontSize="12" LineHeight="17.4" Margin="0,0,4,0" /><TextBlock Text="{Binding Name}" FontSize="12" LineHeight="17.4" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource RecipeCompactLayoutConverter}, ConverterParameter=class-name}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        <Expander x:Name="RecipeLibraryLocationsExpander" Header="{Binding RecipeLocationsTitleText}" Style="{StaticResource RecipeDisclosureStyle}" Margin="0,14,0,0" AutomationProperties.AutomationId="RecipeLibraryLocationsExpander"><StackPanel><TextBlock Text="{Binding SelectedDataset.ImageRootPathText}" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.RecipeFolderPathText}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.StoragePathText}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.SummaryUpdatedText}" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedDataset.ModifiedDateText}" Margin="0,4,0,0" FontSize="12" /></StackPanel></Expander>
                </StackPanel></ScrollViewer>
                <TextBlock x:Name="RecipeLibraryNoSelectionHint" Grid.RowSpan="3" Text="{Binding RecipeSelectionPromptText}" HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="16,28" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}" Visibility="{Binding NoSelectedRecipeVisibility}" AutomationProperties.AutomationId="RecipeLibraryNoSelectionHint" />
                <Border x:Name="RecipeLibraryDetailsActions" Grid.Row="2" Background="{DynamicResource PanelHeaderBrush}" Padding="14,12" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding RecipeDetailsActionsVisibility}"><StackPanel>
                    <Button x:Name="RecipeLibraryOpenButton" Style="{StaticResource RecipePrimaryButtonStyle}" Height="40" MinHeight="40" FontSize="14" Padding="16,5" Content="{Binding RecipeOpenText}" ToolTip="{Binding RecipeOpenNoteText}" Command="{Binding OpenCommand}" IsDefault="False" Margin="0,0,0,8" AutomationProperties.AutomationId="RecipeLibraryOpenButton" />
                    <Button x:Name="RecipeLibraryResumeLabelingButton" Style="{StaticResource RecipeSecondaryButtonStyle}" Height="31" MinHeight="30" Padding="10,5" Content="{Binding SelectedDataset.ResumeLabelingText}" Command="{Binding ResumeLabelingCommand}" Visibility="{Binding ResumeLabelingVisibility}" AutomationProperties.AutomationId="RecipeLibraryResumeLabelingButton">
                        <Button.ContentTemplate><DataTemplate><TextBlock x:Name="RecipeResumeCaptionText" Text="{Binding}" /></DataTemplate></Button.ContentTemplate>
                    </Button>
                </StackPanel></Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
