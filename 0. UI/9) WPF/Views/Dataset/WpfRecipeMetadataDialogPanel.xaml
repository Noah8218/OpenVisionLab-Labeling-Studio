<UserControl x:Class="MvcVisionSystem.WpfRecipeMetadataDialogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             FontFamily="{DynamicResource UiFontFamily}"
             FontSize="13"
             Foreground="{DynamicResource RecipeTextBrush}"
             AutomationProperties.AutomationId="RecipeMetadataDialogPanel"
             DataContext="{Binding DataContext.DatasetSelectionViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
             Visibility="{Binding MetadataEditorVisibility}">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="MetadataCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="17.4" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource RecipeSecondaryButtonStyle}" />
        <Style TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}" />
            </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelMetadataCommand}" />
    </UserControl.InputBindings>
    <Grid KeyboardNavigation.TabNavigation="Cycle"
          FocusManager.IsFocusScope="True"
          FocusManager.FocusedElement="{Binding ElementName=RecipeMetadataProductCodeTextBox}">
        <Rectangle Fill="{DynamicResource AppBackgroundBrush}" Opacity="0.78" />
        <Border x:Name="RecipeMetadataDialogSurface"
                Width="570"
                MinWidth="360"
                MaxWidth="570"
                MaxHeight="660"
                Margin="18"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource RecipeSurfaceBrush}"
                BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="20,16,20,10">
                    <Button x:Name="RecipeMetadataCloseButton"
                            Style="{StaticResource RecipeQuietButtonStyle}"
                            DockPanel.Dock="Right"
                            Content="×"
                            Command="{Binding CancelMetadataCommand}"
                            MinWidth="31"
                            MinHeight="31"
                            Padding="4"
                            AutomationProperties.AutomationId="RecipeMetadataCloseButton"
                            AutomationProperties.Name="{Binding CancelRecipeMetadataText}"
                            KeyboardNavigation.TabIndex="5" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding RecipeMetadataDialogTitleText}"
                                   FontSize="15"
                                   LineHeight="21.75"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding SelectedDataset.RecipeName}"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="RecipeMetadataContentScrollViewer"
                              Grid.Row="1"
                              Margin="20,6,20,16"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              KeyboardNavigation.TabNavigation="Continue">
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="3" /><Style.Triggers>
                            <DataTrigger Binding="{Binding ComputedVerticalScrollBarVisibility, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" Value="Visible"><Setter Property="Margin" Value="3,3,19,3" /></DataTrigger>
                        </Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding ProductCodeLabelText}"
                                   Margin="0,0,0,4"
                                   FontWeight="Normal" Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="RecipeMetadataProductCodeTextBox"
                                 Text="{Binding EditableProductCode, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{x:Static local:LabelingProjectSettings.RecipeProductCodeMaxLength}"
                                 MinHeight="30"
                                 Padding="8,5"
                                 AutomationProperties.AutomationId="RecipeMetadataProductCodeTextBox"
                                 AutomationProperties.Name="{Binding ProductCodeLabelText}"
                                 KeyboardNavigation.TabIndex="0" />
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding RecipeDescriptionLabelText}"
                                   Margin="0,12,0,4"
                                   FontWeight="Normal" Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="RecipeMetadataDescriptionTextBox"
                                 Text="{Binding EditableRecipeDescription, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="{x:Static local:LabelingProjectSettings.RecipeDescriptionMaxLength}"
                                 MinHeight="76"
                                 Padding="8,5"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="{Binding RecipeMetadataHelpText}"
                                 AutomationProperties.AutomationId="RecipeMetadataDescriptionTextBox"
                                 AutomationProperties.Name="{Binding RecipeDescriptionLabelText}"
                                 KeyboardNavigation.TabIndex="1" />
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding RecipePreviewImageLabelText}"
                                   Margin="0,12,0,4"
                                   FontWeight="Normal" Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <ComboBox x:Name="RecipeMetadataPreviewImageComboBox"
                                  Style="{StaticResource RecipeComboBoxStyle}"
                                  ItemsSource="{Binding RecipePreviewImageOptions}"
                                  SelectedItem="{Binding SelectedRecipePreviewImageOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Value"
                                  IsEnabled="{Binding RecipePreviewImageSelectionEnabled}"
                                  Height="30"
                                  HorizontalAlignment="Stretch"
                                  MaxDropDownHeight="220"
                                  AutomationProperties.AutomationId="RecipeMetadataPreviewImageComboBox"
                                  AutomationProperties.Name="{Binding RecipePreviewImageLabelText}"
                                  KeyboardNavigation.TabIndex="2" />
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding RecipeMetadataPreviewOnlyText}"
                                   Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}" />
                        <Border Margin="0,10,0,0"
                                Padding="8"
                                Background="{DynamicResource RecipeButtonBrush}"
                                BorderBrush="{DynamicResource RecipeBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="68"
                                        Height="68"
                                        Background="{DynamicResource RecipePageBrush}"
                                        BorderBrush="{DynamicResource RecipeBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Image x:Name="RecipeMetadataPreviewImage"
                                           Source="{Binding EditableRecipePreviewImageSource}"
                                           Stretch="UniformToFill"
                                           Visibility="{Binding RecipeMetadataPreviewImageVisibility}"
                                           AutomationProperties.AutomationId="RecipeMetadataPreviewImage" />
                                </Border>
                                <TextBlock Style="{StaticResource MetadataCaptionStyle}" Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding RecipeMetadataNoImagesText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                           Visibility="{Binding RecipeMetadataPreviewNoImageVisibility}" />
                                <TextBlock Style="{StaticResource MetadataCaptionStyle}" x:Name="RecipeMetadataPreviewCaptionText"
                                           Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding RecipeMetadataPreviewCaptionText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                           Visibility="{Binding RecipeMetadataPreviewCaptionVisibility}"
                                           AutomationProperties.AutomationId="RecipeMetadataPreviewCaptionText" />
                                <TextBlock Style="{StaticResource MetadataCaptionStyle}" Grid.Column="1"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding RecipeMetadataPreviewStatusText}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}"
                                           Visibility="{Binding RecipeMetadataPreviewStatusVisibility}" />
                            </Grid>
                        </Border>
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" Text="{Binding RecipeMetadataOptionalFieldsText}"
                                   Margin="0,12,0,0"
                                   Padding="10,8"
                                   TextWrapping="Wrap"
                                   Background="{DynamicResource RecipeSelectedBrush}"
                                   Foreground="{DynamicResource RecipeTextBrush}" />
                        <TextBlock Style="{StaticResource MetadataCaptionStyle}" x:Name="RecipeMetadataStatusText"
                                   Text="{Binding MetadataStatusText}"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   Visibility="{Binding MetadataStatusVisibility}"
                                   AutomationProperties.AutomationId="RecipeMetadataStatusText" />
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="2"
                        Background="{DynamicResource PanelHeaderBrush}"
                        BorderBrush="{DynamicResource RecipeBorderBrush}"
                        BorderThickness="0,1,0,0"
                        CornerRadius="0,0,12,12"
                        Padding="20,12">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="RecipeMetadataCancelButton"
                            Content="{Binding CancelRecipeMetadataText}"
                            Command="{Binding CancelMetadataCommand}"
                            MinWidth="84"
                            MinHeight="31"
                            Margin="0,0,8,0"
                            AutomationProperties.AutomationId="RecipeMetadataCancelButton"
                            KeyboardNavigation.TabIndex="3" />
                    <Button x:Name="RecipeMetadataSaveButton"
                            Style="{StaticResource RecipePrimaryButtonStyle}"
                            Content="{Binding SaveRecipeMetadataText}"
                            Command="{Binding SaveMetadataCommand}"
                            IsDefault="True"
                            MinWidth="110"
                            MinHeight="31"
                            AutomationProperties.AutomationId="RecipeMetadataSaveButton"
                            KeyboardNavigation.TabIndex="4" />
                </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
