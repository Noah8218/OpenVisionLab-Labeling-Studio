<ui:FluentWindow x:Class="MvcVisionSystem.WpfEnvironmentSetupCenterWindow"
                 x:Name="EnvironmentSetupCenterWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:local="clr-namespace:MvcVisionSystem"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{Binding [WpfEnvironment.Title], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                 Width="1120"
                 Height="760"
                 MinWidth="920"
                 MinHeight="620"
                 Background="{DynamicResource RecipePageBrush}"
                 FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
                 UseLayoutRounding="True"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0D0F" />
            <SolidColorBrush x:Key="PanelBrush" Color="#171717" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#101820" />
            <SolidColorBrush x:Key="BorderBrushDark" Color="#303030" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7B7B7" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
            <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#252525" />
            <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
            <SolidColorBrush x:Key="ProblemBrush" Color="#EF4444" />

            <Style x:Key="EnvironmentSetupActionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="EnvironmentSetupPrimaryButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipePrimaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Padding="24,22,24,18" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="EnvironmentSetupTitleText" Text="{Binding [WpfEnvironment.Title], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="20" LineHeight="29" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="EnvironmentSetupDescriptionText" Text="{Binding [WpfEnvironment.Description], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer x:Name="EnvironmentSetupScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20,24,20" PanningMode="VerticalOnly">
            <StackPanel>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock x:Name="EnvironmentSetupOverallText" Text="{Binding OverallStatusText}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupOverallDetailText" Text="{Binding OverallDetailText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0" >
                                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding OverallDetailText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="EnvironmentSetupSelectedRuntimeText" Text="{Binding SelectedRuntimeText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [WpfEnvironment.Summary.Ready], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupReadyCountText" Text="{Binding ReadyCount}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [WpfEnvironment.Summary.Required], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupAttentionCountText" Text="{Binding AttentionCount}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding [WpfEnvironment.Summary.Optional], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupOptionalCountText" Text="{Binding OptionalCount}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>

                <ItemsControl x:Name="EnvironmentSetupItemsControl" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,18,0">
                                        <TextBlock Text="{Binding CategoryText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding RequirementText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding NameText}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,0" />
                                        <Border CornerRadius="5" Padding="8,4" BorderThickness="1" HorizontalAlignment="Left" Margin="0,10,0,0" MaxWidth="162">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource DatasetReadyBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DatasetReadyBorderBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource DatasetReadyTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsReady}" Value="False">
                                                            <Setter Property="Background" Value="#3D1E22" />
                                                            <Setter Property="BorderBrush" Value="#73343A" /><Setter Property="TextElement.Foreground" Value="#FFB3B3" />
                                                        </DataTrigger>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsReady}" Value="False" />
                                                                <Condition Binding="{Binding IsWarning}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Background" Value="{DynamicResource DatasetNeededBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DatasetNeededBorderBrush}" /><Setter Property="TextElement.Foreground" Value="{DynamicResource DatasetNeededTextBrush}" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DetailText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" />
                                        <TextBlock Text="{Binding NextActionText}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{Binding [WpfEnvironment.Footer.InstallOrder], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupInstallGuideText" Text="{Binding InstallGuideText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="{Binding [WpfEnvironment.Footer.SafetyBoundary], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="EnvironmentSetupSafetyText" Text="{Binding SafetyBoundaryText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock x:Name="EnvironmentSetupLastCheckedText" Text="{Binding LastCheckedText}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="EnvironmentSetupModelSettingsReasonText" AutomationProperties.AutomationId="EnvironmentSetupModelSettingsReasonText" Text="{Binding ModelSettingsUnavailableReason}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" Margin="0,4,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ModelSettingsUnavailableReason}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="EnvironmentSetupRefreshButton" AutomationProperties.AutomationId="EnvironmentSetupRefreshButton" AutomationProperties.Name="{Binding [WpfEnvironment.Action.Refresh.Automation], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding [WpfEnvironment.Action.Refresh.ToolTip], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource EnvironmentSetupActionButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,0,10,0">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="16" Height="16" Margin="0" HorizontalAlignment="Center" />
                    </ui:Button>
                    <ui:Button x:Name="EnvironmentSetupOpenModelSettingsButton" AutomationProperties.AutomationId="EnvironmentSetupOpenModelSettingsButton" AutomationProperties.Name="{Binding [WpfEnvironment.Action.ModelSettings.Automation], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding [WpfEnvironment.Action.ModelSettings.ToolTip], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource EnvironmentSetupPrimaryButtonStyle}" Command="{Binding OpenModelSettingsCommand}" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="Tune" Width="16" Height="16" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding [WpfEnvironment.Action.ModelSettings.Name], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="EnvironmentSetupCloseButton" AutomationProperties.AutomationId="EnvironmentSetupCloseButton" AutomationProperties.Name="{Binding [WpfEnvironment.Action.Close.Automation], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding [WpfEnvironment.Action.Close.ToolTip], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource EnvironmentSetupActionButtonStyle}" Click="CloseButton_Click">
                        <TextBlock Text="{Binding [WpfEnvironment.Action.Close.Name], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" />
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
