<ui:FluentWindow x:Class="MvcVisionSystem.WpfModelBenchmarkWindow"
                 x:Name="BenchmarkWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:MvcVisionSystem"
                 Title="&#xBAA8;&#xB378; &#xC131;&#xB2A5; &#xBE44;&#xAD50;"
                 Width="1600"
                 Height="900"
                 MinWidth="1050"
                 MinHeight="650"
                 Background="{DynamicResource RecipePageBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 FontFamily="{DynamicResource UiFontFamily}"
                 FontSize="13">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0D0F" />
            <SolidColorBrush x:Key="FrameBrush" Color="#0A0B0D" />
            <SolidColorBrush x:Key="PanelBrush" Color="#171717" />
            <SolidColorBrush x:Key="PanelHeaderBrush" Color="#1F1F1F" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#101820" />
            <SolidColorBrush x:Key="BorderBrushDark" Color="#303030" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7B7B7" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
            <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#252525" />
            <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#333333" />
            <SolidColorBrush x:Key="DisabledTextBrush" Color="#69707A" />
            <SolidColorBrush x:Key="InputBrush" Color="#242424" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="GridHeaderBrush" Color="#202020" />
            <SolidColorBrush x:Key="RowHoverBrush" Color="#222A33" />
            <SolidColorBrush x:Key="SelectedRowBrush" Color="#26384F" />
            <SolidColorBrush x:Key="SelectedRowTextBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BaselineBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="CandidateBrush" Color="#4EA1FF" />
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <Style x:Key="BenchmarkActionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="BenchmarkIconButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource BenchmarkActionButtonStyle}">
                <Setter Property="MinWidth" Value="30" />
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style x:Key="BenchmarkListItemStyle" TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <ContentPresenter HorizontalAlignment="Stretch" />
                            </Border>
                            <Border x:Name="CatalogFocusCue" BorderThickness="2" BorderBrush="Transparent" CornerRadius="7" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CatalogFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" /></DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="MinWidth" Value="28" /><Setter Property="MinHeight" Value="28" />
                <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Width="28" Height="28">
                            <Border x:Name="CheckChrome" Margin="4" CornerRadius="4" Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" />
                            <Path x:Name="CheckMark" Data="M 8,14 L 12,18 L 20,9" Stroke="{DynamicResource RecipeTextBrush}" StrokeThickness="2" Visibility="Collapsed" />
                            <Border x:Name="CheckFocusCue" CornerRadius="5" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipePrimaryBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeAccentBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeButtonPressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CheckFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter TargetName="CheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" /><Setter TargetName="CheckMark" Property="Stroke" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter TargetName="CheckFocusCue" Property="BorderBrush" Value="Transparent" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="BenchmarkTabItemStyle" TargetType="{x:Type TabItem}">
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /><Setter Property="Background" Value="{DynamicResource RecipeButtonBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" /><Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="0,0,5,6" /><Setter Property="FontSize" Value="13" /><Setter Property="MinHeight" Value="30" />
                <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value><ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="TabChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="TabFocusCue" CornerRadius="7" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TabFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" /><Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type DataGrid}">
                <Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="RowBackground" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource RecipePageBrush}" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="CanUserReorderColumns" Value="False" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="RowHeaderWidth" Value="0" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="MinColumnWidth" Value="80" />
            </Style>

            <Style TargetType="{x:Type DataGridColumnHeader}">
                <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate></Setter.Value></Setter>
                <Setter Property="MinHeight" Value="40" />
                <Setter Property="Background" Value="{DynamicResource RecipeButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeBorderBrush}" />
                <Setter Property="BorderThickness" Value="0,0,1,1" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style TargetType="{x:Type DataGridCell}">
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="{x:Type DataGridRow}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Background" Value="{DynamicResource RecipeSurfaceBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="BenchmarkWrappedCellTextStyle" TargetType="{x:Type TextBlock}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="None" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <DockPanel LastChildFill="True">
        <ui:TitleBar x:Name="ModelBenchmarkTitleBar"
                     DockPanel.Dock="Top"
                     Height="30"
                     Title="&#xBAA8;&#xB378; &#xC131;&#xB2A5; &#xBE44;&#xAD50;"
                     Background="{DynamicResource RecipePageBrush}"
                     Foreground="{DynamicResource RecipeTextBrush}"
                     ButtonsForeground="{DynamicResource RecipeTextBrush}"
                     ButtonsBackground="{DynamicResource RecipeButtonHoverBrush}" />

        <Border DockPanel.Dock="Top"
                MinHeight="76"
                Background="{DynamicResource RecipePageBrush}"
                BorderBrush="{DynamicResource RecipeAccentBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Kind="ChartBoxOutline"
                                                Width="22"
                                                Height="22"
                                                Foreground="{DynamicResource RecipeAccentBrush}"
                                                Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="&#xBAA8;&#xB378; &#xC131;&#xB2A5; &#xBE44;&#xAD50;"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="20"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
                <ui:Button x:Name="RefreshModelBenchmarkButton"
                           Grid.Column="1"
                           Style="{StaticResource BenchmarkActionButtonStyle}"
                           Command="{Binding RefreshCommand}"
                           AutomationProperties.Name="{Binding [WpfModelBenchmark.Action.Refresh], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                           ToolTip="{Binding [WpfModelBenchmark.Action.Refresh], Source={x:Static local:WpfLocalizationViewModel.Instance}}">
                    <iconPacks:PackIconMaterial Kind="Refresh"
                                                    Width="15"
                                                    Height="15" Margin="0" HorizontalAlignment="Center" />
                </ui:Button>
            </Grid>
        </Border>

        <Expander x:Name="ModelBenchmarkLoadWarning"
                  Style="{StaticResource DatasetExpanderStyle}"
                  DockPanel.Dock="Top"
                  Margin="14,8,14,0"
                  Header="{Binding CatalogLoadFailureText}"
                  Foreground="{DynamicResource RecipeTextBrush}"
                  Background="{DynamicResource RecipeSurfaceBrush}"
                  Visibility="{Binding HasCatalogLoadFailures, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Margin="10,4,10,8">
                <TextBlock Text="{Binding CatalogLoadFailureHelpText}"
                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="ModelBenchmarkUnreadablePaths"
                         Style="{StaticResource RecipeInputStyle}"
                         Text="{Binding CatalogLoadFailureDetailText, Mode=OneWay}"
                         IsReadOnly="True"
                         MaxHeight="100"
                         Margin="0,6,0,0"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource RecipePageBrush}"
                         Foreground="{DynamicResource RecipeTextBrush}"
                         BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                         AutomationProperties.Name="{Binding CatalogLoadFailureText}" />
            </StackPanel>
        </Expander>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="280" MaxWidth="480" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="650" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource RecipeSurfaceBrush}"
                    BorderBrush="{DynamicResource RecipeBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,9">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="ModelBenchmarkSearchBox"
                                     Style="{StaticResource RecipeInputStyle}"
                                     MinHeight="30"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{DynamicResource RecipePageBrush}"
                                     Foreground="{DynamicResource RecipeTextBrush}"
                                     BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                                     BorderThickness="1"
                                     Padding="28,5,9,5"
                                     FontFamily="{DynamicResource UiFontFamily}"
                                     FontSize="13"
                                     ToolTip="모델, 실행 환경, 보고서 검색" />
                            <iconPacks:PackIconMaterial Kind="Magnify"
                                                        Width="14"
                                                        Height="14"
                                                        Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="9,0,0,0"
                                                        IsHitTestVisible="False" />
                        </Grid>
                        <ComboBox x:Name="ModelBenchmarkTaskFilterBox"
                                  Style="{StaticResource RecipeComboBoxStyle}"
                                  Grid.Column="1"
                                  Height="Auto"
                                  MinHeight="30"
                                  MinWidth="116"
                                  MaxWidth="180"
                                  Margin="7,0,0,0"
                                  ItemsSource="{Binding TaskFilterOptions}"
                                  SelectedValuePath="Key"
                                  SelectedValue="{Binding SelectedTaskFilter, Mode=TwoWay}"
                                  Background="{DynamicResource RecipePageBrush}"
                                  Foreground="{DynamicResource RecipeTextBrush}"
                                  BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                                  FontFamily="{DynamicResource UiFontFamily}"
                                  FontSize="13"
                                  ToolTip="&#xC791;&#xC5C5; &#xC885;&#xB958; &#xD544;&#xD130;">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="140" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xC2E4;&#xD589; &#xCE74;&#xD0C8;&#xB85C;&#xADF8;"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="&#xC120;&#xD0DD; &#xCD5C;&#xB300; 6"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1"
                                   Grid.ColumnSpan="2"
                                   Text="{Binding CatalogTaskSummaryText}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding CatalogTaskSummaryText}"
                                   Margin="0,4,0,0" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ModelBenchmarkCatalogList"
                                 ItemsSource="{Binding FilteredRuns}"
                                 IsTabStop="{Binding HasItems, RelativeSource={RelativeSource Self}}"
                                 ItemContainerStyle="{StaticResource BenchmarkListItemStyle}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="9,8" ToolTip="{Binding Run.SourcePath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="42" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  AutomationProperties.Name="{Binding DisplayName}"
                                                  VerticalAlignment="Top"
                                                  Margin="0,2,0,0"
                                                  ToolTip="{Binding SelectionToolTipText}" />
                                        <StackPanel Grid.Column="1" Margin="2,0,7,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="{DynamicResource RecipePageBrush}"
                                                        BorderBrush="{DynamicResource RecipeBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="5,1"
                                                        Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding TaskText}"
                                                               Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                               FontFamily="{DynamicResource UiFontFamily}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                                <Border Background="#172E20"
                                                        BorderBrush="{DynamicResource BaselineBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7"
                                                        Padding="5,1"
                                                        Visibility="{Binding IsBaseline, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding BaselineText}"
                                                               Foreground="{DynamicResource BaselineBrush}"
                                                               FontFamily="{DynamicResource UiFontFamily}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       Foreground="{DynamicResource RecipeTextBrush}"
                                                       FontFamily="{DynamicResource UiFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"
                                                       Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding RuntimeName}"
                                                       Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                       FontFamily="{DynamicResource UiFontFamily}"
                                                       FontSize="13"
                                                       TextWrapping="Wrap"
                                                       Margin="0,3,0,0" />
                                            <WrapPanel Margin="0,2,0,0">
                                                <TextBlock Text="{Binding DateText, Mode=OneWay}" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                                                <TextBlock Text="  &#xB7;  " Foreground="{DynamicResource RecipeMutedTextBrush}" />
                                                <TextBlock Text="{Binding EvidenceText, Mode=OneWay}" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                                                <TextBlock Text="  &#xB7;  " Foreground="{DynamicResource RecipeMutedTextBrush}" />
                                                <TextBlock Text="{Binding SourceTypeText, Mode=OneWay}" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                                            </WrapPanel>
                                        </StackPanel>
                                        <ui:Button Grid.Column="2"
                                                   Style="{StaticResource BenchmarkIconButtonStyle}"
                                                   Command="{Binding DataContext.SetBaselineCommand, RelativeSource={RelativeSource AncestorType={x:Type ListBox}}}"
                                                   CommandParameter="{Binding}"
                                                   ToolTip="{Binding BaselineToolTipText}"
                                                   AutomationProperties.Name="{Binding DisplayName}">
                                            <iconPacks:PackIconMaterial Kind="PinOutline" Width="18" Height="18" />
                                        </ui:Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <ScrollViewer x:Name="ModelBenchmarkCatalogEmptyPanel"
                                      Margin="16"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="{x:Type ScrollViewer}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=ModelBenchmarkCatalogList}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <StackPanel>
                                <TextBlock x:Name="ModelBenchmarkCatalogEmptyTitle"
                                           Text="{Binding CatalogEmptyTitleText}"
                                           Foreground="{DynamicResource RecipeTextBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CatalogEmptyDetailText}"
                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <ui:Button x:Name="ResetModelBenchmarkFiltersButton"
                                           Style="{StaticResource BenchmarkActionButtonStyle}"
                                           Height="Auto"
                                           MinHeight="30"
                                           Margin="0,12,0,0"
                                           Command="{Binding ResetCatalogFiltersCommand}"
                                           AutomationProperties.Name="{Binding ResetCatalogFiltersText}"
                                           Visibility="{Binding HasCatalogFilter, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ResetCatalogFiltersText}" TextWrapping="Wrap" />
                                </ui:Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <ui:Button x:Name="ClearModelBenchmarkSelectionButton"
                               Grid.Row="3"
                               Style="{StaticResource BenchmarkActionButtonStyle}"
                               HorizontalAlignment="Left"
                               Margin="0,9,0,0"
                               Command="{Binding ClearSelectionCommand}"
                               ToolTip="&#xBE44;&#xAD50; &#xC120;&#xD0DD; &#xD574;&#xC81C;">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="SelectionRemove" Width="14" Height="14" Margin="0,0,6,0" />
