                                                                               FontSize="13"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding DeltaText}"
                                                                               Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                                               FontFamily="{DynamicResource UiFontFamily}"
                                                                               FontSize="13"
                                                                               Margin="0,2,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding ClassErrorsTabText}" Style="{StaticResource BenchmarkTabItemStyle}">
                        <ScrollViewer x:Name="ModelBenchmarkClassErrorsSurface" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid Margin="10" Background="{DynamicResource RecipeSurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="230" MinHeight="230" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="320" MinHeight="320" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ModelBenchmarkGroundTruthNoticeText"
                                       Text="{Binding GroundTruthReviewNoticeText}"
                                       Foreground="{DynamicResource RecipeMutedTextBrush}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,10" />
                            <TextBlock Grid.Row="1"
                                       Text="&#xD074;&#xB798;&#xC2A4;&#xBCC4; &#xAC80;&#xC99D; &#xC9C0;&#xD45C;"
                                       Foreground="{DynamicResource RecipeTextBrush}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="2,0,0,7" />
                            <DataGrid x:Name="ModelBenchmarkClassMetricGrid"
                                      Grid.Row="2"
                                      ItemsSource="{Binding ClassMetricRows}"
                                      AlternationCount="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="&#xBAA8;&#xB378;" Binding="{Binding ModelName}" Width="1.5*" MinWidth="170" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="&#xD074;&#xB798;&#xC2A4;" Binding="{Binding ClassName}" Width="100" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="&#xC815;&#xB2F5; &#xC218;" Binding="{Binding InstanceCountText}" Width="70" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                    <DataGridTextColumn Header="Precision" Binding="{Binding PrecisionText}" Width="85" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="Recall" Binding="{Binding RecallText}" Width="85" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="mAP50" Binding="{Binding Map50Text}" Width="85" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="mAP50-95" Binding="{Binding Map5095Text}" Width="90" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="UI &#xC784;&#xACC4;&#xAC12; &#xC815;&#xB2F5; &#xB300;&#xC870;"
                                                        Binding="{Binding GroundTruthReviewText}"
                                                        Width="1.2*"
                                                        MinWidth="160" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Grid.Row="3"
                                       Text="{Binding GroundTruthExamplesTitleText}"
                                       Foreground="{DynamicResource RecipeTextBrush}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="2,12,0,3" />
                            <TextBlock Grid.Row="4"
                                       Text="{Binding GroundTruthErrorExampleStatusText}"
                                       Foreground="{DynamicResource RecipeMutedTextBrush}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="2,0,0,7" />
                            <Grid Grid.Row="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MinWidth="300" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="260" MinWidth="250" />
                                </Grid.ColumnDefinitions>

                                <DataGrid x:Name="ModelBenchmarkGroundTruthExampleGrid"
                                          ItemsSource="{Binding GroundTruthExamples}"
                                          SelectedItem="{Binding SelectedGroundTruthExample, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          AlternationCount="2"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="&#xBAA8;&#xB378;" Binding="{Binding ModelName}" Width="1.25*" MinWidth="160" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                        <DataGridTextColumn Header="&#xC624;&#xB958; &#xC720;&#xD615;" Binding="{Binding ErrorTypeText}" Width="90" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                        <DataGridTemplateColumn Header="&#xC774;&#xBBF8;&#xC9C0;" Width="1.5*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ImageName}"
                                                               ToolTip="{Binding ImagePath}"
                                                               TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="&#xD074;&#xB798;&#xC2A4;" Binding="{Binding ClassName}" Width="100" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                        <DataGridTextColumn Header="&#xC2E0;&#xB8B0;&#xB3C4;" Binding="{Binding ConfidenceText}" Width="80" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                        <DataGridTextColumn Header="&#xCD5C;&#xB300; IoU" Binding="{Binding BestIouText}" Width="80" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Border x:Name="ModelBenchmarkGroundTruthPreview"
                                        Grid.Column="2"
                                        Background="{DynamicResource RecipePageBrush}"
                                        BorderBrush="{DynamicResource RecipeBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding GroundTruthPreviewTitleText}"
                                                   Foreground="{DynamicResource RecipeTextBrush}"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   ToolTip="{Binding SelectedGroundTruthExample.ImagePath}" />
                                        <Border Grid.Row="1"
                                                Margin="0,7,0,7"
                                                Background="#08090B"
                                                BorderBrush="{DynamicResource RecipeBorderBrush}"
                                                BorderThickness="1">
                                            <Grid>
                                                <Image x:Name="ModelBenchmarkGroundTruthPreviewImage"
                                                       Source="{Binding SelectedGroundTruthExample.PreviewSource, IsAsync=True}"
                                                       Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality">
                                                    <Image.Style>
                                                        <Style TargetType="{x:Type Image}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSelectedGroundTruthPreview}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <TextBlock Text="{Binding GroundTruthPreviewStatusText}"
                                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                           FontFamily="{DynamicResource UiFontFamily}"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"
                                                           TextAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="{x:Type TextBlock}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasSelectedGroundTruthPreview}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                        <StackPanel x:Name="ModelBenchmarkGroundTruthPreviewOverlayLegend"
                                                    Grid.Row="2"
                                                    Orientation="Horizontal"
                                                    Margin="0,0,0,5">
                                            <StackPanel.Style>
                                                <Style TargetType="{x:Type StackPanel}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSelectedGroundTruthPreviewOverlay}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedGroundTruthPreviewGroundTruthBox}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="12" Height="3" Background="#39D98A" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="&#xC815;&#xB2F5; &#xC601;&#xC5ED;"
                                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                           FontFamily="{DynamicResource UiFontFamily}"
                                                           FontSize="13" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel.Style>
                                                    <Style TargetType="{x:Type StackPanel}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSelectedGroundTruthPreviewPredictionBox}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <Border Width="12" Height="3" Background="#32B8FF" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,5,0" />
                                                <TextBlock Text="&#xCD94;&#xB860; &#xACB0;&#xACFC; &#xC601;&#xC5ED;"
                                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                           FontFamily="{DynamicResource UiFontFamily}"
                                                           FontSize="13" />
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Row="3"
                                                   Text="{Binding GroundTruthPreviewDetailText}"
                                                   ToolTip="{Binding SelectedGroundTruthExample.EvidencePath}"
                                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                   FontFamily="{DynamicResource UiFontFamily}"
                                                   FontSize="13"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="{Binding RunConditionsTabText}" Style="{StaticResource BenchmarkTabItemStyle}">
                        <DataGrid x:Name="ModelBenchmarkConditionGrid"
                                  ItemsSource="{Binding SelectedRuns}"
                                  AlternationCount="2"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#xBAA8;&#xB378;" Binding="{Binding DisplayName}" Width="1.2*" MinWidth="160" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTextColumn Header="&#xC791;&#xC5C5;" Binding="{Binding TaskText}" Width="90" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTemplateColumn Header="&#xD3C9;&#xAC00; &#xB370;&#xC774;&#xD130;" Width="2*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding EvidenceFingerprintSha256}">
                                                <TextBlock Text="{Binding EvaluationDataPath}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding EvidenceFingerprintSummaryText}"
                                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                           FontSize="13"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="&#xBD84;&#xD560;" Binding="{Binding Run.Split}" Width="65" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTextColumn Header="&#xC774;&#xBBF8;&#xC9C0;" Binding="{Binding Run.EvidenceCount}" Width="65" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTextColumn Header="img" Binding="{Binding ImageSizeText}" Width="55" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTextColumn Header="batch" Binding="{Binding BatchSizeText}" Width="55" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTextColumn Header="&#xC2E0;&#xB8B0;&#xB3C4;" Binding="{Binding ConfidenceText}" Width="65" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                <DataGridTextColumn Header="&#xC2DC;&#xAC04; &#xCE21;&#xC815; &#xC870;&#xAC74;" Binding="{Binding TimingProtocolText}" Width="1.2*" MinWidth="160" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                <DataGridTemplateColumn Header="&#xAC00;&#xC911;&#xCE58;" Width="2*" MinWidth="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel ToolTip="{Binding WeightsSha256}">
                                                <TextBlock Text="{Binding WeightsPath}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WeightsSha256SummaryText}"
                                                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                                                           FontSize="13"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="&#xBCF4;&#xACE0;&#xC11C;" Binding="{Binding SourcePath}" Width="2*" MinWidth="220" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>

                    <TabItem Header="{Binding ThresholdTabText}" Style="{StaticResource BenchmarkTabItemStyle}">
                        <Grid x:Name="ModelBenchmarkThresholdSurface" Margin="10" Background="{DynamicResource RecipeSurfaceBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="ModelBenchmarkThresholdReviewStatusText"
                                       Text="{Binding ThresholdReviewStatusText}"
                                       Foreground="{DynamicResource RecipeMutedTextBrush}"
                                       FontFamily="{DynamicResource UiFontFamily}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="2,0,2,10" />
                            <DataGrid x:Name="ModelBenchmarkThresholdReviewGrid"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ThresholdReviewRows}"
                                      AlternationCount="2"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="&#xBAA8;&#xB378;" Binding="{Binding ModelName}" Width="1.5*" MinWidth="180" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="&#xC784;&#xACC4;&#xAC12;" Binding="{Binding ConfidenceText}" Width="80" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                    <DataGridTextColumn Header="&#xC815;&#xB2F5; &#xC218;" Binding="{Binding GroundTruthCountText}" Width="70" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                    <DataGridTextColumn Header="&#xCD94;&#xB860; &#xACB0;&#xACFC; &#xC218;" Binding="{Binding PredictionCountText}" Width="70" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" MinWidth="100" />
                                    <DataGridTextColumn Header="TP" Binding="{Binding TruePositiveCountText}" Width="60" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="FP" Binding="{Binding FalsePositiveCountText}" Width="60" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="FN" Binding="{Binding FalseNegativeCountText}" Width="60" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="Precision" Binding="{Binding PrecisionText}" Width="85" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="Recall" Binding="{Binding RecallText}" Width="85" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="F1" Binding="{Binding F1Text}" Width="75" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                    <DataGridTextColumn Header="{Binding [WpfModelBenchmark.ThresholdReview.Header.FormatCoordinates], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Binding="{Binding EvidenceText}" Width="1.2*" MinWidth="160" ElementStyle="{StaticResource BenchmarkWrappedCellTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
                <ScrollViewer x:Name="ModelBenchmarkSelectionEmptyPanel"
                              Grid.Row="1"
                              Margin="24"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsSelectionEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectionEmptyTitleText}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SelectionEmptyDetailText}"
                                   Margin="0,10,0,0"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</ui:FluentWindow>
