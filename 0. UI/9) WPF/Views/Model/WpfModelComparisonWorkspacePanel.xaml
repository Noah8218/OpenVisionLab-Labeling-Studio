                            <Style.Triggers><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></MultiTrigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger></Style.Triggers>
                        </Style></Button.Style>
                        <Grid Width="96" Height="64"><Grid.Clip><RectangleGeometry Rect="0,0,96,64" RadiusX="4" RadiusY="4" /></Grid.Clip>
                            <Image Source="{Binding ThumbnailSource}" Width="96" Height="64" Stretch="UniformToFill" />
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#46202AD9" CornerRadius="4" Padding="5,0">
                                <TextBlock Text="{Binding Caption}" MaxWidth="84" FontSize="10" LineHeight="14.5" LineStackingStrategy="BlockLineHeight" Foreground="#FFC4C4" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><TextBlock Text="{Binding RuleStatusText}" Margin="0,4,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ComparisonCaptionStyle}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value=""/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>
        </Grid>
        <Border x:Name="ComparisonEmptyState" Grid.RowSpan="3" Margin="-20,-16" Padding="16,120,16,28" Background="{DynamicResource RecipePageBrush}">
            <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasModels}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Center">
                <TextBlock Text="{Binding Language[WpfComparisonWorkspace.EmptyTitle]}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock Text="{Binding Language[WpfComparisonWorkspace.EmptyDescription]}" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" TextAlignment="Center" />
                <Button x:Name="ComparisonOpenTrainingButton" MinHeight="30" Height="30" Margin="0,12,0,0" HorizontalAlignment="Center" Style="{StaticResource RecipePrimaryButtonStyle}" Command="{Binding ShellViewModel.TrainingModelCenterCommand, RelativeSource={RelativeSource AncestorType=local:WpfLabelingShellWindow}}" Content="{Binding Language[WpfComparisonWorkspace.OpenTraining]}" />
                <TextBlock Text="{Binding OperationStatus}" Style="{StaticResource ComparisonCaptionStyle}" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
        </Border>
        <Grid x:Name="AdoptionOverlay" Grid.RowSpan="3" Margin="-20,-16" Background="#B305080C" Visibility="{Binding IsAdoptionConfirmationOpen, Converter={StaticResource ComparisonBooleanToVisibility}}" IsVisibleChanged="OnAdoptionOverlayVisibilityChanged" FocusManager.IsFocusScope="True">
            <Grid.InputBindings><KeyBinding Key="Escape" Command="{Binding CancelAdoptionCommand}" /></Grid.InputBindings>
            <Border Width="560" MaxHeight="520" VerticalAlignment="Center" HorizontalAlignment="Center" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" CornerRadius="12">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="20,16,20,10"><TextBlock Text="{Binding Language[WpfComparisonWorkspace.ConfirmTitle]}" FontSize="15" FontWeight="SemiBold" /></Border>
                    <Border DockPanel.Dock="Bottom" Padding="20,12" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Height="30" MinHeight="30" Padding="10,5" Style="{StaticResource RecipeSecondaryButtonStyle}" Command="{Binding CancelAdoptionCommand}" Content="{Binding Language[WpfComparisonWorkspace.Cancel]}" />
                        <Button x:Name="ConfirmWorkspaceAdoptionButton" Height="30" MinHeight="30" Padding="10,5" Margin="8,0,0,0" Style="{StaticResource RecipePrimaryButtonStyle}" Command="{Binding ConfirmAdoptionCommand}" Content="{Binding Language[WpfComparisonWorkspace.Confirm]}" />
                    </StackPanel></Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20,6,20,16">
                        <TextBlock Text="{Binding AdoptionModelText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding AdoptionDecisionRuleText}" Style="{StaticResource ComparisonCaptionStyle}" Margin="0,0,0,12" />
                        <TextBlock Text="{Binding AdoptionPartTestText}" Style="{StaticResource ComparisonCaptionStyle}" Margin="0,0,0,12" />
                        <TextBlock Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding EvidenceText}" Margin="0,0,0,12" />
                        <Grid Margin="0,0,0,12" TextElement.FontSize="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.Column="1" Text="A" Style="{StaticResource ComparisonMetricStyle}" /><TextBlock Grid.Column="2" Text="B" Style="{StaticResource ComparisonMetricStyle}" />
                            <TextBlock Grid.Row="1" Text="{Binding PrimaryMetricCaption}" Margin="8,7" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedA.PrimaryMetricText}" Style="{StaticResource ComparisonMetricStyle}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedB.PrimaryMetricText}" Style="{StaticResource ComparisonMetricStyle}" />
                            <TextBlock Grid.Row="2" Text="{Binding Language[WpfComparisonWorkspace.Misses]}" Margin="8,7" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding BaselineMisses}" Style="{StaticResource ComparisonMetricStyle}" /><TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding CandidateMisses}" Style="{StaticResource ComparisonMetricStyle}" />
                            <TextBlock Grid.Row="3" Text="{Binding Language[WpfComparisonWorkspace.Takt]}" Margin="8,7" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding BaselineTakt}" Style="{StaticResource ComparisonMetricStyle}" /><TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CandidateTakt}" Style="{StaticResource ComparisonMetricStyle}" />
                        </Grid>
                        <TextBlock Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.ReasonLabel]}" Margin="0,0,0,4" />
                        <TextBox x:Name="WorkspaceAdoptionReason" Height="30" Padding="8,5" Style="{StaticResource RecipeInputStyle}" Text="{Binding AdoptionReason, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.AdoptionHint]}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding OperationStatus}" Margin="0,12,0,0" />
                    </StackPanel></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
