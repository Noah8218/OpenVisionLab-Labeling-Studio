<UserControl x:Class="MvcVisionSystem.WpfModelComparisonWorkspacePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             FontFamily="{DynamicResource UiFontFamily}" FontSize="13"
             Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource RecipePageBrush}"
             AutomationProperties.AutomationId="ModelComparisonWorkspace">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" /></ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ComparisonBooleanToVisibility" />
            <SolidColorBrush x:Key="ComparisonSegmentBackgroundBrush" Color="#10151B" />
            <Style x:Key="ComparisonCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="ComparisonMetricStyle" TargetType="TextBlock">
                <Setter Property="Margin" Value="8,7" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="TextAlignment" Value="Right" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>
            <Style x:Key="ComparisonProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource RecipeProgressStyle}" />
            <Style x:Key="ComparisonTabButtonStyle" TargetType="Button" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="10,5" /><Setter Property="FontSize" Value="13" /><Setter Property="TextBlock.LineHeight" Value="18.85" /><Setter Property="TextBlock.LineStackingStrategy" Value="BlockLineHeight" />
                <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Style.Triggers>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsEnabled" Value="True" /></MultiTrigger.Conditions><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></MultiTrigger>
                    <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ComparisonImageItemStyle" TargetType="ListBoxItem">
                <Setter Property="Margin" Value="0,0,6,0" /><Setter Property="Padding" Value="0" /><Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Background" Value="{DynamicResource InputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" /><Setter Property="BorderThickness" Value="2" />
                <Setter Property="Cursor" Value="Hand" /><Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                    <Border CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter /></Border>
                </ControlTemplate></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True" /><Condition Property="IsSelected" Value="False" /></MultiTrigger.Conditions><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></MultiTrigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="ComparisonPopulatedContent" Grid.RowSpan="3" Visibility="{Binding HasModels, Converter={StaticResource ComparisonBooleanToVisibility}}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <Border Width="250" HorizontalAlignment="Left" CornerRadius="8" Padding="3" Background="{DynamicResource ComparisonSegmentBackgroundBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="3" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="ComparisonPerformanceTabButton" Content="{Binding Language[WpfComparisonWorkspace.PerformanceTab]}" Command="{Binding ShowPerformanceCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComparisonTabButtonStyle}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsPerformanceTab}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" /></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button x:Name="ComparisonRuleTabButton" Grid.Column="2" Content="{Binding Language[WpfComparisonWorkspace.RuleTab]}" Command="{Binding ShowRuleCommand}">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ComparisonTabButtonStyle}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsRuleTab}" Value="True" /><Condition Binding="{Binding IsEnabled, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /><Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" /></MultiDataTrigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </Grid>
                </Border>
                <TextBlock Margin="0,6,12,0" Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.FairComparison]}" Visibility="{Binding IsPerformanceTab, Converter={StaticResource ComparisonBooleanToVisibility}}" />
                <TextBlock Margin="0,6,12,0" Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.RuleIntroduction]}" Visibility="{Binding IsRuleTab, Converter={StaticResource ComparisonBooleanToVisibility}}" />
            </StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsPerformanceTab, Converter={StaticResource ComparisonBooleanToVisibility}}">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.ReferenceData]}" />
                    <ComboBox x:Name="ComparisonVersionCombo" Height="Auto" MinWidth="96" MaxWidth="456" MinHeight="30" Padding="8,5,28,5" Style="{StaticResource RecipeComboBoxStyle}" ItemsSource="{Binding VersionChoices}" SelectedItem="{Binding SelectedVersionChoice, Mode=TwoWay}" IsEnabled="{Binding CanChooseModels}" ToolTip="{Binding SelectedVersionLabel}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" MaxWidth="420" TextWrapping="Wrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Button x:Name="RunWorkspaceComparisonButton" Margin="8,0,0,0" Height="30" MinHeight="30" Padding="10,5" Style="{StaticResource RecipeSecondaryButtonStyle}" Command="{Binding RunComparisonCommand}" Content="{Binding Language[WpfComparisonWorkspace.Run]}" ToolTip="{Binding RunHint}" />
                </StackPanel>
                <Expander x:Name="ComparisonIdentityDetails" Grid.Row="1" Margin="0,6,0,0" HorizontalAlignment="Right" MaxWidth="456" Style="{StaticResource DatasetExpanderStyle}" Header="{Binding Language[WpfDatasetVersion.IdentityDetails]}" Visibility="{Binding IsPerformanceTab, Converter={StaticResource ComparisonBooleanToVisibility}}">
                    <TextBox x:Name="ComparisonIdentityBox" Style="{StaticResource RecipeInputStyle}" MinWidth="300" MaxWidth="420" IsReadOnly="True" Text="{Binding SelectionIdentityText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Language[WpfDatasetVersion.IdentityDetails]}" />
                </Expander>
                <StackPanel Orientation="Horizontal" Visibility="{Binding IsRuleTab, Converter={StaticResource ComparisonBooleanToVisibility}}">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Style="{StaticResource ComparisonCaptionStyle}" Text="{Binding Language[WpfComparisonWorkspace.Model]}" />
                    <ComboBox x:Name="DecisionRuleModelCombo" MinWidth="220" MaxWidth="456" MinHeight="30" Padding="8,5,28,5" Style="{StaticResource RecipeComboBoxStyle}" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedRuleModel, Mode=TwoWay}" IsEnabled="{Binding CanChooseModels}" DisplayMemberPath="ModelName" />
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Visibility="{Binding IsPerformanceTab, Converter={StaticResource ComparisonBooleanToVisibility}}" Margin="0,0,0,12" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" MaxHeight="260">
            <ScrollViewer x:Name="ComparisonTableScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel MinWidth="{Binding MetricTableMinimumWidth}" Grid.IsSharedSizeScope="True">
                    <Grid x:Name="ComparisonTableHeaders" Background="{DynamicResource PanelBrush}" MinHeight="32" Panel.ZIndex="1">
                        <Grid.RenderTransform><TranslateTransform Y="{Binding VerticalOffset, ElementName=ComparisonTableScroll}" /></Grid.RenderTransform>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ComparisonSelectionColumn" /><ColumnDefinition Width="0" /><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="225.8" /><ColumnDefinition Width="Auto" SharedSizeGroup="MetricsColumn" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="5" Margin="8,7" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Language[WpfComparisonWorkspace.RulePartTest]}" />
                        <TextBlock Grid.Column="0" Margin="8,7" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Language[WpfComparisonWorkspace.AB]}" />
                        <TextBlock Grid.Column="1" Margin="8,7" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Language[WpfComparisonWorkspace.Rank]}" Visibility="Collapsed" />
                        <TextBlock Grid.Column="2" Margin="8,7" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Language[WpfComparisonWorkspace.Model]}" />
                        <TextBlock Grid.Column="3" Margin="8,7" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="{Binding Language[WpfComparisonWorkspace.Version]}" />
                        <ItemsControl x:Name="ComparisonMetricHeaders" Grid.Column="4" ItemsSource="{Binding MetricHeaders}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="{Binding Key}" /></Grid.ColumnDefinitions>
                                    <Button MinWidth="70" Height="32" MinHeight="32" Padding="8,7" FontSize="12" Style="{StaticResource RecipeQuietButtonStyle}"
                                            Command="{Binding DataContext.SortCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Content="{Binding Value}" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ItemsControl x:Name="ComparisonRankRows" ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,0,0,1">
                                <Border.Style><Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding IsComparable}" Value="False"><Setter Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <Grid TextElement.FontSize="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="110" SharedSizeGroup="ComparisonSelectionColumn" /><ColumnDefinition Width="0" /><ColumnDefinition Width="*" MinWidth="200" /><ColumnDefinition Width="225.8" /><ColumnDefinition Width="Auto" SharedSizeGroup="MetricsColumn" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
                                    <Button Grid.Column="5" Margin="4,5" MinHeight="30" Padding="8,5" Style="{StaticResource RecipeQuietButtonStyle}" Command="{Binding DataContext.ShowRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"><TextBlock Text="{Binding DecisionTestSummaryText}" TextWrapping="Wrap" /></Button>
                                    <StackPanel Orientation="Horizontal" Margin="4,7" VerticalAlignment="Center">
                                        <StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding IsComparable}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                        <ToggleButton Width="30" Height="24" MinHeight="24" Padding="8,2" FontSize="12" Style="{StaticResource RecipeFilterToggleStyle}" Content="A" IsChecked="{Binding IsA, Mode=OneWay}" Command="{Binding DataContext.SelectACommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <ToggleButton Width="30" Height="24" MinHeight="24" Padding="8,2" FontSize="12" Margin="4,0,0,0" Style="{StaticResource RecipeFilterToggleStyle}" Content="B" IsChecked="{Binding IsB, Mode=OneWay}" Command="{Binding DataContext.SelectBCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                    <Button Height="24" MinHeight="24" Padding="8,2" FontSize="12" Margin="4,7" VerticalAlignment="Center" Content="{Binding ComparisonState}" Command="{Binding DataContext.ReevaluateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RecipeQuietButtonStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsComparable}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                    </Button>
                                    <TextBlock Grid.Column="1" Margin="8,7" Text="{Binding RankText}" TextAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" Visibility="Collapsed" />
                                    <Grid Grid.Column="2" Margin="8,7" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="ComparisonModelName" Text="{Binding ModelName}" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="17.4" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding ModelRole, NotifyOnTargetUpdated=True}" TargetUpdated="OnModelRoleTargetUpdated" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Grid.Column="3" Margin="8,7" VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding VersionText}" ToolTip="{Binding VersionDetail}" TextTrimming="CharacterEllipsis" LineHeight="17.4" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Margin="6,0,0,0" Text="{Binding VersionStateText}" TextWrapping="Wrap" FontSize="11" LineHeight="17.4" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding VersionStateText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <ItemsControl Grid.Column="4" ItemsSource="{Binding MetricCells}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" SharedSizeGroup="{Binding Key}" /></Grid.ColumnDefinitions>
                                                <TextBlock MinWidth="54" Text="{Binding Text}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ComparisonMetricStyle}"><Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsBest}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DatasetReadyTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /></DataTrigger>
                                                </Style.Triggers></Style></TextBlock.Style></TextBlock>
                                            </Grid>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="14,12" Text="{Binding Language[WpfComparisonWorkspace.NoModels]}">
                        <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource ComparisonCaptionStyle}"><Style.Triggers>
                            <DataTrigger Binding="{Binding HasModels}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                        </Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="2" Visibility="{Binding IsPerformanceTab, Converter={StaticResource ComparisonBooleanToVisibility}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0" Visibility="{Binding HasComparablePair, Converter={StaticResource ComparisonBooleanToVisibility}}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <WrapPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ComparisonImageTitleText" Text="{Binding ImageTitle}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasImageReview}" Value="True" /><Condition Binding="{Binding ErrorsOnly}" Value="True" /><Condition Binding="{Binding HasItems, ElementName=ComparisonImageStrip}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Text="{Binding ImagePositionText}" Style="{StaticResource ComparisonCaptionStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding EvidenceText}" Style="{StaticResource ComparisonCaptionStyle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    </WrapPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                        <CheckBox x:Name="ComparisonGroundTruthToggle" Style="{StaticResource RecipeCheckBoxStyle}" MinHeight="0" IsChecked="{Binding ShowGroundTruth}" Content="{Binding Language[WpfComparisonWorkspace.ShowGroundTruth]}" FontSize="12" Margin="0,0,12,0" Visibility="{Binding IsLocalizationTask, Converter={StaticResource ComparisonBooleanToVisibility}}" />
                        <TextBlock x:Name="ComparisonOverlayLegend" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" Visibility="{Binding IsLocalizationTask, Converter={StaticResource ComparisonBooleanToVisibility}}"><Run Text="━ " Foreground="{DynamicResource ErrorBrush}" /><Run Text="{Binding Language[WpfComparisonWorkspace.Extras], Mode=OneWay}" /><Run Text="   ━ " Foreground="{DynamicResource WarningBrush}" /><Run Text="{Binding Language[WpfComparisonWorkspace.Misses], Mode=OneWay}" /></TextBlock>
                        <CheckBox x:Name="ComparisonErrorsOnlyToggle" Style="{StaticResource RecipeCheckBoxStyle}" MinHeight="0" IsChecked="{Binding ErrorsOnly}" Content="{Binding Language[WpfComparisonWorkspace.ErrorsOnly]}" FontSize="12" />
                    </WrapPanel>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border SizeChanged="OnImageFrameSizeChanged" CornerRadius="8" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
                        <DockPanel><Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource PanelHeaderBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding BaselineTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding BaselineImageErrors}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /></Grid></Border>
                            <local:ComparisonImageView x:Name="ComparisonBaselineImage" Source="{Binding BaselinePreview}" Review="{Binding SelectedImage.Baseline}" ShowGroundTruth="{Binding ShowGroundTruth}" ClassColors="{Binding ClassColors}" FalsePositiveText="{Binding Language[WpfComparisonWorkspace.Extras]}" FalseNegativeText="{Binding Language[WpfComparisonWorkspace.Misses]}" FontFamily="{DynamicResource UiFontFamily}" Margin="0" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" SizeChanged="OnImageFrameSizeChanged" CornerRadius="8" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
                        <DockPanel><Border DockPanel.Dock="Top" Padding="10,6" Background="{DynamicResource PanelHeaderBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding CandidateTitle}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding CandidateImageErrors}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" /></Grid></Border>
                            <local:ComparisonImageView x:Name="ComparisonCandidateImage" Source="{Binding CandidatePreview}" Review="{Binding SelectedImage.Candidate}" ShowGroundTruth="{Binding ShowGroundTruth}" ClassColors="{Binding ClassColors}" FalsePositiveText="{Binding Language[WpfComparisonWorkspace.Extras]}" FalseNegativeText="{Binding Language[WpfComparisonWorkspace.Misses]}" FontFamily="{DynamicResource UiFontFamily}" Margin="0" />
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="ComparisonPreviewStatusText" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding PreviewError}" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding HasImageReview}" Value="True" /><Condition Binding="{Binding ErrorsOnly}" Value="True" /><Condition Binding="{Binding HasItems, ElementName=ComparisonImageStrip}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Text" Value="{Binding Language[WpfComparisonWorkspace.NoErrorImages]}" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <ListBox x:Name="ComparisonImageStrip" Grid.Row="2" Margin="0,8,0,0" Padding="0,0,0,4" Background="Transparent" BorderThickness="0" ItemsSource="{Binding ImageView}" SelectedItem="{Binding SelectedImage}" ItemContainerStyle="{StaticResource ComparisonImageItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ScrollViewer Focusable="False" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                    <ScrollViewer.Template><ControlTemplate TargetType="ScrollViewer">
                                        <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                            <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Orientation="Horizontal" Minimum="0" Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}" Value="{Binding HorizontalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                        </Grid>
                                    </ControlTemplate></ScrollViewer.Template>
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </ControlTemplate></Setter.Value></Setter>
                        <Style.Triggers><Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
                    </Style></ListBox.Style>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate><Grid Width="96" Height="64" ToolTip="{Binding ImageName}">
                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" />
                        <Border Background="{DynamicResource BadBackgroundBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" CornerRadius="4" Padding="5,0" Visibility="{Binding HasErrors, Converter={StaticResource ComparisonBooleanToVisibility}}"><TextBlock Text="{Binding ErrorText}" FontSize="10" Foreground="{DynamicResource ErrorBrush}" /></Border>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
            <Border x:Name="ComparisonPairEmptyState" Margin="0,0,12,0" Padding="16,28" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding HasComparablePair}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Language[WpfComparisonWorkspace.PairUnavailable]}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" /><TextBlock Text="{Binding OperationStatus}" Style="{StaticResource ComparisonCaptionStyle}" TextAlignment="Center" /></StackPanel>
            </Border>
            <Border Grid.Column="1" Visibility="{Binding HasComparablePair, Converter={StaticResource ComparisonBooleanToVisibility}}" CornerRadius="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="14,12">
                    <TextBlock Text="{Binding Language[WpfComparisonWorkspace.AllErrors]}" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource RecipeMutedTextBrush}" Margin="0,0,0,8" />
                    <Grid TextElement.FontSize="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="54" /><ColumnDefinition Width="54" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Grid.Column="1" Text="A" TextAlignment="Right" Margin="8,7" /><TextBlock Grid.Column="2" Text="B" TextAlignment="Right" Margin="8,7" />
                        <TextBlock Grid.Row="1" Text="{Binding Language[WpfComparisonWorkspace.Misses]}" Margin="8,7" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BaselineMisses}" TextAlignment="Right" Margin="8,7" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CandidateMisses}" TextAlignment="Right" Margin="8,7" />
