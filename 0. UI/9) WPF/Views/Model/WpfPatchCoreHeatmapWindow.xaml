<ui:FluentWindow x:Class="MvcVisionSystem.WpfPatchCoreHeatmapWindow"
                 x:Name="PatchCoreHeatmapWindow"
                 AutomationProperties.AutomationId="PatchCoreHeatmapWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="PatchCore 히트맵 검토"
                 Width="420"
                 Height="440"
                 MinWidth="340"
                 MinHeight="360"
                 Background="{DynamicResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PatchCoreHeatmapWindowButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Template" Value="{StaticResource WpfUiDarkButtonTemplate}" />
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="MinHeight" Value="30" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                        <Setter Property="Opacity" Value="0.45" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="18,16,18,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36"
                    Height="36"
                    Background="{DynamicResource CanvasBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0,0,10,0">
                <iconPacks:PackIconMaterial Kind="CrosshairsGps"
                                            Width="19"
                                            Height="19"
                                            Foreground="{DynamicResource AccentBrush}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PatchCore 히트맵"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="15"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding PatchCoreHeatmapFileName}"
                           ToolTip="{Binding PatchCoreHeatmapToolTip}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontFamily="Segoe UI"
                           FontSize="9.5"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0" />
            </StackPanel>
            <ui:Button Grid.Column="2"
                       Style="{StaticResource PatchCoreHeatmapWindowButtonStyle}"
                       AutomationProperties.Name="PatchCore 히트맵 닫기"
                       ToolTip="PatchCore 히트맵 검토 창을 닫습니다."
                       Command="{Binding TogglePatchCoreHeatmapCommand}"
                       MinWidth="68">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" Margin="0,0,4,0" />
                    <TextBlock Text="닫기" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </Grid>
        <Border x:Name="PatchCoreHeatmapPreviewBorder"
                Grid.Row="1"
                AutomationProperties.AutomationId="PatchCoreHeatmapPreviewBorder"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource ToolbarButtonBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="6">
            <Image x:Name="PatchCoreHeatmapPreviewImage"
                   AutomationProperties.AutomationId="PatchCoreHeatmapPreviewImage"
                   AutomationProperties.Name="PatchCore 결함 위치 히트맵"
                   Source="{Binding PatchCoreHeatmapSource}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True" />
        </Border>
        <Border Grid.Row="2"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,6"
                Margin="0,10,0,0">
            <TextBlock Text="{Binding PatchCoreHeatmapStatusText}"
                       ToolTip="{Binding PatchCoreHeatmapStatusText}"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       FontFamily="Segoe UI"
                       FontSize="10"
                       TextWrapping="Wrap" />
        </Border>
    </Grid>
</ui:FluentWindow>
