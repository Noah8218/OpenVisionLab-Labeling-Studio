<UserControl x:Class="MvcVisionSystem.WpfCandidateReviewPanel"
             x:Name="CandidateReviewRoot"
             AutomationProperties.AutomationId="CandidateReviewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="CandidateReviewResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="InferenceDecisionOkTextBrush" Color="#C7F5DF" />
        <SolidColorBrush x:Key="InferenceDecisionNgTextBrush" Color="#FFD0D0" />
        <SolidColorBrush x:Key="InferenceDecisionNgBorderBrush" Color="#73343A" />
        <SolidColorBrush x:Key="InferenceDecisionEvidenceTextBrush" Color="#FFB3B3" />
        <Style x:Key="CandidateReviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CandidateReviewIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>


        <Style x:Key="CandidateReviewListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <SolidColorBrush x:Key="CandidateComparisonWarningBrush" Color="#F5C542" />
        <SolidColorBrush x:Key="CandidateComparisonWarningBorderBrush" Color="#806A2A" />
        <SolidColorBrush x:Key="CandidateReviewAiBackgroundBrush" Color="#102223" />
        <SolidColorBrush x:Key="CandidateReviewAiPanelBrush" Color="#132427" />
        <SolidColorBrush x:Key="CandidateReviewAiBorderBrush" Color="#247C83" />
        <SolidColorBrush x:Key="CandidateReviewAiTextBrush" Color="#67D8DF" />
        <SolidColorBrush x:Key="CandidateReviewModelTextBrush" Color="#93C5FD" />

        <Style x:Key="CandidateComparisonPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparisonHighOverlap}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource CandidateComparisonWarningBorderBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidateComparisonOverlapTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="42" />
            <Setter Property="TextAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparisonHighOverlap}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CandidateComparisonWarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidateComparisonDecisionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="LineHeight" Value="13" />
            <Setter Property="MaxHeight" Value="39" />
            <Setter Property="ToolTip" Value="{Binding ComparisonDecisionText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComparisonHighOverlap}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource CandidateComparisonWarningBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelComparisonExampleButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template" Value="{DynamicResource WpfDarkButtonTemplate}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="3,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CandidateDisclosureExpanderStyle" TargetType="{x:Type Expander}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <Style x:Key="InferencePredictionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="PredictionChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="PredictionFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PredictionChrome" Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="PredictionChrome" Property="Background" Value="{DynamicResource SelectedRowBrush}" /><Setter TargetName="PredictionChrome" Property="BorderBrush" Value="{DynamicResource RecipeSelectedCardBorderBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="PredictionFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter TargetName="PredictionFocusCue" Property="BorderBrush" Value="Transparent" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="InferenceOptionalTextStyle" TargetType="TextBlock">
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>

        <DataTemplate x:Key="ModelComparisonExampleTemplate">
            <Button Margin="0,2,0,0"
                    Style="{StaticResource ModelComparisonExampleButtonStyle}"
                    Command="{Binding DataContext.ModelComparisonExampleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding ReviewText}"
                    AutomationProperties.Name="{Binding Title}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <iconPacks:PackIconMaterial Kind="{Binding IconKind}"
                                                Width="13"
                                                Height="13"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Margin="0,1,5,0" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LocationText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="9"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ActionText}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
      </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border x:Name="InferenceResultsHeader" Grid.Row="0" Padding="12,10"
            DataContext="{Binding DataContext.ShellViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
            Visibility="{Binding IsInferenceStageActive, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
            BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,0,0,1"
            TextElement.FontFamily="{DynamicResource UiFontFamily}" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource RecipeTextBrush}">
        <TextBlock Text="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Workspace.Results]}" FontSize="15" FontWeight="SemiBold" LineHeight="21.75" LineStackingStrategy="BlockLineHeight" />
    </Border>
    <ScrollViewer x:Name="CandidateReviewScrollViewer"
                  Grid.Row="1"
                  AutomationProperties.AutomationId="CandidateReviewScrollViewer"
                  Margin="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True"
                  Focusable="False">
    <Grid>
    <StackPanel x:Name="InferenceResultsPanel" DataContext="{Binding DataContext.ShellViewModel, RelativeSource={RelativeSource AncestorType=Window}}"
                TextElement.FontFamily="{DynamicResource UiFontFamily}" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource RecipeTextBrush}">
        <StackPanel.Style>
            <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsInferenceStageActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        </StackPanel.Style>
        <Border Padding="14,12" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <StackPanel x:Name="InferenceCompletedDecision" Visibility="{Binding HasDisplayedInferenceResult, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border x:Name="InferenceDecisionCard" Padding="14,10" BorderThickness="1" CornerRadius="7.5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource RecipeTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding InferenceDecisionIsNg}" Value="False">
                                    <Setter Property="Background" Value="{DynamicResource DatasetReadyBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource DatasetReadyBorderBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource InferenceDecisionOkTextBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InferenceDecisionIsNg}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource BadBackgroundBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource InferenceDecisionNgBorderBrush}" />
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource InferenceDecisionNgTextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="InferenceResultTitle" Text="{Binding InferenceDecisionTitleText, Mode=OneWay}" AutomationProperties.Name="{Binding InferenceDecisionTitleText, Mode=OneWay}"
                                   Foreground="{Binding Path=(TextElement.Foreground), ElementName=InferenceDecisionCard}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="InferencePartDecisionText" Grid.Column="1" Text="{Binding InferenceDecisionLabelText, Mode=OneWay, Converter={StaticResource CandidateReviewWordBoundaryConverter}}" AutomationProperties.Name="{Binding InferenceDecisionValueText, Mode=OneWay}"
                                   Foreground="{Binding Path=(TextElement.Foreground), ElementName=InferenceDecisionCard}" FontSize="22" FontWeight="Bold" LineHeight="31.9" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Button Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Decision.Rule]}" Command="{Binding OpenInferenceDecisionRuleCommand}" Style="{DynamicResource RecipeQuietButtonStyle}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                <StackPanel x:Name="InferenceAnomalyEvidence" Margin="0,8,0,0" Visibility="{Binding IsAnomalyInference, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock x:Name="InferenceAnomalyScoreText" Text="{Binding InferenceAnomalyScoreText}" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="InferenceSavedVerdictText" Text="{Binding InferenceSavedVerdictText}" FontSize="12" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
                </StackPanel>
                <TextBlock x:Name="InferenceResultWarning" Text="{Binding InferenceResultWarningText}" Style="{StaticResource InferenceOptionalTextStyle}" Foreground="{DynamicResource WarningBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <TextBlock Text="{Binding InferenceResultSourceText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,8,0,0" />
                <TextBlock x:Name="InferenceResultCounts" Text="{Binding InferenceVisiblePredictionCountText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,4" ><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsAnomalyInference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding HasDisplayedInferenceResult}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock x:Name="InferenceResultEmpty" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Setter Property="Text" Value="{Binding InferenceResultEmptyText, Mode=OneWay, Converter={StaticResource CandidateReviewWordBoundaryConverter}}" /><Setter Property="AutomationProperties.Name" Value="{Binding InferenceResultEmptyText, Mode=OneWay}" /><Setter Property="FontSize" Value="12" /><Setter Property="Margin" Value="0,8,0,0" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Style.Triggers><DataTrigger Binding="{Binding HasVisibleInferencePredictions}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding IsInferenceNotRunHintVisible}" Value="True"><Setter Property="Text" Value="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Workspace.NotRunHint], Mode=OneWay, Converter={StaticResource CandidateReviewWordBoundaryConverter}}" /><Setter Property="AutomationProperties.Name" Value="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Workspace.NotRunHint], Mode=OneWay}" /><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18.85" /><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
                <ListBox x:Name="InferencePredictionList" ItemsSource="{Binding InferencePredictionListItems}" SelectedValuePath="Payload" SelectedValue="{Binding SelectedInferencePrediction, Mode=TwoWay}"
                         IsEnabled="{Binding CanSelectInferencePrediction}" Background="Transparent" Foreground="{DynamicResource RecipeTextBrush}" BorderThickness="0"
                         FontFamily="{DynamicResource UiFontFamily}" FontSize="13" MaxHeight="220" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemContainerStyle="{StaticResource InferencePredictionItemStyle}"><ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding IsAnomalyInference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding HasVisibleInferencePredictions}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <Border x:Name="InferenceClassSwatch" Width="12" Height="12" CornerRadius="3" Background="{Binding StateBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="Normal" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="8,0,8,0" />
                                <Border x:Name="InferenceDecisionEvidenceChip" Grid.Column="2" Padding="6,0" BorderThickness="1" CornerRadius="9.2" Background="{DynamicResource BadBackgroundBrush}" BorderBrush="{StaticResource InferenceDecisionNgBorderBrush}"
                                        VerticalAlignment="Center" Visibility="{Binding IsInferenceDecisionEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Decision.EvidenceHint]}">
                                    <TextBlock x:Name="InferenceDecisionEvidenceText" Text="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfModelBenchmark.Header.Evidence], Mode=OneWay, StringFormat='NG {0}', NotifyOnTargetUpdated=True}" TargetUpdated="OnInferenceEvidenceTargetUpdated"
                                               AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource InferenceDecisionEvidenceTextBrush}" />
                                </Border>
                                <TextBlock x:Name="InferenceCandidateValue" Grid.Column="3" Text="{Binding SecondaryText}" Margin="8,0,0,0" FontSize="13" FontWeight="Normal" Typography.NumeralAlignment="Tabular" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="InferenceResultOutsideFilter" Visibility="Collapsed" Text="{Binding InferenceResultOutsideFilterText}" Style="{StaticResource InferenceOptionalTextStyle}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />
                <WrapPanel Margin="0,8,0,0" Visibility="Collapsed">
                    <Button Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Seen.Mark]}" Command="{Binding MarkInferenceResultSeenCommand}" Style="{DynamicResource RecipeSecondaryButtonStyle}" Margin="0,0,8,8" />
                    <Button Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Seen.Next]}" Command="{Binding MarkInferenceResultSeenAndNextCommand}" Style="{DynamicResource RecipeSecondaryButtonStyle}" Margin="0,0,0,8" />
                    <Button Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Seen.Results]}" Command="{Binding ShowInferenceResultsCommand}" Style="{DynamicResource RecipeQuietButtonStyle}" Margin="0,0,0,8" />
                </WrapPanel>
                <TextBlock Text="{Binding InferenceResultReviewText}" Foreground="{DynamicResource RecipeMutedTextBrush}" Visibility="Collapsed" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border x:Name="InferenceSummaryPanel" Padding="14,12" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,0,0,1"
                Visibility="{Binding IsInferenceSummaryReady, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
                <TextBlock Text="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Workspace.SummaryTitle]}" FontSize="12" FontWeight="SemiBold" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource RecipeMutedTextBrush}" Margin="0,0,0,8" />
                <TextBlock x:Name="InferenceSummaryText" Text="{Binding InferenceSummaryText}" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Margin="0,0,0,6" />
                <ItemsControl x:Name="InferenceClassSummaryList" ItemsSource="{Binding InferenceClassSummaryRows}"><ItemsControl.Style><Style TargetType="ItemsControl"><Style.Triggers><DataTrigger Binding="{Binding IsAnomalyInference}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ItemsControl.Style>
                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Border Width="12" Height="12" CornerRadius="3" Background="{Binding StateBrush}" VerticalAlignment="Center" Margin="0,0,8,0" /><TextBlock Grid.Column="1" Text="{Binding Title}" TextWrapping="Wrap" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Margin="0,0,8,0" /><TextBlock Grid.Column="2" Text="{Binding SecondaryText}" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
    <Grid x:Name="LegacyCandidateReviewPanel" Margin="8">
        <Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="CandidateReviewModePanel"
                AutomationProperties.AutomationId="CandidateReviewModePanel"
                Background="{DynamicResource CanvasBrush}"
                BorderBrush="{DynamicResource BorderBrushDark}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8,6"
                Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CandidateReviewModeTitleText"
                               AutomationProperties.AutomationId="CandidateReviewModeTitleText"
                               Text="{Binding PanelModeTitleText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                    <Border x:Name="CandidateReviewModeBadge"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="CandidateReviewModeBadge"
                            Background="{StaticResource CandidateReviewAiBackgroundBrush}"
                            BorderBrush="{StaticResource CandidateReviewAiBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,2"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="CandidateReviewModeBadgeText"
                                   AutomationProperties.AutomationId="CandidateReviewModeBadgeText"
                                   Text="{Binding PanelModeBadgeText}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                    </Border>
                </Grid>
                <TextBlock x:Name="CandidateReviewModeScopeText"
                           AutomationProperties.AutomationId="CandidateReviewModeScopeText"
                           Text="{Binding PanelModeScopeText}"
                           Foreground="{StaticResource CandidateReviewAiTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0" />
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LabelSuspicionReviewTemplate}" />
                <Border x:Name="InferenceResultSourcePanel" Padding="0,8,0,0"
