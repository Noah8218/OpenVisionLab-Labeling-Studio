            TextElement.FontFamily="{DynamicResource UiFontFamily}" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource RecipeTextBrush}">
        <Border.Style>
            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsInferenceStageActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
        </Border.Style>
        <StackPanel>
            <Button x:Name="InferenceSendToLabelingButton" MinHeight="31" FontSize="13" FontWeight="Normal" Padding="10,5" Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Transfer.Action]}" Command="{Binding SendInferenceResultsToLabelingCommand}" Style="{DynamicResource RecipeSecondaryButtonStyle}" />
            <Button x:Name="InferenceExportResultsButton" MinHeight="31" FontSize="13" FontWeight="Normal" Padding="10,5" Content="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Export.Action]}" Command="{Binding ExportInferenceResultsCommand}" Style="{DynamicResource RecipeSecondaryButtonStyle}" Margin="0,8,0,0" ToolTip="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Export.Scope]}" AutomationProperties.HelpText="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Export.Scope]}" />
            <TextBlock Text="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfInference.Workspace.ResultBoundary]}" Foreground="{DynamicResource RecipeDisabledTextBrush}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </Border>
    </Grid>
</UserControl>
