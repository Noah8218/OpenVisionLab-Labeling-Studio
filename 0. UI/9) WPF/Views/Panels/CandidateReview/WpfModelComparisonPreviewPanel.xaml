<UserControl x:Class="MvcVisionSystem.WpfModelComparisonPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Title], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeTextBrush}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
        <TextBlock x:Name="ComparisonPreviewSourceText" Text="{Binding ComparisonPreviewSourceText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.PreviewEmpty], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0">
            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasModelComparisonPreview}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Baseline], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Image x:Name="BaselineComparisonPreviewImage" Source="{Binding BaselineComparisonPreviewImage}" Stretch="Uniform" MaxHeight="230" Margin="0,5,0,0" AutomationProperties.Name="A model predictions" />
            </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12">
            <StackPanel>
                <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Candidate], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Image x:Name="CandidateComparisonPreviewImage" Source="{Binding CandidateComparisonPreviewImage}" Stretch="Uniform" MaxHeight="230" Margin="0,5,0,0" AutomationProperties.Name="B model predictions" />
            </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="{Binding ComparisonPreviewErrorText}" Foreground="{DynamicResource WarningBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Boundary], RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,8,0,0" />
        <WrapPanel Margin="0,12,0,0">
            <ui:Button x:Name="ModelErrorLabelReviewButton" AutomationProperties.AutomationId="ModelErrorLabelReviewButton" Style="{DynamicResource RecipeSecondaryButtonStyle}" Command="{Binding ModelErrorLabelReviewCommand}" Margin="0,0,8,8">
                <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.LabelReview], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
            </ui:Button>
            <ui:Button x:Name="ModelErrorQualityReviewButton" AutomationProperties.AutomationId="ModelErrorQualityReviewButton" Style="{DynamicResource RecipeSecondaryButtonStyle}" Command="{Binding ModelErrorQualityReviewCommand}" Margin="0,0,8,8">
                <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.QualityReview], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
            </ui:Button>
            <ui:Button x:Name="ReturnToModelComparisonButton" AutomationProperties.AutomationId="ReturnToModelComparisonButton" Style="{DynamicResource RecipeSecondaryButtonStyle}" Command="{Binding ReturnToModelComparisonCommand}" Margin="0,0,0,8">
                <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Return], RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap" />
            </ui:Button>
        </WrapPanel>
        <Expander x:Name="ComparisonPreviewDetailsExpander" Style="{DynamicResource DatasetExpanderStyle}" Header="{Binding DataContext.LanguageViewModel[WpfTraining.Comparison.Details], RelativeSource={RelativeSource AncestorType=Window}}" IsExpanded="False">
            <StackPanel Margin="0,6,0,0">
                <TextBlock Text="{Binding ModelComparisonSourceText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" />
                <TextBlock Text="{Binding ModelComparisonDetailText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
                <TextBlock Text="{Binding ModelComparisonBenchmarkText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
