<UserControl x:Class="MvcVisionSystem.WpfClassCatalogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="InputBrush" Color="#11161D" />
            <SolidColorBrush x:Key="InputBorderBrush" Color="#364152" />
            <Style x:Key="ClassCatalogIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ClassCatalogButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="Margin" Value="5,0,0,0" />
            </Style>

            <Style x:Key="ClassCatalogTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style x:Key="ClassCatalogSectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,5" />
            </Style>

            <Style x:Key="ClassCatalogListBoxItemStyle" TargetType="ListBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <iconPacks:PackIconMaterial x:Name="ClassSelectedCue" Kind="Check" Width="14" Height="14"
                                                                   Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" Visibility="Hidden" />
                                        <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                                    </Grid>
                                </Border>
                                <Border x:Name="ClassFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="ClassSelectedCue" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="ClassFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ClassFocusCue" Property="BorderBrush" Value="Transparent" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeRowHoverBrush}" />
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource RecipeSelectedHoverBrush}" />
                    </MultiTrigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="ClassColorPresetItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ClassCatalogListBoxItemStyle}">
                <Setter Property="Background" Value="{DynamicResource RecipeButtonBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="MinHeight" Value="38" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="ToolTip" Value="{Binding Name}" />
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <DataTemplate x:Key="ClassCatalogColorPresetTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="11"
                            Height="11"
                            CornerRadius="2"
                            Background="{Binding Brush}"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="2*" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="ClassCatalogSettingsScrollViewer"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border x:Name="ClassCatalogGuidePanel"
                        Background="{DynamicResource RecipeSurfaceBrush}"
                        BorderBrush="{DynamicResource RecipeBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="8"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock x:Name="ClassCatalogGuideTitleText"
                                   Text="{Binding ClassCatalogGuideTitleText}"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock x:Name="ClassCatalogGuideDetailText"
                                   Text="{Binding ClassCatalogGuideDetailText}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="ClassCatalogSummaryText"
                                   AutomationProperties.AutomationId="ClassCatalogSummaryText"
                                   Text="{Binding ClassCatalogSummaryText}"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,0" />
                        <TextBlock x:Name="CurrentDrawingClassTitleText"
                                   AutomationProperties.AutomationId="CurrentDrawingClassTitleText"
                                   Text="{Binding CurrentDrawingClassTitleText}"
                                   Foreground="{DynamicResource RecipeTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />
                        <TextBlock x:Name="CurrentDrawingClassDetailText"
                                   AutomationProperties.AutomationId="CurrentDrawingClassDetailText"
                                   Text="{Binding CurrentDrawingClassDetailText}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="10.5"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,2,0,0" />
                        <TextBlock x:Name="ClassCatalogActionText"
                                   AutomationProperties.AutomationId="ClassCatalogActionText"
                                   Text="{Binding ClassCatalogActionText}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="1"
                           x:Name="ClassSectionLabelText"
                           Text="{Binding ClassSectionLabelText}"
                           Style="{StaticResource ClassCatalogSectionLabelStyle}" />
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ClassNameBox"
                             AutomationProperties.AutomationId="ClassNameBox"
                             Style="{StaticResource ClassCatalogTextBoxStyle}"
                             Text="{Binding NewClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding ClassNameToolTipText}"
                             mvvm:InputCommandBehaviors.PreviewKeyInputCommand="{Binding ClassNamePreviewKeyDownCommand}" />
                    <ui:Button x:Name="AddClassButton"
                               Grid.Column="1"
                               Style="{StaticResource ClassCatalogButtonStyle}"
                               MinWidth="62"
                               AutomationProperties.Name="{Binding AddClassAutomationNameText}"
                               ToolTip="{Binding AddClassToolTipText}"
                               Command="{Binding AddClassCommand}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <iconPacks:PackIconMaterial Style="{StaticResource ClassCatalogIconStyle}" Kind="Plus" />
                            <TextBlock Text="{Binding AddClassButtonText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </Grid>

                <Expander x:Name="ClassColorAdvancedPanel"
                          Style="{StaticResource DatasetExpanderStyle}"
                          Grid.Row="3"
                          Header="{Binding ClassColorSectionTitleText}"
                          Foreground="{DynamicResource RecipeMutedTextBrush}"
                          FontFamily="{DynamicResource UiFontFamily}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          IsExpanded="False"
                          Margin="0,9,0,0">
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="ClassColorBox"
                                 AutomationProperties.AutomationId="ClassColorBox"
                                 AutomationProperties.Name="{Binding ClassColorAutomationNameText}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 ItemsSource="{Binding ColorPresets}"
                                 SelectedItem="{Binding SelectedColorPreset, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource ClassCatalogColorPresetTemplate}"
                                 ItemContainerStyle="{StaticResource ClassColorPresetItemStyle}"
                                 ToolTip="{Binding ClassColorToolTipText}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <ui:Button x:Name="ApplyClassColorButton"
                                   Grid.Column="1"
                                   Style="{StaticResource ClassCatalogButtonStyle}"
                                   MinWidth="76"
                                   AutomationProperties.Name="{Binding ApplyClassColorAutomationNameText}"
                                   ToolTip="{Binding ApplyClassColorToolTipText}"
                                   Command="{Binding ApplyClassColorCommand}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <iconPacks:PackIconMaterial Style="{StaticResource ClassCatalogIconStyle}" Kind="PaletteOutline" />
                                <TextBlock Text="{Binding ApplyClassColorButtonText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Expander>

                <TextBlock x:Name="ClassEditStatusText"
                           Grid.Row="4"
                           Text="{Binding StatusText}"
                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,7,0,6" />
                <TextBlock x:Name="RecipeClassListHeader"
                           Grid.Row="5"
                           Text="{Binding RecipeClassListTitleText}"
                           ToolTip="{Binding RecipeClassListGuideText}"
                           Style="{StaticResource ClassCatalogSectionLabelStyle}"
                           Margin="0,2,0,5" />
                <TextBlock x:Name="ClassIndexContractText"
                           Grid.Row="6"
                           AutomationProperties.AutomationId="ClassIndexContractText"
                           Text="{Binding ClassIndexContractText}"
                           ToolTip="{Binding RecipeClassListGuideText}"
                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="10.5"
                           TextWrapping="Wrap"
                           Margin="0,0,0,5" />
            </Grid>
        </ScrollViewer>

        <ListBox x:Name="ClassListBox"
                 Grid.Row="1"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource RecipeMutedTextBrush}"
                 ItemsSource="{Binding Classes}"
                 SelectedItem="{Binding SelectedClass, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ClassCatalogListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 mvvm:InputCommandBehaviors.SelectedItemChangedCommand="{Binding ClassSelectionChangedCommand}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding CanonicalIndex, StringFormat='#{0}'}"
                                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="RowClassNameBox" Grid.Column="1" MinWidth="145"
                                 Style="{StaticResource ClassCatalogTextBoxStyle}"
                                 Text="{Binding EditName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="{Binding IsArchived}"
                                 AutomationProperties.Name="{Binding CanonicalDisplayText}"
                                 ToolTip="{Binding ToolTip}" />
                        <ui:Button x:Name="RowRenameClassButton" Grid.Column="2" MinWidth="68"
                                   Style="{StaticResource ClassCatalogButtonStyle}"
                                   Content="{Binding DataContext.RowRenameButtonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   Command="{Binding DataContext.RenameClassRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   CommandParameter="{Binding}" />
                        <ui:Button x:Name="RowArchiveClassButton" Grid.Column="3" MinWidth="68"
                                   Style="{StaticResource ClassCatalogButtonStyle}"
                                   Content="{Binding RowArchiveButtonText}"
                                   ToolTip="{Binding ToolTip}"
                                   Command="{Binding DataContext.ArchiveClassRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   CommandParameter="{Binding}" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="6,0,0,0">
                            <Border Width="12" Height="12" CornerRadius="2"
                                    Background="{Binding DrawBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="RowClassColorBox" Width="92" Margin="0"
                                     Style="{StaticResource ClassCatalogTextBoxStyle}"
                                     Text="{Binding ColorHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="{Binding DataContext.RowColorInputNameText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                     ToolTip="{Binding DataContext.RowColorInputHintText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        </StackPanel>
                        <ui:Button x:Name="RowApplyClassColorButton" Grid.Column="5" MinWidth="76"
                                   Style="{StaticResource ClassCatalogButtonStyle}"
                                   Content="{Binding DataContext.RowColorApplyButtonText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   Command="{Binding DataContext.ApplyClassColorRowCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                   CommandParameter="{Binding}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
