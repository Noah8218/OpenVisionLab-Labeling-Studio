                                    <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.LanguageViewModel[WpfInference.Workspace.Images], RelativeSource={RelativeSource AncestorType=Window}}" /><Setter Property="FontSize" Value="15" /><Setter Property="Margin" Value="12,0,8,0" /><Setter Property="LineHeight" Value="21.75" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /><Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" /></DataTrigger>
