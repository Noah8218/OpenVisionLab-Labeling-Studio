                                            <Style TargetType="Border">
                                                <Setter Property="Width" Value="56"/>
                                                <Setter Property="Height" Value="38"/>
                                                <Setter Property="Margin" Value="0,4"/>
                                                <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
                                                <Setter Property="CornerRadius" Value="4"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                        <Setter Property="Width" Value="52"/>
                                                        <Setter Property="Height" Value="46"/>
                                                        <Setter Property="Margin" Value="0"/>
                                                        <Setter Property="Background" Value="{DynamicResource DatasetInputBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DatasetThumbnailBorderBrush}"/>
                                                        <Setter Property="CornerRadius" Value="7"/>
                                                    </DataTrigger>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                            <Condition Binding="{Binding DataContext.ShellViewModel.IsCompactDatasetLayout, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Width" Value="42"/>
                                                        <Setter Property="Height" Value="38"/>
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Image Source="{Binding ThumbnailSource, IsAsync=True}"
                                               Stretch="Uniform"
                                               Opacity="0.92"
                                               RenderOptions.BitmapScalingMode="LowQuality" />
                                    </Border>
                                    <Grid Grid.Column="1" Margin="8,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CandidateReviewBadgeText" Text="{Binding CandidateReviewBadgeText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Setter Property="Grid.Column" Value="1" />
                                                    <Setter Property="Margin" Value="6,0,0,0" />
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Grid.Column" Value="0" />
                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                            <Setter Property="Margin" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock x:Name="LabelSuspicionUnavailableText" Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding LabelSuspicionUnavailableText}" ToolTip="{Binding LabelSuspicionUnavailableToolTip}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" FontSize="11">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding LabelSuspicionUnavailableReason}" Value="TrainedModelUnavailable" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding HasSavedLabelFile}" Value="False" /><Condition Binding="{Binding LabelSuspicionUnavailableReason}" Value="SavedLabelsUnavailable" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding FileName}"
                                                   ToolTip="{Binding FileName}"
                                                   AutomationProperties.Name="{Binding FileName}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource QueueRowFileNameStyle}">
                                                    <Setter Property="Grid.Row" Value="0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Grid.Row" Value="2" />
                                                            <Setter Property="Grid.ColumnSpan" Value="2" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding LocalizedQueueStatusSummary}" Margin="0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource QueueRowStatusStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock x:Name="ImageQueueReviewStatusText"
                                                   Grid.ColumnSpan="2"
                                                   AutomationProperties.AutomationId="ImageQueueReviewStatusText"
                                                   Text="{Binding LocalizedImageReviewStatusText}"
                                                   Margin="0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource QueueRowTextStyle}">
                                                    <Setter Property="Grid.Row" Value="2" />
                                                    <Setter Property="FontSize" Value="11" />
                                                    <Setter Property="Foreground" Value="{Binding ImageReviewStatusBrush}" />
                                                    <Setter Property="TextTrimming" Value="None" />
                                                    <Setter Property="TextWrapping" Value="Wrap" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Grid.Row" Value="4" />
                                                            <Setter Property="FontSize" Value="12" />
                                                            <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Grid.Column="2" Text="✓" Foreground="{DynamicResource RecipeAccentBrush}" FontSize="12" Margin="3,0,0,0" VerticalAlignment="Top" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter Property="Visibility" Value="Visible" />
            </MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AnnotationCountText}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding AnnotationCountText}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <Border x:Name="QueueRowAnomalyVerdictBadge" Padding="6,0" CornerRadius="9.2" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Normal">
                                                            <Setter Property="Visibility" Value="Visible" /><Setter Property="Background" Value="#16352A" /><Setter Property="BorderBrush" Value="#2F6B52" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Abnormal">
                                                            <Setter Property="Visibility" Value="Visible" /><Setter Property="Background" Value="#3D1E22" /><Setter Property="BorderBrush" Value="#73343A" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding LocalizedAnomalyVerdictText}" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#9BE8C4" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding AnomalyReviewState}" Value="Abnormal"><Setter Property="Foreground" Value="#FFB3B3" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    <ToggleButton x:Name="SelectedQueueImagePathToggle"
                                                  Style="{StaticResource SelectedQueueImagePathToggleStyle}"
                                                  IsChecked="{Binding DataContext.IsSelectedImagePathVisible, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=TwoWay}">
                                        <iconPacks:PackIconMaterial Width="13" Height="13" Kind="FileSearchOutline" />
                                    </ToggleButton>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                                <Grid Height="48" Visibility="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border BorderThickness="3,0,0,0" Padding="7,5,10,5">
                                        <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="Transparent" /><Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <Border Width="56" Height="38" CornerRadius="4" ClipToBounds="True"><Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" /></Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" /><TextBlock Text="{Binding InferenceStateText, StringFormat='● {0}'}" Foreground="{Binding InferenceStateBrush}" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
</Grid></DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="작업" Binding="{Binding LocalizedLabelStatus}" Width="60" ElementStyle="{StaticResource ImageQueueTextStyle}" Visibility="Collapsed">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.QueueDecisionColumnHeaderText, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="상태" Binding="{Binding LocalizedDetectStatus}" Width="64" ElementStyle="{StaticResource ImageQueueTextStyle}" Visibility="Collapsed">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.QueueSecondaryColumnHeaderText, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="크기" Binding="{Binding Dimensions}" Width="54" ElementStyle="{StaticResource ImageQueueTextStyle}" Visibility="Collapsed">
                        <DataGridTextColumn.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DataContext.QueueDimensionsColumnHeaderText, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            </DataTemplate>
                        </DataGridTextColumn.HeaderTemplate>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
            <ScrollViewer x:Name="ImageQueueNoMatchPanel"
                          Grid.Row="2"
                          Margin="8"

                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="ImageQueueNoMatchPanel">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource DatasetSurfaceBrush}" />
            </DataTrigger>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding HasItems, ElementName=ImageQueueGrid}" Value="False" />
                                    <Condition Binding="{Binding HasQueueFilter}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <StackPanel Margin="8,12">
                    <TextBlock Text="{Binding NoMatchingImagesTitleText}"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold" FontSize="12"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding NoMatchingImagesDetailText}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,8,0,12" FontSize="12"
                               TextWrapping="Wrap" />
                    <ui:Button x:Name="ResetImageQueueFiltersButton" Style="{DynamicResource RecipeSecondaryButtonStyle}"
                               Height="Auto" MinHeight="32" MinWidth="0" Margin="0" Padding="8,6"
                               HorizontalContentAlignment="Center"
                               AutomationProperties.AutomationId="ResetImageQueueFiltersButton"
                               AutomationProperties.Name="{Binding ResetQueueFiltersText}"
                               ToolTip="{Binding ResetQueueFiltersToolTipText}"
                               Command="{Binding ResetQueueFiltersCommand}">
                        <TextBlock Text="{Binding ResetQueueFiltersText}" TextWrapping="Wrap" TextAlignment="Center" />
                    </ui:Button>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="3" BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0" Padding="10,8"><Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <Expander x:Name="ImageQueuePrimaryActionsPanel"
                              Style="{StaticResource QueueInferenceVisibilityStyle}"
                              IsExpanded="False"
                              Margin="0,0,0,4"
                              Header="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.MoreActions], RelativeSource={RelativeSource AncestorType=Window}}"
                              ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.MoreActions.ToolTip], RelativeSource={RelativeSource AncestorType=Window}}"
                              AutomationProperties.AutomationId="ImageQueuePrimaryActionsPanel"
                              AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.Static.MoreActions], RelativeSource={RelativeSource AncestorType=Window}}"
                              Foreground="{DynamicResource PrimaryTextBrush}">
                        <WrapPanel x:Name="ImageQueuePrimaryActionsItemsPanel" MinHeight="36" Margin="0,2,0,2" VerticalAlignment="Center">
                            <ui:Button Style="{StaticResource QueueIconButtonStyle}" ToolTip="{Binding LoadConfiguredImageRootToolTipText}" AutomationProperties.AutomationId="LoadConfiguredImageRootButton" AutomationProperties.Name="{Binding LoadConfiguredImageRootNameText}" Command="{Binding LoadImageRootCommand}">
                                <iconPacks:PackIconMaterial Style="{StaticResource QueueIconStyle}" Kind="FolderImage" />
                            </ui:Button>
                            <ui:Button Style="{StaticResource QueueIconButtonStyle}" ToolTip="{Binding BrowseImageFolderToolTipText}" AutomationProperties.Name="{Binding BrowseImageFolderNameText}" Command="{Binding BrowseImageFolderCommand}">
                                <iconPacks:PackIconMaterial Style="{StaticResource QueueIconStyle}" Kind="FolderOpen" />
                            </ui:Button>
                            <ui:Button Style="{StaticResource QueueIconButtonStyle}" ToolTip="{Binding RefreshImageQueueToolTipText}" AutomationProperties.Name="{Binding RefreshImageQueueNameText}" Command="{Binding RefreshImageQueueCommand}">
                                <iconPacks:PackIconMaterial Style="{StaticResource QueueIconStyle}" Kind="Refresh" />
                            </ui:Button>
                            <ui:Button x:Name="QuickLoadSampleButton"
                                       Style="{StaticResource QueuePrimaryActionButtonStyle}"
                                       MinWidth="104"
                                       AutomationProperties.AutomationId="QuickLoadSampleButton"
                                       AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfImageQueue.Sample.Load.Name], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       AutomationProperties.HelpText="{Binding DataContext.LanguageViewModel[WpfImageQueue.Sample.Load.ToolTip], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       ToolTip="{Binding DataContext.LanguageViewModel[WpfImageQueue.Sample.Load.ToolTip], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                       Command="{Binding DataContext.ShellViewModel.LoadSampleCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Style="{StaticResource ToolbarIconStyle}" Kind="ImageSearch" />
                                    <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfImageQueue.Sample.Load.Text], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="NextUnlabeledPrimaryButton" Style="{StaticResource QueuePrimaryActionButtonStyle}" MinWidth="104" ToolTip="{Binding NextUnlabeledToolTip}" AutomationProperties.AutomationId="NextUnlabeledPrimaryButton" AutomationProperties.Name="{Binding NextUnlabeledActionText}" AutomationProperties.HelpText="{Binding NextUnlabeledToolTip}" Command="{Binding NextUnlabeledCommand}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <iconPacks:PackIconMaterial Style="{StaticResource ToolbarIconStyle}" Kind="ArrowRightCircleOutline" />
                                    <TextBlock x:Name="NextUnlabeledPrimaryButtonText" Text="{Binding NextUnlabeledActionText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:Button>
                            <ui:Button x:Name="OpenSelectedQueueImageButton" Style="{StaticResource QueueIconButtonStyle}" ToolTip="{Binding OpenSelectedQueueImageToolTipText}" AutomationProperties.Name="{Binding OpenSelectedQueueImageNameText}" IsEnabled="{Binding IsOpenSelectedImageEnabled}" Command="{Binding OpenSelectedQueueImageCommand}">
                                <iconPacks:PackIconMaterial Style="{StaticResource QueueIconStyle}" Kind="ImageOutline" />
                            </ui:Button>
                        </WrapPanel>
                    </Expander>
                    <StackPanel x:Name="ImageQueueReviewedCountText" Orientation="Horizontal" TextElement.Foreground="{DynamicResource SecondaryTextBrush}" TextElement.FontSize="11">
                        <TextBlock x:Name="ImageQueueReviewedCountCaption" Text="{Binding DataContext.LanguageViewModel[WpfImageQueue.Current.QualityReviewed.Badge], RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,4,0" />
                        <TextBlock x:Name="ImageQueueReviewedCountValueText" Text="{Binding DatasetReviewedImageCount, Mode=OneWay}" />
                        <TextBlock Text=" / " />
                        <TextBlock Text="{Binding DatasetImageCount, Mode=OneWay}" />
                        <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfImageQueue.Panel.ImageUnit], RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="LabelingQueueProgressFooter" Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrushDark}">
                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock x:Name="LabelingQueueCompletionText" Text="{Binding LabelingCompletionProgressText}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                        <TextBlock x:Name="LabelingQueueReviewText" Grid.Column="1" Text="{Binding LabelingReviewProgressText}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                    </Grid>
                    <Border Height="6" Margin="0,5,0,0" Background="{DynamicResource ProgressTrackBrush}" CornerRadius="3" ClipToBounds="True">
                        <Grid x:Name="LabelingQueueProgressBar"><Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding LabelingReviewedProgressWidth}" /><ColumnDefinition Width="{Binding LabelingCompletedProgressWidth}" /><ColumnDefinition Width="{Binding LabelingRemainingProgressWidth}" />
                        </Grid.ColumnDefinitions><Border Grid.Column="0" Background="{DynamicResource SuccessBrush}" /><Border Grid.Column="1" Background="{DynamicResource AccentBrush}" /></Grid>
                    </Border>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Padding="12,8" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderBrushDark}" Visibility="{Binding IsInferencePresentation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding InferenceQueueSummaryText}" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" /></Border>
        </Grid>
    </Border>
</UserControl>
