<UserControl x:Class="MvcVisionSystem.WpfImageQueuePanel"
             x:Name="ImageQueueRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm">
    <UserControl.Resources>
        <Style x:Key="QueueRowTextStyle" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueEditingVisibilityStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueInferenceVisibilityStyle" TargetType="FrameworkElement" BasedOn="{StaticResource QueueEditingVisibilityStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="QueueIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="QueueIconButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Template" Value="{DynamicResource WpfUiDarkButtonTemplate}" />
            <Setter Property="Width" Value="40" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QueuePrimaryActionButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Template" Value="{DynamicResource WpfUiDarkButtonTemplate}" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                    <Setter Property="Opacity" Value="0.55" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SelectedQueueImagePathToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Focusable" Value="True" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DataContext.LanguageViewModel[WpfImageQueue.Path.Details], RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="ToolTip" Value="{Binding DataContext.LanguageViewModel[WpfImageQueue.Path.Details], RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="PathToggleChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PathToggleChrome" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                <Setter TargetName="PathToggleChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PathToggleChrome" Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                                <Setter TargetName="PathToggleChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="PathToggleChrome" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="PathToggleChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=IsSelected}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QueueFilterChipItemStyle" TargetType="ListBoxItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="QueueFilterChipChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="12" SnapsToDevicePixels="True">
                                <ContentPresenter x:Name="QueueFilterChipCaption" Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="QueueFilterChipFocusCue" BorderBrush="Transparent" BorderThickness="2"
                                    CornerRadius="12" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="QueueFilterChipFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="QueueFilterChipFocusCue" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QueueQuickFilterButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Template" Value="{DynamicResource WpfUiDarkButtonTemplate}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Margin" Value="0,0,5,5" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImageQueueCurrentTaskCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,4" />
            <Setter Property="Margin" Value="0,3,0,5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="NeedsLabel">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Candidate">
                    <Setter Property="BorderBrush" Value="#FFC857" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Requested">
                    <Setter Property="BorderBrush" Value="#4EA1FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Failed">
                    <Setter Property="BorderBrush" Value="#FF5A5F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Saved">
                    <Setter Property="BorderBrush" Value="#57C785" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImageQueueCurrentTaskBadgeStyle" TargetType="Border">
            <Setter Property="MinWidth" Value="42" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="#242B35" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="NeedsLabel">
                    <Setter Property="Background" Value="#3D1F25" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Candidate">
                    <Setter Property="Background" Value="#403316" />
                    <Setter Property="BorderBrush" Value="#FFC857" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Requested">
                    <Setter Property="Background" Value="#17314A" />
                    <Setter Property="BorderBrush" Value="#4EA1FF" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Failed">
                    <Setter Property="Background" Value="#3D1F25" />
                    <Setter Property="BorderBrush" Value="#FF5A5F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="Saved">
                    <Setter Property="Background" Value="#173B29" />
                    <Setter Property="BorderBrush" Value="#57C785" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImageQueueColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="5,4" />
        </Style>

        <ControlTemplate x:Key="DatasetQueueRowTemplate" TargetType="DataGridRow">
                <Border x:Name="DatasetQueueRowChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
                    <DataGridCellsPresenter />
                </Border>
        </ControlTemplate>
        <Style x:Key="ImageQueueRowStyle" TargetType="DataGridRow">
            <Setter Property="mvvm:EventCommandBehavior.EventName" Value="MouseLeftButtonUp" />
            <Setter Property="mvvm:EventCommandBehavior.Command" Value="{Binding DataContext.QueueExplicitOpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            <Setter Property="mvvm:EventCommandBehavior.CommandParameter" Value="{Binding}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </Trigger>
            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="MinHeight" Value="78" />
                <Setter Property="Margin" Value="8,0,8,6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="Template" Value="{StaticResource DatasetQueueRowTemplate}" />
            </DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
            </MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DatasetSelectedBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DatasetSelectedBorderBrush}" />
                <Setter Property="BorderThickness" Value="3,1,1,1" />
            </MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" /><Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource DatasetSelectedHoverBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeAccentBrush}" />
            </MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" /><Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" /></MultiDataTrigger.Conditions>
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
            </MultiDataTrigger></Style.Triggers>
        </Style>

        <Style x:Key="ImageQueueCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ImageQueueTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="{Binding LocalizedQueueRowToolTip}" />
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="SelectedQueueImagePathDetailsTemplate">
            <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                    HorizontalAlignment="Left"
                    Padding="6,0,6,5">
                <TextBox x:Name="SelectedQueueImagePathBox"
                         Text="{Binding ImagePath, Mode=OneWay}"
                         AutomationProperties.Name="{Binding FileName}"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         TextWrapping="Wrap"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         MaxHeight="96"
                         Padding="6,4"
                         FontFamily="{DynamicResource UiFontFamily}"
                         FontSize="11"
                         Background="{DynamicResource InputBrush}"
                         Foreground="{DynamicResource PrimaryTextBrush}"
                         BorderBrush="{DynamicResource InputBorderBrush}"
                         SelectionBrush="{DynamicResource SelectedRowBrush}"
                         SelectionTextBrush="{DynamicResource SelectedRowTextBrush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SelectedQueueImagePathOnDemandDetailsTemplate">
            <Border Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType={x:Type ScrollViewer}}}"
                    HorizontalAlignment="Left"
                    Padding="6,0,6,5"
                    Visibility="{Binding DataContext.IsSelectedImagePathVisible, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Expander x:Name="SelectedQueueImagePathExpander"
                          Header="{Binding DataContext.LanguageViewModel[WpfImageQueue.Path.Details], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          IsExpanded="{Binding DataContext.IsSelectedImagePathVisible, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}, Mode=TwoWay}"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          FontFamily="{DynamicResource UiFontFamily}"
                          FontSize="11"
                          AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfImageQueue.Path.Details], RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <TextBox x:Name="SelectedQueueImagePathBox"
                             Text="{Binding ImagePath, Mode=OneWay}"
                             AutomationProperties.Name="{Binding FileName}"
                             IsReadOnly="True"
                             IsReadOnlyCaretVisible="True"
                             TextWrapping="Wrap"
                             HorizontalScrollBarVisibility="Disabled"
                             VerticalScrollBarVisibility="Auto"
                             MaxHeight="96"
                             Padding="6,4"
                             FontFamily="{DynamicResource UiFontFamily}"
                             FontSize="11"
                             Background="{DynamicResource InputBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             SelectionBrush="{DynamicResource SelectedRowBrush}"
                             SelectionTextBrush="{DynamicResource SelectedRowTextBrush}" />
                </Expander>
            </Border>
        </DataTemplate>

        <Style x:Key="ImageQueueFilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="7,0,24,0" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text}"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontFamily="{DynamicResource UiFontFamily}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="Padding" Value="7,4" />
                        <Setter Property="MinHeight" Value="24" />
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid SnapsToDevicePixels="True">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3" />
                            <TextBlock Text="{Binding SelectedItem.Text, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Margin="{TemplateBinding Padding}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       IsHitTestVisible="False" />
                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                      Width="8"
                                      Height="4"
                                      Stretch="Fill"
                                      Fill="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,8,0" />
                            </ToggleButton>
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QueueRowFileNameStyle" TargetType="TextBlock" BasedOn="{StaticResource QueueRowTextStyle}">
            <Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
