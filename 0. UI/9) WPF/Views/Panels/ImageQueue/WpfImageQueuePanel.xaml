                                    <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsInferenceStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"><Setter Property="TextElement.FontSize" Value="12" /><Setter Property="TextElement.Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
