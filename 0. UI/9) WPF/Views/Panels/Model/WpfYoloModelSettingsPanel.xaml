<UserControl x:Class="MvcVisionSystem.WpfYoloModelSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="YoloSectionVisibility" />
            <local:RuntimeDetailTextConverter x:Key="RuntimeDetailText" />
            <Style x:Key="YoloIntegratedEditorStyle" TargetType="Expander" BasedOn="{StaticResource DatasetExpanderStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><ContentPresenter Content="{TemplateBinding Content}" /></ControlTemplate></Setter.Value></Setter>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Expander" BasedOn="{StaticResource DatasetExpanderStyle}" />
            <Style TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="LineHeight" Value="18.85" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></DataTrigger></Style.Triggers></Style>
            <Style TargetType="AccessText">
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="YoloModelLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,6,8,0" />
                <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="Normal" /><Setter Property="Margin" Value="0,0,0,4" /><Setter Property="LineHeight" Value="17.4" /><Setter Property="LineStackingStrategy" Value="BlockLineHeight" /></DataTrigger></Style.Triggers></Style>

            <Style x:Key="YoloModelTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
                <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                <Setter Property="Margin" Value="0,5,0,0" />
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                    </Trigger>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    </Trigger>
                <DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="8,5" /><Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" /></DataTrigger></Style.Triggers>
            </Style>

            <Style x:Key="YoloAnomalyFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource YoloModelLabelStyle}">
                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="Margin" Value="0" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"/><Condition Binding="{Binding SettingsSection, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="2"/></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}"/><Setter Property="LineHeight" Value="17.4"/><Setter Property="LineStackingStrategy" Value="BlockLineHeight"/><Setter Property="Margin" Value="0,0,0,4"/></MultiDataTrigger></Style.Triggers></Style>
            <Style x:Key="YoloAnomalyClassInputStyle" TargetType="TextBox" BasedOn="{StaticResource YoloModelTextBoxStyle}">
                <Setter Property="MinHeight" Value="96" />
                <Setter Property="MaxHeight" Value="120" />
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="Padding" Value="10,8" />
                <Setter Property="Margin" Value="0,6,0,0" />
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"/><Condition Binding="{Binding SettingsSection, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="2"/></MultiDataTrigger.Conditions><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="30"/><Setter Property="MinHeight" Value="30"/><Setter Property="MaxHeight" Value="30"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="TextWrapping" Value="NoWrap"/><Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/><Setter Property="VerticalScrollBarVisibility" Value="Hidden"/><Setter Property="Padding" Value="8,5"/><Setter Property="Margin" Value="0"/></MultiDataTrigger></Style.Triggers></Style>
            <Style x:Key="YoloModelSaveButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipePrimaryButtonStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="Margin" Value="0,0,5,5" />
            </Style>

            <Style x:Key="YoloModelIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="YoloModelBrowseButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="MinWidth" Value="32" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="5,5,0,0" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Width" Value="30" /><Setter Property="MinWidth" Value="30" /><Setter Property="Margin" Value="4,0,0,0" /><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style>

            <Style x:Key="YoloModelCommandButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="Margin" Value="0,0,5,5" />
            </Style>

            <Style x:Key="YoloRuntimeProfileActionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="Margin" Value="0,0,5,5" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="MinWidth" Value="46" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="YoloModelComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="ItemTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="300" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    </Trigger>
                    <Trigger Property="Validation.HasError" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                    </Trigger>
                <DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="FontSize" Value="12" /><Setter Property="Height" Value="30" /><Setter Property="MinHeight" Value="30" /><Setter Property="Margin" Value="0" /><Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" /></DataTrigger></Style.Triggers>
            </Style>

            <SolidColorBrush x:Key="YoloRuntimeStatusBrush" Color="#93C5FD" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander x:Name="YoloModelSettingsExpander"
              AutomationProperties.AutomationId="YoloModelSettingsExpander"
              Header="&#xAC80;&#xC0AC;&#xC6A9; &#xBAA8;&#xB378; &#xC694;&#xC57D; / &#xC124;&#xC815;"
              Foreground="{DynamicResource RecipeTextBrush}"
             ><Expander.Style><Style TargetType="Expander" BasedOn="{StaticResource YoloIntegratedEditorStyle}"><Setter Property="Margin" Value="0,12,0,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers></Style></Expander.Style>
        <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Grid.Row="2" Grid.RowSpan="2" IsHitTestVisible="False" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"/><Condition Binding="{Binding ShowInspectionFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></Border.Style></Border><Border x:Name="YoloModelSettingsSummaryPanel"
                    AutomationProperties.AutomationId="YoloModelSettingsSummaryPanel"
                    Background="{DynamicResource RecipeSurfaceBrush}"
                    BorderBrush="{DynamicResource RecipeAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="8"
                    Margin="0,0,0,8" Grid.Row="0" Visibility="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="YoloModelSettingsSummaryTitleText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryTitleText"
                               Text="{Binding SettingsSummaryTitleText}"
                               Foreground="{DynamicResource RecipeTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="YoloModelSettingsSummaryModelText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryModelText"
                               Text="{Binding SettingsSummaryModelText}"
                               ToolTip="{Binding AppliedWeightsPath}"
                               Foreground="{DynamicResource RecipeTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="YoloModelSettingsSummaryRuntimeStatusText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryRuntimeStatusText"
                               Text="{Binding SettingsSummaryRuntimeStatusText}"
                               ToolTip="{Binding SettingsSummaryRuntimeStatusText}"
                               Foreground="{StaticResource YoloRuntimeStatusBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,3,0,0" />
                    <TextBlock x:Name="YoloModelSettingsSummaryRuntimeText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryRuntimeText"
                               Text="{Binding SettingsSummaryRuntimeText}"
                               Foreground="{DynamicResource RecipeMutedTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="YoloModelSettingsSummaryPathText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryPathText"
                               Text="{Binding SettingsSummaryPathText}"
                               Foreground="{DynamicResource RecipeMutedTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                    <TextBlock x:Name="YoloModelSettingsSummaryActionText"
                               AutomationProperties.AutomationId="YoloModelSettingsSummaryActionText"
                               Text="{Binding SettingsSummaryActionText}"
                               Foreground="{DynamicResource RecipeAccentBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0" />
                </StackPanel>
            </Border><Border x:Name="YoloInspectionModelQuickPanel" Visibility="{Binding ShowInspectionFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}"
                    AutomationProperties.AutomationId="YoloInspectionModelQuickPanel"
                    Background="{DynamicResource RecipeSurfaceBrush}"
                    BorderBrush="{DynamicResource RecipeBorderBrush}"
                    BorderThickness="1"


                    Grid.Row="1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="7" /><Setter Property="Margin" Value="0,0,0,8" /><Setter Property="CornerRadius" Value="7" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Padding" Value="14,12" /><Setter Property="Margin" Value="0,0,0,12" /><Setter Property="CornerRadius" Value="8" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel><Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><TextBlock Text="{Binding [WpfTrainingWorkspace.InspectionModel], Source={x:Static local:WpfLocalizationViewModel.Instance}}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource RecipeMutedTextBrush}" VerticalAlignment="Center" /><Border Grid.Column="1" HorizontalAlignment="Right" Padding="8,1" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" Background="{DynamicResource RecipeButtonBrush}"><TextBlock FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Text="{Binding TrainingWorkspace.InspectionModelBadgeText, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" ToolTip="{Binding AppliedWeightsPath}" /></Border></Grid><TextBlock x:Name="YoloEditingSummaryTitleText"
                               AutomationProperties.AutomationId="YoloEditingSummaryTitleText"
                               Text="{Binding EditingSummaryTitleText}"
                               Foreground="{DynamicResource RecipeTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"  TextWrapping="Wrap" ><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid Visibility="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Visibility="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}"
                               Text="{Binding [WpfModelSettings.Engine], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                               Style="{StaticResource YoloModelLabelStyle}"
                               Margin="0,6,8,0"  TextWrapping="Wrap" /><ComboBox Grid.Column="1" x:Name="YoloModelEngineQuickBox" Visibility="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}"
                              AutomationProperties.AutomationId="YoloModelEngineQuickBox"
                              AutomationProperties.Name="{Binding [WpfModelSettings.EditingEngine], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                              ItemsSource="{Binding ModelEngineOptions}"
                              SelectedItem="{Binding SelectedModelEngine, Mode=TwoWay}"
                              Margin="0,6,0,0"
                              Style="{StaticResource YoloModelComboBoxStyle}" /></Grid><StackPanel><TextBlock


                                TextWrapping="Wrap" ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource YoloModelLabelStyle}"><Setter Property="Text" Value="{Binding [WpfModelSettings.Weights], Source={x:Static local:WpfLocalizationViewModel.Instance}}" /><Setter Property="Margin" Value="0,0,8,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Text" Value="{Binding [WpfTrainingSettings.ModelFile], Source={x:Static local:WpfLocalizationViewModel.Instance}}" /><Setter Property="Margin" Value="0,0,0,4" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="YoloWeightsPathBox"
                             Style="{StaticResource YoloModelTextBoxStyle}"
                             Text="{Binding WeightsPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{Binding WeightsPath}"
                             Margin="0" /><ui:Button Grid.Column="1" x:Name="BrowseYoloWeightsButton"
                               Style="{StaticResource YoloModelBrowseButtonStyle}"
                               IsEnabled="{Binding IsBrowseWeightsEnabled}"
                               ToolTip="&#xAC80;&#xC0AC;&#xC5D0; &#xC0AC;&#xC6A9;&#xD560; &#xBAA8;&#xB378; &#xD30C;&#xC77C; &#xC120;&#xD0DD;"
                               Command="{Binding BrowseWeightsCommand}"
                               Margin="5,0,0,0">
                        <iconPacks:PackIconMaterial Style="{StaticResource YoloModelIconStyle}" Kind="DotsHorizontal" />
                    </ui:Button></Grid></StackPanel><TextBlock Text="{Binding [WpfTrainingSettings.ModelDesignationHint], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Margin="0,8,0,0" ><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
</Border><Expander x:Name="YoloAdvancedModelSettingsExpander" Style="{StaticResource YoloIntegratedEditorStyle}"
                      AutomationProperties.AutomationId="YoloAdvancedModelSettingsExpander"
                      Header="{Binding AdvancedSettingsHeaderText}"
                      Foreground="{DynamicResource RecipeTextBrush}"
                      Margin="0" Grid.Row="2">
                <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Margin" Value="0,8,0,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="0" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
<Border x:Name="YoloModelEnginePanel" Visibility="{Binding ShowRuntimeFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}" Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="14" /><Setter Property="CornerRadius" Value="7" /><Setter Property="Margin" Value="0,0,0,12" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Padding" Value="14,12" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Margin" Value="0,0,0,12" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding [WpfTrainingSettings.RuntimeConnection], Source={x:Static local:WpfLocalizationViewModel.Instance}}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource RecipeMutedTextBrush}" Margin="0,0,0,8" ><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="1"><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,16,12" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="0,0,6,12" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Text="{Binding [WpfModelSettings.Engine], Source={x:Static local:WpfLocalizationViewModel.Instance}}"

                                TextWrapping="Wrap" ><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource YoloModelLabelStyle}"><Setter Property="Margin" Value="0,0,8,0" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="0,0,0,4" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ComboBox x:Name="YoloModelEngineBox"
                              ItemsSource="{Binding ModelEngineOptions}"
                              SelectedItem="{Binding SelectedModelEngine, Mode=TwoWay}"
                              mvvm:InputCommandBehaviors.DropDownOpenedCommand="{Binding ModelEngineDropDownOpenedCommand}"
                              mvvm:InputCommandBehaviors.DropDownClosedCommand="{Binding ModelEngineDropDownClosedCommand}"
                              Style="{StaticResource YoloModelComboBoxStyle}" /><TextBlock x:Name="YoloModelEngineHintText"
                               Text="{Binding ModelEngineHintText}"
                               Foreground="{DynamicResource RecipeMutedTextBrush}"
                               FontFamily="{DynamicResource UiFontFamily}"
                               FontSize="13"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" ><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border><Border Grid.Column="1" Grid.Row="0" Grid.ColumnSpan="1"><Border.Style><Style TargetType="Border"><Setter Property="Margin" Value="0,0,0,12" /><Style.Triggers><DataTrigger Binding="{Binding ShowLegacyFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}}" Value="False"><Setter Property="Margin" Value="6,0,0,12" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><TextBlock Visibility="{Binding ShowRuntimeFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}" Text="{Binding [WpfModelSettings.Python], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource YoloModelLabelStyle}"  TextWrapping="Wrap" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Visibility="{Binding ShowRuntimeFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}" x:Name="YoloPythonPathBox"
                         Style="{StaticResource YoloModelTextBoxStyle}"
                         Text="{Binding PythonExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{Binding PythonExecutablePath}" /><ui:Button Grid.Column="1" x:Name="BrowseYoloPythonButton"
                           Visibility="{Binding ShowRuntimeFields, RelativeSource={RelativeSource AncestorType=local:WpfYoloModelSettingsPanel}, Converter={StaticResource YoloSectionVisibility}}"
