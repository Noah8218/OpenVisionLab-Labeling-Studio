<UserControl x:Class="MvcVisionSystem.WpfYoloStatusPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="YoloStatusIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="YoloStatusButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource DatasetExpanderStyle}" />
      </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="YoloStatusCard" Background="{DynamicResource RecipeSurfaceBrush}"
            BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
    <StackPanel>
        <TextBlock x:Name="YoloSettingsSummaryText"
                   Text="{Binding SummaryText}"
                   Foreground="{DynamicResource RecipeTextBrush}"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap" />
        <Expander x:Name="YoloRuntimeCommandsExpander"
                  AutomationProperties.AutomationId="YoloRuntimeCommandsExpander"
                  Header="&#xC2E4;&#xD589; &#xD658;&#xACBD; &#xAD00;&#xB9AC;"
                  IsExpanded="False"
                  Foreground="{DynamicResource RecipeTextBrush}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource RecipeBorderBrush}"
                  Margin="0,8,0,0">
        <WrapPanel Margin="0,6,0,0">
            <ui:Button x:Name="FirstCheckYoloButton"
                       Style="{StaticResource YoloStatusButtonStyle}"
                       IsEnabled="{Binding IsFirstCheckEnabled}"
                       MinWidth="106"
                       AutomationProperties.Name="&#xCCAB; &#xC810;&#xAC80;"
                       ToolTip="모델 실행 환경, 모델 파일, 이미지 경로를 점검합니다"
                       Command="{Binding CheckCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Style="{StaticResource YoloStatusIconStyle}" Kind="TestTube" />
                    <TextBlock Text="&#xCCAB; &#xC810;&#xAC80;" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="InstallRequirementsButton"
                       Style="{StaticResource YoloStatusButtonStyle}"
                       IsEnabled="{Binding IsInstallRequirementsEnabled}"
                       MinWidth="90"
                       AutomationProperties.Name="&#xC124;&#xCE58;"
                       ToolTip="누락된 실행 환경 패키지를 설치합니다"
                       Command="{Binding InstallRequirementsCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Style="{StaticResource YoloStatusIconStyle}" Kind="TrayArrowDown" />
                    <TextBlock Text="&#xC124;&#xCE58;" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="RunYoloSmokeButton"
                       Style="{StaticResource YoloStatusButtonStyle}"
                       IsEnabled="{Binding IsRunSmokeEnabled}"
                       MinWidth="78"
                       AutomationProperties.Name="&#xD14C;&#xC2A4;&#xD2B8;"
                       ToolTip="현재 설정으로 테스트 추론을 실행합니다"
                       Command="{Binding RunSmokeCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Style="{StaticResource YoloStatusIconStyle}" Kind="PlayCircleOutline" />
                    <TextBlock Text="&#xD14C;&#xC2A4;&#xD2B8;" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="RestartPythonWorkerButton"
                       Style="{StaticResource YoloStatusButtonStyle}"
                       IsEnabled="{Binding IsRestartWorkerEnabled}"
                       MinWidth="92"
                       AutomationProperties.Name="&#xC7AC;&#xC2DC;&#xC791;"
                       ToolTip="{Binding [WpfRuntimeLegacy.Restart.ToolTip], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                       Command="{Binding RestartWorkerCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Style="{StaticResource YoloStatusIconStyle}" Kind="CogRefreshOutline" />
                    <TextBlock Text="&#xC7AC;&#xC2DC;&#xC791;" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="StopPythonWorkerButton"
                       Style="{StaticResource YoloStatusButtonStyle}"
                       IsEnabled="{Binding IsStopWorkerEnabled}"
                       MinWidth="72"
                       AutomationProperties.Name="&#xC911;&#xC9C0;"
                       ToolTip="{Binding [WpfRuntimeLegacy.Stop.ToolTip], Source={x:Static local:WpfLocalizationViewModel.Instance}}"
                       Command="{Binding StopWorkerCommand}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Style="{StaticResource YoloStatusIconStyle}" Kind="StopCircleOutline" />
                    <TextBlock Text="&#xC911;&#xC9C0;" VerticalAlignment="Center" />
                </StackPanel>
            </ui:Button>
        </WrapPanel>
        </Expander>
        <TextBlock x:Name="YoloCommandStatusText"
                   Text="{Binding CommandStatusText}"
                   Foreground="{DynamicResource RecipeMutedTextBrush}"
                   FontFamily="{DynamicResource UiFontFamily}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,5,0,0" />
        <Border x:Name="YoloRecoveryPanel"
                Background="{DynamicResource RecipePageBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                BorderThickness="1"
                CornerRadius="7"
                Padding="12"
                Margin="0,7,0,0">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRecoveryVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <TextBlock x:Name="YoloRecoveryTitleText"
                           Text="{Binding RecoveryTitleText}"
                           Foreground="{DynamicResource RecipeTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="YoloRecoveryDetailText"
                           Text="{Binding RecoveryDetailText}"
                           Foreground="{DynamicResource RecipeMutedTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="13"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="YoloRecoveryActionText"
                           Text="{Binding RecoveryActionText}"
                           Foreground="{DynamicResource RecipeTextBrush}"
                           FontFamily="{DynamicResource UiFontFamily}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <ProgressBar x:Name="YoloCommandProgressBar"
                     Foreground="{DynamicResource RecipeAccentBrush}"
                     Background="{DynamicResource RecipePageBrush}"
                     Height="5"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding CommandProgressValue}"
                     Visibility="{Binding CommandProgressVisibility}"
                     IsIndeterminate="{Binding CommandProgressIsIndeterminate}"
                     Margin="0,5,0,0" />
        <Expander x:Name="YoloRuntimeDetailsExpander"
                  Header="실행 환경 상세"
                  IsExpanded="False"
                  Foreground="{DynamicResource RecipeTextBrush}"
                  Background="Transparent"
                  BorderBrush="{DynamicResource RecipeBorderBrush}"
                  Margin="0,8,0,0">
            <TextBlock x:Name="YoloSettingsDetailText"
                       Text="{Binding DetailText}"
                       Foreground="{DynamicResource RecipeMutedTextBrush}"
                       FontFamily="Consolas"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,0" />
        </Expander>
    </StackPanel>
    </Border>
</UserControl>
