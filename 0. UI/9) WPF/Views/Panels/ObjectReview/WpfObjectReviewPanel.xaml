                                      Style="{StaticResource ObjectReviewEditClassBoxStyle}"
                                      ItemsSource="{Binding DataContext.ClassNames, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}"
                                      SelectedItem="{Binding SelectedClassName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding IsInlineEditEnabled}" />
                            <TextBlock Grid.Column="2" Text="{Binding ObjectKindText}" FontSize="11" Foreground="{DynamicResource RecipeMutedTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <ui:Button x:Name="ObjectRowHiddenButton" Grid.Column="3" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                                       AutomationProperties.AutomationId="ObjectRowHiddenButton"
