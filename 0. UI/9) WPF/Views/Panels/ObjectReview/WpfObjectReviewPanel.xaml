<UserControl x:Class="MvcVisionSystem.WpfObjectReviewPanel"
             x:Name="ObjectReviewRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
            <ResourceDictionary Source="../CandidateReview/CandidateReviewResources.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:ObjectReviewClassDisplayConverter x:Key="ObjectReviewClassDisplayConverter" />

        <Style x:Key="ObjectReviewClassListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding CanonicalDisplayText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="ClassChoiceChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5.5" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="ClassChoiceFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ClassChoiceFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ClassChoiceFocusCue" Property="BorderBrush" Value="Transparent" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions><Condition Property="IsSelected" Value="True" /><Condition Property="IsMouseOver" Value="True" /></MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource RecipeSelectedHoverBrush}" />
                </MultiTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewObjectListBoxItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource ObjectReviewClassListBoxItemStyle}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="AutomationProperties.Name" Value="{Binding DisplayText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="ObjectRowFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ObjectRowFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMetadataFilterMatch}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Padding" Value="8,5"/></MultiDataTrigger>
                <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding IsEnabled}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ObjectReviewEditActionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeButtonBaseStyle}">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="ObjectReviewSessionButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeQuietButtonStyle}">
            <Setter Property="MinWidth" Value="30" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True" />
                        <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsMouseOver}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource RecipeSelectedHoverBrush}" />
                </MultiDataTrigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeButtonPressedBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ObjectReviewEditClassBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
            <Style.Resources>
                <Style TargetType="ToggleButton" BasedOn="{StaticResource RecipeButtonBaseStyle}">
                    <Setter Property="FontSize" Value="{Binding FontSize, RelativeSource={RelativeSource TemplatedParent}}" />
                </Style>
            </Style.Resources>
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock TextWrapping="Wrap" MaxWidth="180">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource ObjectReviewClassDisplayConverter}" Mode="OneWay">
                                    <Binding />
                                    <Binding Source="{StaticResource ObjectReviewClassDisplayConverter}" Path="Classes" />
                                    <Binding Source="{StaticResource ObjectReviewClassDisplayConverter}" Path="Revision" />
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ObjectReviewHistoryListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter /></Border></ControlTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource RecipeSelectedBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewButtonStyle" TargetType="{x:Type ui:Button}">
            <Setter Property="Template" Value="{DynamicResource WpfUiDarkButtonTemplate}" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushDark}" />
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewQualityButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource ObjectReviewButtonStyle}">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewStateButtonStyle"
               TargetType="{x:Type ui:Button}"
               BasedOn="{StaticResource ObjectReviewButtonStyle}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="34" />
            <Setter Property="Padding" Value="5,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewStateIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="15" />
            <Setter Property="Height" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="ObjectReviewComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="MaxDropDownHeight" Value="220" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="Padding" Value="6,3" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid MinWidth="{TemplateBinding ActualWidth}">
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          HorizontalAlignment="Stretch"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="2">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="6,2,24,2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left" />
                                    <Path Data="M 0 0 L 4 4 L 8 0 Z"
                                          Width="8"
                                          Height="4"
                                          Stretch="Fill"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                </Grid>
                            </ToggleButton>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource InputBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#202833" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#202833" />
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#334052" />
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F4F7FB" />
            </Style.Resources>
        </Style>

        <Style x:Key="ObjectReviewListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource RowHoverBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource SelectedRowTextBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMetadataFilterMatch}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewMergeCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource RecipeCheckBoxStyle}">
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="ToolTip" Value="&#xC138;&#xADF8;&#xBA3C;&#xD2B8; &#xBCD1;&#xD569; &#xB300;&#xC0C1; &#xC120;&#xD0DD;" />
            <Setter Property="AutomationProperties.Name" Value="&#xC138;&#xADF8;&#xBA3C;&#xD2B8; &#xBCD1;&#xD569; &#xC120;&#xD0DD;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMergeSelectionVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                        <Condition Binding="{Binding DataContext.IsSegmentAdvancedEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                        <Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False" />
                        <Condition Binding="{Binding IsExpanded, ElementName=ObjectReviewSecondaryEditor}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewGroupCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="ToolTip" Value="&#xAC80;&#xC218; &#xADF8;&#xB8F9; &#xAD6C;&#xC131;&#xC6D0; &#xC120;&#xD0DD;" />
            <Setter Property="AutomationProperties.Name" Value="&#xAC80;&#xC218; &#xADF8;&#xB8F9; &#xC120;&#xD0DD;" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupSelectionVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ObjectReviewLabelSaveBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#1A2736" />
            <Setter Property="BorderBrush" Value="#46515F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding LabelSaveStateKey}" Value="Dirty">
                    <Setter Property="Background" Value="#3D2517" />
                    <Setter Property="BorderBrush" Value="#F5A623" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LabelSaveStateKey}" Value="Saved">
                    <Setter Property="Background" Value="#173B29" />
                    <Setter Property="BorderBrush" Value="#57C785" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LabelSaveStateKey}" Value="SaveError">
                    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer x:Name="ObjectReviewScrollViewer"
                  AutomationProperties.AutomationId="ObjectReviewScrollViewer"
                  Margin="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="True"
                  Focusable="False">
    <ScrollViewer.Style><Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}"><Style.Triggers>
        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Template"><Setter.Value>
            <!-- Preserve the pinned UiScrollViewer parts and bindings; reserve its existing scrollbar row/column in this inspector. -->
            <ControlTemplate TargetType="ScrollViewer">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Grid.Column="0" Margin="{TemplateBinding Padding}"><ScrollContentPresenter CanContentScroll="{TemplateBinding CanContentScroll}"/></Grid>
                    <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Row="0" Grid.Column="1" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Value="{TemplateBinding VerticalOffset}"/>
                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Row="1" Grid.Column="0" Maximum="{TemplateBinding ScrollableWidth}" Orientation="Horizontal" ViewportSize="{TemplateBinding ViewportWidth}" Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Value="{TemplateBinding HorizontalOffset}"/>
                </Grid>
            </ControlTemplate>
        </Setter.Value></Setter></MultiDataTrigger>
    </Style.Triggers></Style></ScrollViewer.Style>
    <Grid><Grid.Style><Style TargetType="Grid"><Setter Property="Margin" Value="8"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyGridActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="Margin" Value="0"/></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="ObjectReviewReferenceClassPanel"
                AutomationProperties.AutomationId="ObjectReviewReferenceClassPanel"
                Background="Transparent"
                BorderBrush="{DynamicResource RecipeBorderBrush}"

                CornerRadius="6"

               ><Border.Style><Style TargetType="Border"><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyGridActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding IsLabelingModeActive}" Value="True"/><Condition Binding="{Binding SelectedObject}" Value="{x:Null}"/></MultiDataTrigger.Conditions><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="BorderThickness" Value="0"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyGridActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding DataContext.CanvasPanelViewModel.SelectedAnnotationTool.Tool, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Static local:WpfAnnotationTool.Rectangle}"/></MultiDataTrigger.Conditions><Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="BorderThickness" Value="0,0,0,1"/></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel>
                <Border Background="#3D1E22" BorderBrush="#73343A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12"
                        Visibility="{Binding IsQualityNeedsFixActive, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="ImageReviewRejectionBanner">
                    <StackPanel>
                        <TextBlock Text="{Binding QualityReviewStatusText}" FontSize="13" FontWeight="SemiBold" Foreground="#FFB3B3" />
