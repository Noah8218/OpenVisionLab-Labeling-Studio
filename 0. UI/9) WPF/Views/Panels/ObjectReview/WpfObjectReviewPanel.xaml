                                       AutomationProperties.AutomationId="CancelSplitButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0,0,0"
                                       Padding="7,0"
                                       Content="&#xCDE8;&#xC18C;"
                                       ToolTip="&#xC808;&#xB2E8; &#xC704;&#xCE58; &#xC120;&#xD0DD; &#xCDE8;&#xC18C;"
                                       Visibility="{Binding IsSplitPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding CancelSplitCommand}" />
                        </Grid>
                        <TextBlock x:Name="SplitStatusText"
                                   AutomationProperties.AutomationId="SplitStatusText"
                                   Text="{Binding SplitStatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9.5"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding IsSplitPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="BeginAddHoleButton"
                                       AutomationProperties.AutomationId="BeginAddHoleButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="0,0,3,0"
                                       Content="&#xAD6C;&#xBA4D; &#xCD94;&#xAC00;"
                                       ToolTip="&#xC120;&#xD0DD;&#xD55C; &#xC138;&#xADF8;&#xBA3C;&#xD2B8; &#xC548;&#xCABD;&#xC5D0; &#xAD6C;&#xBA4D; &#xCD94;&#xAC00;"
                                       IsEnabled="{Binding IsHoleEditEnabled}"
                                       Command="{Binding BeginAddHoleCommand}" />
                            <ui:Button x:Name="BeginRemoveHoleButton"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="BeginRemoveHoleButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0"
                                       Content="&#xAD6C;&#xBA4D; &#xCC44;&#xC6B0;&#xAE30;"
                                       ToolTip="&#xBE48; &#xB0B4;&#xBD80; &#xAD6C;&#xBA4D;&#xC744; &#xD074;&#xB9AD;&#xD574; &#xCC44;&#xC6B0;&#xAE30;"
                                       IsEnabled="{Binding IsHoleEditEnabled}"
                                       Command="{Binding BeginRemoveHoleCommand}" />
                            <ui:Button x:Name="CancelHoleEditButton"
                                       Grid.Column="2"
                                       AutomationProperties.AutomationId="CancelHoleEditButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0,0,0"
                                       Padding="7,0"
                                       Content="&#xCDE8;&#xC18C;"
                                       Visibility="{Binding IsHoleEditPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding CancelHoleEditCommand}" />
                        </Grid>
                        <TextBlock x:Name="HoleEditStatusText"
                                   AutomationProperties.AutomationId="HoleEditStatusText"
                                   Text="{Binding HoleEditStatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9.5"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding IsHoleEditPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="SendSegmentationToBackButton"
                                       AutomationProperties.AutomationId="SendSegmentationToBackButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="0,0,3,0"
                                       Content="&#xB9E8; &#xB4A4;"
                                       ToolTip="&#xAC00;&#xC7A5; &#xB4A4;&#xB85C; &#xC774;&#xB3D9;"
                                       IsEnabled="{Binding IsSendToBackEnabled}"
                                       Command="{Binding SendToBackCommand}" />
                            <ui:Button x:Name="SendSegmentationBackwardButton"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="SendSegmentationBackwardButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0"
                                       Content="&#xD55C; &#xCE78; &#xB4A4;"
                                       ToolTip="&#xD55C; &#xB2E8;&#xACC4; &#xB4A4;&#xB85C; &#xC774;&#xB3D9;"
                                       IsEnabled="{Binding IsSendBackwardEnabled}"
                                       Command="{Binding SendBackwardCommand}" />
                            <ui:Button x:Name="BringSegmentationForwardButton"
                                       Grid.Column="2"
                                       AutomationProperties.AutomationId="BringSegmentationForwardButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0"
                                       Content="&#xD55C; &#xCE78; &#xC55E;"
                                       ToolTip="&#xD55C; &#xB2E8;&#xACC4; &#xC55E;&#xC73C;&#xB85C; &#xC774;&#xB3D9;"
                                       IsEnabled="{Binding IsBringForwardEnabled}"
                                       Command="{Binding BringForwardCommand}" />
                            <ui:Button x:Name="BringSegmentationToFrontButton"
                                       Grid.Column="3"
                                       AutomationProperties.AutomationId="BringSegmentationToFrontButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0,0,0"
                                       Content="&#xB9E8; &#xC55E;"
                                       ToolTip="&#xAC00;&#xC7A5; &#xC55E;&#xC73C;&#xB85C; &#xC774;&#xB3D9;"
                                       IsEnabled="{Binding IsBringToFrontEnabled}"
                                       Command="{Binding BringToFrontCommand}" />
                        </Grid>
                        <TextBlock x:Name="ZOrderStatusText"
                                   AutomationProperties.AutomationId="ZOrderStatusText"
                                   Text="{Binding ZOrderStatusText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9.5"
                                   Margin="0,3,0,0"
                                   TextWrapping="Wrap" />
                        <Grid Margin="0,5,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:Button x:Name="PreviewRemoveUnderlyingButton"
                                       AutomationProperties.AutomationId="PreviewRemoveUnderlyingButton"
                                       Height="24"
                                       Margin="0,0,3,0"
                                       Content="&#xACB9;&#xCE68; &#xBD84;&#xC11D;"
                                       ToolTip="&#xB4A4;&#xCABD; &#xACB9;&#xCE68; &#xC81C;&#xAC70; &#xC601;&#xD5A5; &#xBBF8;&#xB9AC;&#xBCF4;&#xAE30;"
                                       IsEnabled="{Binding IsRemoveUnderlyingPreviewEnabled}"
                                       Command="{Binding PreviewRemoveUnderlyingCommand}">
                                <ui:Button.Style>
                                    <Style TargetType="{x:Type ui:Button}"
                                           BasedOn="{StaticResource ObjectReviewButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRemoveUnderlyingPreviewPending}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:Button.Style>
                            </ui:Button>
                            <ui:Button x:Name="ApplyRemoveUnderlyingButton"
                                       Grid.Column="1"
                                       AutomationProperties.AutomationId="ApplyRemoveUnderlyingButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0"
                                       Content="&#xD655;&#xC778; &#xD6C4; &#xC81C;&#xAC70;"
                                       Visibility="{Binding IsRemoveUnderlyingPreviewPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding ApplyRemoveUnderlyingCommand}" />
                            <ui:Button x:Name="CancelRemoveUnderlyingButton"
                                       Grid.Column="2"
                                       AutomationProperties.AutomationId="CancelRemoveUnderlyingButton"
                                       Style="{StaticResource ObjectReviewButtonStyle}"
                                       Height="24"
                                       Margin="3,0,0,0"
                                       Content="&#xCDE8;&#xC18C;"
                                       Visibility="{Binding IsRemoveUnderlyingPreviewPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Command="{Binding CancelRemoveUnderlyingCommand}" />
                        </Grid>
                        <TextBlock x:Name="RemoveUnderlyingStatusText"
                                   AutomationProperties.AutomationId="RemoveUnderlyingStatusText"
                                   Text="{Binding RemoveUnderlyingStatusText}"
                                   Foreground="#F59E0B"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding IsRemoveUnderlyingPreviewPending, Converter={StaticResource BooleanToVisibilityConverter}}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <ListBox x:Name="ObjectListBox"
                 AutomationProperties.AutomationId="ObjectListBox"
                 Grid.Row="3"
                 Background="Transparent"
                 BorderThickness="0"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 ItemsSource="{Binding Objects}"
                 SelectedItem="{Binding SelectedObject, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource ObjectReviewListBoxItemStyle}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 mvvm:InputCommandBehaviors.SelectedItemChangedCommand="{Binding ObjectSelectionChangedCommand}"
                 mvvm:InputCommandBehaviors.PreviewKeyInputCommand="{Binding ObjectPreviewKeyDownCommand}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource ObjectReviewGroupCheckBoxStyle}"
                                  IsChecked="{Binding IsGroupSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanGroupSelect}"
                                  Command="{Binding DataContext.GroupSelectionChangedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  CommandParameter="{Binding}" />
                        <CheckBox Grid.Column="1"
                                  Style="{StaticResource ObjectReviewMergeCheckBoxStyle}"
                                  IsChecked="{Binding IsMergeSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding CanMergeSelect}"
                                  Command="{Binding DataContext.MergeSelectionChangedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                  CommandParameter="{Binding}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding DisplayText}"
                                   ToolTip="{Binding ToolTip}"
                                   Opacity="{Binding ContentOpacity}"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <TextBlock Grid.Column="3"
                                   Text="{Binding StateBadgeText}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
