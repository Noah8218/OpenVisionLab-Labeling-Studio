                                       ToolTip="{Binding ObjectSessionStateText}" Style="{StaticResource ObjectReviewSessionButtonStyle}" Tag="{Binding IsHidden}"
                                       IsEnabled="{Binding SupportsSessionState}" CommandParameter="{Binding}"
                                       Command="{Binding DataContext.ToggleRowHiddenCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}">
                                <iconPacks:PackIconMaterial Width="14" Height="14"><iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Kind" Value="EyeOutline" /><Style.Triggers><DataTrigger Binding="{Binding IsHidden}" Value="True"><Setter Property="Kind" Value="EyeOffOutline" /></DataTrigger></Style.Triggers></Style></iconPacks:PackIconMaterial.Style></iconPacks:PackIconMaterial>
                            </ui:Button>
                            <ui:Button x:Name="ObjectRowLockedButton" Grid.Column="4" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0" Margin="4,0,0,0"
                                       AutomationProperties.AutomationId="ObjectRowLockedButton"
                                       AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfObjectReview.Row.Lock], RelativeSource={RelativeSource AncestorType=Window}}"
                                       ToolTip="{Binding ObjectSessionStateText}" Style="{StaticResource ObjectReviewSessionButtonStyle}" Tag="{Binding IsLocked}"
                                       IsEnabled="{Binding SupportsSessionState}" CommandParameter="{Binding}"
                                       Command="{Binding DataContext.ToggleRowLockedCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}">
                                <iconPacks:PackIconMaterial Width="14" Height="14"><iconPacks:PackIconMaterial.Style><Style TargetType="iconPacks:PackIconMaterial"><Setter Property="Kind" Value="LockOpenOutline" /><Style.Triggers><DataTrigger Binding="{Binding IsLocked}" Value="True"><Setter Property="Kind" Value="LockOutline" /></DataTrigger></Style.Triggers></Style></iconPacks:PackIconMaterial.Style></iconPacks:PackIconMaterial>
                            </ui:Button>
                            <ui:Button x:Name="ObjectRowDeleteButton" Grid.Column="5" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0" Margin="4,0,0,0"
                                       AutomationProperties.AutomationId="ObjectRowDeleteButton"
                                       AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfObjectReview.Row.Delete], RelativeSource={RelativeSource AncestorType=Window}}"
                                       ToolTip="{Binding DataContext.LanguageViewModel[WpfObjectReview.Row.Delete.Hint], RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource RecipeQuietButtonStyle}" IsEnabled="{Binding IsInlineEditEnabled}" CommandParameter="{Binding}"
                                       Command="{Binding DataContext.DeleteRowCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}">
                                <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" />
                            </ui:Button>
                        </Grid>
                        <StackPanel x:Name="ObjectRowStateDetails" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding StateBadgeText}" Value="" />
                                                <Condition Binding="{Binding IsGroupSelectionVisible}" Value="False" />
                                                <Condition Binding="{Binding IsMergeSelectionVisible}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding MetadataBadgeText}" Value=""/><Condition Binding="{Binding IsGroupSelectionVisible}" Value="False"/><Condition Binding="{Binding IsMergeSelectionVisible}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding MetadataBadgeText}" Value=""/><Condition Binding="{Binding IsGroupSelectionVisible}" Value="False"/><Condition Binding="{Binding DataContext.IsSegmentAdvancedEditorOpen, RelativeSource={RelativeSource AncestorType={x:Type local:WpfObjectReviewPanel}}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/><Condition Binding="{Binding MetadataBadgeText}" Value=""/><Condition Binding="{Binding IsGroupSelectionVisible}" Value="False"/><Condition Binding="{Binding IsExpanded, ElementName=ObjectReviewSecondaryEditor}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed"/></MultiDataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <CheckBox Style="{StaticResource ObjectReviewGroupCheckBoxStyle}" IsChecked="{Binding IsGroupSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanGroupSelect}" Command="{Binding DataContext.GroupSelectionChangedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                            <CheckBox Style="{StaticResource ObjectReviewMergeCheckBoxStyle}" IsChecked="{Binding IsMergeSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanMergeSelect}" Command="{Binding DataContext.MergeSelectionChangedCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" />
                            <TextBlock x:Name="ObjectRowStateBadgeText" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.Name="{Binding StateBadgeText}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="{Binding StateBadgeText, Mode=OneWay}"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Text" Value="{Binding MetadataBadgeText, Mode=OneWay}"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <ListBox x:Name="InlineCandidateListBox" DataContext="{Binding CandidateReviewViewModel, ElementName=ObjectReviewRoot}"
                 AutomationProperties.AutomationId="InlineCandidateListBox"
                 Visibility="{Binding CandidateInteractionVisibility, FallbackValue=Collapsed, TargetNullValue=Collapsed}" ItemsSource="{Binding Candidates}" SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource RecipeTextBrush}" FontFamily="{DynamicResource UiFontFamily}" FontSize="12"
                 HorizontalContentAlignment="Stretch" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 mvvm:InputCommandBehaviors.SelectedItemChangedCommand="{Binding CandidateSelectionChangedCommand}"
                 mvvm:InputCommandBehaviors.PreviewKeyInputCommand="{Binding CandidatePreviewKeyDownCommand}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource ObjectReviewClassListBoxItemStyle}">
                    <Setter Property="Padding" Value="4" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="BorderBrush" Value="#59647A" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Rectangle Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1" StrokeDashArray="3,3" RadiusX="6" RadiusY="6" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="InlineCandidateFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InlineCandidateFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Setter.Value></Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate><DataTemplate>
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Inline.Filtered]}" TextWrapping="Wrap" Foreground="{DynamicResource RecipeMutedTextBrush}">
                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEnabled}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                    <Grid Visibility="{Binding IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border x:Name="InlineCandidateClassSwatch" Width="12" Height="12" CornerRadius="3" Background="{Binding ClassBrush}" Opacity="0.6" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Margin="4,0" VerticalAlignment="Center">
                            <Run Text="{Binding ClassName, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding InlineConfidenceText, Mode=OneWay}" Foreground="{DynamicResource RecipeMutedTextBrush}" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" FontSize="11" Foreground="{DynamicResource RecipeMutedTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center">
                            <TextBlock.Style><Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Inline.Source]}" />
                                <Style.Triggers><DataTrigger Binding="{Binding IsSmartMaskCandidate}" Value="True"><Setter Property="Text" Value="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Inline.SmartMask]}" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                        </TextBlock>
                        <ui:Button x:Name="InlineConfirmCandidateButton" Grid.Column="3" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0"
                                   AutomationProperties.AutomationId="InlineConfirmCandidateButton"
                                   AutomationProperties.Name="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.ConfirmSelected.Save]}"
                                   ToolTip="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Draft.ConfirmSelectedHint]}"
                                   Style="{StaticResource ObjectReviewSessionButtonStyle}" IsEnabled="{Binding IsInlineConfirmEnabled}"
                                   Command="{Binding DataContext.ConfirmRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                            <iconPacks:PackIconMaterial Kind="Check" Width="14" Height="14" />
                        </ui:Button>
                        <Border Grid.Column="4" Width="22" Margin="4,0,0,0" />
                        <ui:Button x:Name="InlineSkipCandidateButton" Grid.Column="5" Width="22" Height="22" MinWidth="22" MinHeight="22" Padding="0" Margin="4,0,0,0"
                                   AutomationProperties.AutomationId="InlineSkipCandidateButton"
                                   AutomationProperties.Name="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Skip.Hide]}"
                                   ToolTip="{Binding Source={x:Static local:WpfLocalizationViewModel.Instance}, Path=[WpfCandidate.Inline.SkipHint]}"
                                   Style="{StaticResource ObjectReviewSessionButtonStyle}" IsEnabled="{Binding IsInlineSkipEnabled}"
                                   Command="{Binding DataContext.SkipRowCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                            <iconPacks:PackIconMaterial Kind="Close" Width="14" Height="14" />
                        </ui:Button>
                    </Grid>
                </StackPanel>
            </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
        </StackPanel>
        <StackPanel Grid.Row="3">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Margin" Value="0,8,0,8" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                                <Condition Binding="{Binding DataContext.ShellViewModel.IsAnnotationWorkflowVisible, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                        <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Margin" Value="14,8"/></MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <ContentControl x:Name="InlineLabelSuspicionReview" AutomationProperties.AutomationId="InlineLabelSuspicionReview"
                            Content="{Binding CandidateReviewViewModel, ElementName=ObjectReviewRoot}"
                            ContentTemplate="{StaticResource LabelSuspicionReviewTemplate}" HorizontalContentAlignment="Stretch"
                            Visibility="{Binding IsReviewModeActive, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.NoObject.Selection.Image], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                       Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
            <CheckBox x:Name="ObjectReviewNoObjectCheckBox" AutomationProperties.AutomationId="ObjectReviewNoObjectCheckBox"
                      AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.NoObject.Selection.Name], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                      IsChecked="{Binding DataContext.CanvasPanelViewModel.IsNoObjectSelected, RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      IsEnabled="{Binding DataContext.CanvasPanelViewModel.IsNoObjectSelectionEnabled, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                      ToolTip="{Binding DataContext.CanvasPanelViewModel.NoObjectSelectionToolTip, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                      ToolTipService.ShowOnDisabled="True" MinHeight="30" FontSize="13" FocusVisualStyle="{x:Null}">
                <CheckBox.Style>
                    <Style TargetType="CheckBox">
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </CheckBox.Style>
                <CheckBox.Template>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="15" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border x:Name="NoObjectCheckChrome" Width="15" Height="15" CornerRadius="3" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" VerticalAlignment="Center" />
                            <Path x:Name="NoObjectCheckMark" Data="M 3,7 L 6,10 L 12,3" Width="15" Height="15" Stroke="White" StrokeThickness="2" Visibility="Collapsed" VerticalAlignment="Center" />
                            <ContentPresenter Grid.Column="1" ContentSource="Content" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <Border x:Name="NoObjectCheckFocusCue" Grid.ColumnSpan="2" CornerRadius="6" BorderThickness="2" BorderBrush="Transparent" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NoObjectCheckChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" /><Setter TargetName="NoObjectCheckChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="NoObjectCheckMark" Property="Visibility" Value="Visible" /><Setter TargetName="NoObjectCheckChrome" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="NoObjectCheckChrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="NoObjectCheckChrome" Property="Background" Value="{DynamicResource RecipeButtonPressedBrush}" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NoObjectCheckFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter TargetName="NoObjectCheckChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter TargetName="NoObjectCheckMark" Property="Stroke" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter Property="Cursor" Value="Arrow" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </CheckBox.Template>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.NoObject.Selection.Name], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    <Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="3,0" Margin="6,0,0,0">
                        <TextBlock Text="X" FontFamily="Consolas" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /></Trigger></Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </CheckBox>
            <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.NoObject.Selection.Hint], RelativeSource={RelativeSource AncestorType={x:Type Window}}, Mode=OneWay, Converter={StaticResource CandidateReviewWordBoundaryConverter}}"
                       AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.NoObject.Selection.Hint], RelativeSource={RelativeSource AncestorType=Window}}"
                       Foreground="{DynamicResource RecipeDisabledTextBrush}" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" FontSize="12" TextWrapping="Wrap" />
            <TextBlock x:Name="ObjectReviewActiveImageSplitStatusText" FontSize="12" FontWeight="Normal" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="{DynamicResource RecipeDisabledTextBrush}" Margin="0,8,0,0">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem, RelativeSource={RelativeSource AncestorType=Window}}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                <Run Text="{Binding DataContext.LanguageViewModel[WpfLabeling.Image.Split], RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.DatasetSplitText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding DataContext.ImageQueueViewModel.ActiveQueueItem.DatasetReviewStatusText, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" />
            </TextBlock>
            <Border BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.PreviousLabels.Section], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Foreground="{DynamicResource SecondaryTextBrush}" FontFamily="{DynamicResource UiFontFamily}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ui:Button x:Name="ObjectReviewPreviousLabelsButton" AutomationProperties.AutomationId="ObjectReviewPreviousLabelsButton"
                               AutomationProperties.Name="{Binding DataContext.LanguageViewModel[WpfCanvas.PreviousLabels.Name], RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               Style="{StaticResource RecipeSecondaryButtonStyle}" MinHeight="24" Padding="8,2" FontSize="12" FontFamily="{DynamicResource UiFontFamily}"
                               HorizontalContentAlignment="Stretch"
                               Command="{Binding DataContext.CanvasPanelViewModel.ImportPreviousLabelsCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                               ToolTip="{Binding DataContext.LanguageViewModel[WpfCanvas.PreviousLabels.Hint], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" ToolTipService.ShowOnDisabled="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfCanvas.PreviousLabels.Name], RelativeSource={RelativeSource AncestorType={x:Type Window}}}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1,1,1,2" CornerRadius="4" Padding="3,0" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl+Shift+V" FontFamily="Consolas" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                            <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /></Trigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </ui:Button>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</UserControl>
