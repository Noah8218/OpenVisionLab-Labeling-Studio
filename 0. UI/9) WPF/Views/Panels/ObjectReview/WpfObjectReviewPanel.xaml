            <ListBox.Style><Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}"><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.ShellViewModel.IsLabelingStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ShellViewModel.IsSavedLabelsShortcutActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/><Condition Binding="{Binding DataContext.ImageQueueViewModel.IsAnomalyImageReviewMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Template" Value="{Binding Template, ElementName=ObjectReviewReferenceClassListBox}"/></MultiDataTrigger></Style.Triggers></Style></ListBox.Style>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" FontSize="12" AutomationProperties.Name="{Binding Text, RelativeSource={RelativeSource Self}}">
