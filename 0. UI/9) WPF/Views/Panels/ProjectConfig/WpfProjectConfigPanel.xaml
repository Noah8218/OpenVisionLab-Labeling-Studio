<UserControl x:Class="MvcVisionSystem.WpfProjectConfigPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="{DynamicResource UiFontFamily}" FontSize="13" UseLayoutRounding="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ProjectConfigLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="LineHeight" Value="17.4" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="ProjectConfigHeadingStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="ProjectConfigTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Background" Value="{DynamicResource InputBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProjectConfigComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="8,5,28,5" />
            <Setter Property="ItemTemplate">
                <Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left" /></DataTemplate></Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ProjectConfigButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ProjectConfigSaveButtonStyle" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource RecipePrimaryButtonStyle}">
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ProjectConfigIconStyle" TargetType="{x:Type iconPacks:PackIconMaterial}">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander x:Name="ProjectConfigExpander" Header="{Binding [WpfProjectConfig.Title], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource DatasetExpanderStyle}" IsExpanded="False" Margin="0,12,0,0">
        <StackPanel>
            <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock x:Name="ProjectRecipeSelectionTitleText" Text="{Binding [WpfProjectConfig.SelectionTitle], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigHeadingStyle}" />
                    <TextBlock Text="{Binding [WpfProjectConfig.RecipeName], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ProjectRecipeNameBox" Style="{StaticResource ProjectConfigTextBoxStyle}" IsReadOnly="False" Text="{Binding RecipeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding [WpfProjectConfig.RecipeName], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding RecipeName}" />
                        <ui:Button x:Name="ApplyProjectRecipeButton" Grid.Column="1" Style="{StaticResource ProjectConfigButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Top" IsEnabled="{Binding IsApplyRecipeEnabled}" AutomationProperties.Name="{Binding [WpfProjectConfig.Apply], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding [WpfProjectConfig.ApplyHint], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Command="{Binding ApplyRecipeCommand}">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Style="{StaticResource ProjectConfigIconStyle}" Kind="Check" /><TextBlock Text="{Binding [WpfProjectConfig.Apply], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" /></StackPanel>
                        </ui:Button>
                    </Grid>
                    <TextBlock Text="{Binding [WpfProjectConfig.SavedRecipes], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProjectRecipeListBox" Style="{StaticResource ProjectConfigComboBoxStyle}" ItemsSource="{Binding RecipeNames}" SelectedItem="{Binding SelectedRecipeName, Mode=TwoWay}" mvvm:InputCommandBehaviors.SelectedItemChangedCommand="{Binding RecipeSelectionChangedCommand}" ToolTip="{Binding SelectedRecipeName}" AutomationProperties.Name="{Binding [WpfProjectConfig.SavedRecipes], Source={x:Static local:WpfLocalizationViewModel.Instance}}" />
                        <ui:Button x:Name="RefreshProjectRecipeListButton" Grid.Column="1" Style="{StaticResource ProjectConfigButtonStyle}" Margin="8,0,0,0" VerticalAlignment="Top" IsEnabled="{Binding IsRefreshRecipeListEnabled}" AutomationProperties.Name="{Binding [WpfProjectConfig.Refresh], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Command="{Binding RefreshRecipeListCommand}">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Style="{StaticResource ProjectConfigIconStyle}" Kind="Refresh" /><TextBlock Text="{Binding [WpfProjectConfig.Refresh], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" /></StackPanel>
                        </ui:Button>
                    </Grid>
                    <TextBlock x:Name="ProjectRecipeSelectionHelpText" Text="{Binding [WpfProjectConfig.SelectionHint], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock x:Name="ProjectConfigFilesTitleText" Text="{Binding [WpfProjectConfig.FilesTitle], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigHeadingStyle}" />
                    <TextBlock Text="{Binding [WpfProjectConfig.ConfigFile], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <TextBox x:Name="ProjectConfigPathBox" Style="{StaticResource ProjectConfigTextBoxStyle}" Text="{Binding ConfigPath, Mode=OneWay}" ToolTip="{Binding ConfigPath}" AutomationProperties.Name="{Binding [WpfProjectConfig.ConfigFile], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding [WpfProjectConfig.ManifestFile], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <TextBox x:Name="ProjectManifestPathBox" Style="{StaticResource ProjectConfigTextBoxStyle}" Text="{Binding ManifestPath, Mode=OneWay}" ToolTip="{Binding ManifestPath}" AutomationProperties.Name="{Binding [WpfProjectConfig.ManifestFile], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding [WpfProjectConfig.DatasetVersion], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <TextBox x:Name="ProjectDatasetVersionBox" Style="{StaticResource ProjectConfigTextBoxStyle}" Text="{Binding DatasetVersionText, Mode=OneWay}" ToolTip="{Binding DatasetVersionText}" AutomationProperties.Name="{Binding [WpfProjectConfig.DatasetVersion], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding [WpfProjectConfig.DatasetDetail], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Style="{StaticResource ProjectConfigLabelStyle}" />
                    <TextBox x:Name="ProjectDatasetVersionDetailBox" Style="{StaticResource ProjectConfigTextBoxStyle}" Text="{Binding DatasetVersionDetailText, Mode=OneWay}" ToolTip="{Binding DatasetVersionDetailText}" AutomationProperties.Name="{Binding [WpfProjectConfig.DatasetDetail], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Margin="0,0,0,14" />
                    <WrapPanel>
                        <ui:Button x:Name="SaveProjectConfigButton" Style="{StaticResource ProjectConfigSaveButtonStyle}" Margin="0,0,8,8" IsEnabled="{Binding IsSaveProjectConfigEnabled}" AutomationProperties.Name="{Binding [WpfProjectConfig.Save], Source={x:Static local:WpfLocalizationViewModel.Instance}}" ToolTip="{Binding [WpfProjectConfig.SaveHint], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Command="{Binding SaveProjectConfigCommand}">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Style="{StaticResource ProjectConfigIconStyle}" Kind="ContentSaveOutline" /><TextBlock Text="{Binding [WpfProjectConfig.Save], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" /></StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="OpenProjectConfigFolderButton" Style="{StaticResource ProjectConfigButtonStyle}" Margin="0,0,0,8" IsEnabled="{Binding IsOpenProjectConfigFolderEnabled}" AutomationProperties.Name="{Binding [WpfProjectConfig.OpenFolder], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Command="{Binding OpenProjectConfigFolderCommand}">
                            <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Style="{StaticResource ProjectConfigIconStyle}" Kind="FolderOpenOutline" /><TextBlock Text="{Binding [WpfProjectConfig.OpenFolder], Source={x:Static local:WpfLocalizationViewModel.Instance}}" VerticalAlignment="Center" /></StackPanel>
                        </ui:Button>
                    </WrapPanel>
                    <TextBlock x:Name="ProjectConfigSaveHelpText" Text="{Binding [WpfProjectConfig.SaveHint], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeMutedTextBrush}" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProjectConfigStatusText" Text="{Binding StatusText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Expander>
</UserControl>
