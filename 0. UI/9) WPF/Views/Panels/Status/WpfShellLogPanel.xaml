<UserControl x:Class="MvcVisionSystem.WpfShellLogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MvcVisionSystem"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:logView="clr-namespace:OpenVisionLab.Logging.Controls.View;assembly=OpenVisionLab.Logging.Controls"
             FlowDirection="LeftToRight">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ShellLogButtonStyle" TargetType="Button" BasedOn="{StaticResource RecipeSecondaryButtonStyle}">
                <Setter Property="Height" Value="38" /><Setter Property="Margin" Value="8,0,0,0" />
            </Style>
            <Style x:Key="ShellLogInputStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
                <Setter Property="Height" Value="38" /><Setter Property="MinWidth" Value="120" /><Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="CaretBrush" Value="{DynamicResource RecipeTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ShellLogComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
                <Setter Property="MinWidth" Value="120" /><Setter Property="Margin" Value="8,0,16,0" />
                <Setter Property="Background" Value="{DynamicResource DatasetInputBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
                <Setter Property="ItemTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" FontSize="13" /></DataTemplate></Setter.Value></Setter>
                <Style.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource RecipeDisabledBrush}" /><Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" /></Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="1" CornerRadius="7">
        <Grid>
            <Border x:Name="ShellLogCollapsedSummary" AutomationProperties.AutomationId="ShellLogCollapsedSummary"
                    Background="{DynamicResource RecipeSurfaceBrush}" CornerRadius="7" Visibility="{Binding CollapsedSummaryVisibility}">
                <Grid Margin="14,0,10,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <iconPacks:PackIconMaterial Kind="TextBoxSearchOutline" Width="16" Height="16" Margin="0,0,8,0" Foreground="{DynamicResource RecipeMutedTextBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Name="ShellLogCollapsedTitleText" AutomationProperties.AutomationId="ShellLogCollapsedTitleText" Text="{Binding [Pipeline.RunLog], Source={x:Static local:WpfLocalizationViewModel.Instance}}" Foreground="{DynamicResource RecipeTextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="ShellLogLatestSummaryText" Grid.Column="1" AutomationProperties.AutomationId="ShellLogLatestSummaryText"
                               Text="{Binding LatestLogText}" ToolTip="{Binding LatestLogText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border Grid.Column="2" Background="{DynamicResource RecipePageBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10,5" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ShellLogCollapsedCountText" AutomationProperties.AutomationId="ShellLogCollapsedCountText" Text="{Binding LogSummaryText}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" />
                    </Border>
                    <Button x:Name="ShellLogToggleButton" Grid.Column="3" Style="{StaticResource ShellLogButtonStyle}" MinWidth="100"
                            AutomationProperties.AutomationId="ShellLogToggleButton" AutomationProperties.Name="{Binding LogPaneToggleText}" ToolTip="{Binding LogPaneToggleToolTip}" Command="{Binding ToggleLogPaneCommand}">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Kind="ChevronUp" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LogPaneToggleText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
            <Grid x:Name="ShellLogExpandedContent" AutomationProperties.AutomationId="ShellLogExpandedContent" Visibility="{Binding ExpandedLogVisibility}">
                <logView:LogPanelView x:Name="ShellLogPanel" HeaderActionWidth="{Binding ActualWidth, ElementName=ShellLogExpandedToggleButton}" />
                        <Button x:Name="ShellLogExpandedToggleButton" Style="{StaticResource ShellLogButtonStyle}" MinWidth="100"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,8,14,0"
                                DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=local:WpfShellLogPanel}}"
                                AutomationProperties.AutomationId="ShellLogExpandedToggleButton" AutomationProperties.Name="{Binding LogPaneToggleText}" ToolTip="{Binding LogPaneToggleToolTip}" Command="{Binding ToggleLogPaneCommand}">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconMaterial Kind="ChevronDown" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding LogPaneToggleText}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
