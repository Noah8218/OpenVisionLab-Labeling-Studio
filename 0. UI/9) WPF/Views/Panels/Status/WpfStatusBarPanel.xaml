<UserControl x:Class="MvcVisionSystem.WpfStatusBarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource UiFontFamily}" FontSize="12" FlowDirection="LeftToRight">
    <UserControl.Resources>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FontSize" Value="12" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
    </UserControl.Resources>
    <Border x:Name="StatusBarSurface" Height="26" Padding="12,0" Background="{DynamicResource StatusBarBrush}"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="DatasetStatusText" AutomationProperties.AutomationId="DatasetStatusText" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,0,16,0">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}"><Setter Property="Text" Value="{Binding DatasetStatusText}" /><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsRecipeLibraryVisible, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True"><Setter Property="Text" Value="{Binding DataContext.LanguageViewModel[WpfRecipeStart.SelectPrompt], RelativeSource={RelativeSource AncestorType=DockPanel}}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <TextBlock x:Name="PythonStatusText" Grid.Column="1" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}"><Setter Property="Text" Value="{Binding PythonStatusText}" /><Setter Property="MaxWidth" Value="180" /><Setter Property="Margin" Value="0,0,16,0" /><Style.Triggers>
                    <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsRecipeLibraryVisible, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True">
                        <Setter Property="Text" Value="{Binding DataContext.MenuViewModel.EnvironmentSummaryText, RelativeSource={RelativeSource AncestorType=DockPanel}}" />
                        <Setter Property="MaxWidth" Value="240" /><Setter Property="Margin" Value="0" />
                    </DataTrigger>
                </Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Border x:Name="InspectionModelStatusBadge" Grid.Column="2" MaxWidth="240" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="{Binding InspectionModelStatusToolTip}">
                <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsRecipeLibraryVisible, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock x:Name="InspectionModelStatusText" AutomationProperties.AutomationId="InspectionModelStatusText" Text="{Binding InspectionModelStatusText}" Style="{StaticResource StatusTextStyle}" />
            </Border>
            <TextBlock x:Name="ModelStatusText" Grid.Column="3" MaxWidth="180" AutomationProperties.AutomationId="ModelStatusText" AutomationProperties.HelpText="{Binding ModelStatusAutomationText}"
                       Text="{Binding ModelStatusText}" ToolTip="{Binding ModelStatusText}">
                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding DataContext.ShellViewModel.IsRecipeLibraryVisible, RelativeSource={RelativeSource AncestorType=DockPanel}}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
            </TextBlock>
            <Border x:Name="AnnotationSaveStatusBadge" Visibility="Collapsed" ToolTip="{Binding AnnotationSaveStatusToolTip}">
                <TextBlock x:Name="AnnotationSaveStatusText" Text="{Binding AnnotationSaveStatusText}" />
            </Border>
            <TextBlock x:Name="WorkflowStageText" AutomationProperties.AutomationId="WorkflowStageText" Text="{Binding WorkflowStageText}" Visibility="Collapsed" />
            <TextBlock x:Name="WorkflowProgressText" AutomationProperties.AutomationId="WorkflowProgressText" Text="{Binding WorkflowProgressText}" Visibility="Collapsed" />
            <TextBlock x:Name="WorkflowNextActionText" AutomationProperties.AutomationId="WorkflowNextActionText" Text="{Binding WorkflowNextActionText}" Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>
