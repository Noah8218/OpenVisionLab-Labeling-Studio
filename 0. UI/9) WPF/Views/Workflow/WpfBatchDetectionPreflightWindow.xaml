<ui:FluentWindow x:Class="MvcVisionSystem.WpfBatchDetectionPreflightWindow"
                 x:Name="BatchDetectionPreflightWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="AI &#xBC30;&#xCE58; &#xAC80;&#xC0AC; &#xC0AC;&#xC804;&#xC810;&#xAC80;"
                 Width="1040"
                 Height="720"
                 MinWidth="900"
                 MinHeight="620"
                 Background="{DynamicResource AppBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <ResourceDictionary Source="../../Themes/WpfButtonStateTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0D0F" />
            <SolidColorBrush x:Key="PanelBrush" Color="#171717" />
            <SolidColorBrush x:Key="CanvasBrush" Color="#101820" />
            <SolidColorBrush x:Key="BorderBrushDark" Color="#303030" />
            <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F7F7F7" />
            <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7B7B7" />
            <SolidColorBrush x:Key="AccentBrush" Color="#E53935" />
            <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#252525" />
            <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#3A3A3A" />
            <SolidColorBrush x:Key="GridLineBrush" Color="#2A2A2A" />
            <SolidColorBrush x:Key="GridHeaderBrush" Color="#202020" />
            <Style x:Key="PreflightButtonStyle" TargetType="{x:Type ui:Button}">
                <Setter Property="Template" Value="{StaticResource WpfUiDarkButtonTemplate}" />
                <Setter Property="Height" Value="34" />
                <Setter Property="MinWidth" Value="96" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            </Style>
            <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="DetailTextStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="FontFamily" Value="Segoe UI" />
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </ui:FluentWindow.Resources>

    <Grid Margin="22,42,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <iconPacks:PackIconMaterial Kind="ClipboardSearchOutline" Width="28" Height="28"
                                        Foreground="{DynamicResource AccentBrush}" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="AI &#xBC30;&#xCE58; &#xAC80;&#xC0AC; &#xC0AC;&#xC804;&#xC810;&#xAC80;"
                           Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI"
                           FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="&#xC2E4;&#xD589; &#xC804;&#xC5D0; &#xB300;&#xC0C1;, &#xBAA8;&#xB378;, &#xD074;&#xB798;&#xC2A4;, &#xAE30;&#xC874; &#xB77C;&#xBCA8; &#xC815;&#xCC45;&#xC744; &#xD655;&#xC778;&#xD569;&#xB2C8;&#xB2E4;."
                           Style="{StaticResource DetailTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource CanvasBrush}"
                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                    CornerRadius="4" Padding="12,7">
                <StackPanel>
                    <TextBlock Text="{Binding ScopeText}" Foreground="{DynamicResource PrimaryTextBrush}"
                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="10" Margin="0,2,0,0" HorizontalAlignment="Right"
                               AutomationProperties.AutomationId="BatchPreflightStatusText" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="1. &#xC2E4;&#xD589; &#xACC4;&#xC57D;" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource DetailTextStyle}" Margin="0,8,0,0" />
                        <TextBlock Text="&#xBAA8;&#xB378; / &#xC784;&#xACC4;&#xAC12;" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding ModelText}" Style="{StaticResource DetailTextStyle}" Margin="0,7,0,0" />
                        <TextBlock Text="&#xAE30;&#xC874; &#xB77C;&#xBCA8; &#xCC98;&#xB9AC;" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0" />
                        <ComboBox ItemsSource="{Binding ExistingLabelPolicies}"
                                  SelectedItem="{Binding SelectedExistingLabelPolicy}"
                                  DisplayMemberPath="DisplayText" Margin="0,7,0,0"
                                  AutomationProperties.AutomationId="BatchExistingLabelPolicyBox"
                                  AutomationProperties.Name="&#xAE30;&#xC874; &#xB77C;&#xBCA8; &#xCC98;&#xB9AC; &#xC815;&#xCC45;" />
                        <TextBlock Text="{Binding SelectedExistingLabelPolicy.DetailText}"
                                   Style="{StaticResource DetailTextStyle}" Margin="0,6,0,0" />
                        <TextBlock Text="&#xACB0;&#xACFC; &#xC804;&#xB2EC; &#xC815;&#xCC45;" Style="{StaticResource SectionTitleStyle}" Margin="0,18,0,0" />
                        <Border Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource BorderBrushDark}"
                                BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,7,0,0">
                            <TextBlock Text="{Binding DestinationPolicyText}" Style="{StaticResource DetailTextStyle}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="210" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="2. Recipe &#xD074;&#xB798;&#xC2A4; &#xB9E4;&#xD551;" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Grid.Row="1" Text="{Binding ClassContractText}" Style="{StaticResource DetailTextStyle}" Margin="0,5,0,8" />
                        <DataGrid Grid.Row="2" ItemsSource="{Binding ClassMappings}" IsReadOnly="True"
                                  AutoGenerateColumns="False" HeadersVisibility="Column"
                                  AutomationProperties.Name="Recipe &#xD074;&#xB798;&#xC2A4; &#xB9E4;&#xD551;">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Index}" Width="60" />
                                <DataGridTextColumn Header="Recipe &#xD074;&#xB798;&#xC2A4;" Binding="{Binding RecipeClassName}" Width="*" />
                                <DataGridTextColumn Header="worker &#xC774;&#xB984; &#xB9E4;&#xD551;" Binding="{Binding WorkerMappingText}" Width="280" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrushDark}"
                        BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="3. &#xCC28;&#xB2E8; &#xBC0F; &#xC8FC;&#xC758; &#xD56D;&#xBAA9;"
                                   Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" IsReadOnly="True"
                                  AutoGenerateColumns="False"
                                  AutomationProperties.Name="AI &#xBC30;&#xCE58; &#xC0AC;&#xC804;&#xC810;&#xAC80; &#xACB0;&#xACFC;">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#xAD6C;&#xBD84;" Binding="{Binding SeverityText}" Width="72" />
                                <DataGridTextColumn Header="&#xC0C1;&#xC138;" Binding="{Binding Text}" Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="Padding" Value="0,5" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&#xC2DC;&#xC791;&#xC744; &#xB204;&#xB974;&#xAE30; &#xC804;&#xAE4C;&#xC9C0; worker &#xC2E4;&#xD589;&#xACFC; &#xB77C;&#xBCA8; &#xBCC0;&#xACBD;&#xC740; &#xC5C6;&#xC2B5;&#xB2C8;&#xB2E4;."
                       Style="{StaticResource DetailTextStyle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <ui:Button Style="{StaticResource PreflightButtonStyle}" Command="{Binding RecheckCommand}"
                           AutomationProperties.AutomationId="BatchPreflightRecheckButton"
                           AutomationProperties.Name="&#xC0AC;&#xC804;&#xC810;&#xAC80; &#xB2E4;&#xC2DC; &#xC2E4;&#xD589;">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Refresh" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="&#xB2E4;&#xC2DC; &#xC810;&#xAC80;" />
                    </StackPanel>
                </ui:Button>
                <ui:Button Margin="8,0,0,0" Style="{StaticResource PreflightButtonStyle}"
                           Click="CancelButton_Click" AutomationProperties.Name="&#xCDE8;&#xC18C;">
                    <TextBlock Text="&#xCDE8;&#xC18C;" />
                </ui:Button>
                <ui:Button x:Name="BatchPreflightStartButton" Margin="8,0,0,0" MinWidth="112"
                           Style="{StaticResource PreflightButtonStyle}" Command="{Binding StartCommand}"
                           IsEnabled="{Binding CanStart}" AutomationProperties.AutomationId="BatchPreflightStartButton"
                           AutomationProperties.Name="AI &#xBC30;&#xCE58; &#xAC80;&#xC0AC; &#xC2DC;&#xC791;">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Play" Width="14" Height="14" Margin="0,0,6,0" />
                        <TextBlock Text="&#xC2DC;&#xC791;" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
