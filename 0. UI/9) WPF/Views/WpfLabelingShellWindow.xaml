                          mvvm:EventCommandBehavior.Command="{Binding ShellViewModel.WorkflowPaneResizeCommand, ElementName=ShellWindow}"
                          mvvm:EventCommandBehavior.CommandParameter="{Binding ElementName=RightWorkflowColumn, Path=ActualWidth}" >
