                    <Style TargetType="GridSplitter">
                        <Setter Property="Background" Value="{DynamicResource BorderBrushDark}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShellViewModel.IsDatasetStageActive}" Value="True">
                                <Setter Property="Template" Value="{DynamicResource DatasetSplitterTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ShellViewModel.IsLabelingStageActive, ElementName=ShellWindow}" Value="True">
