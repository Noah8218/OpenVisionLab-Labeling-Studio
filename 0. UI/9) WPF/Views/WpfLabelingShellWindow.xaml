                    <Setter Property="Margin" Value="0,0,4,0" /><Style.Triggers>
<DataTrigger Binding="{Binding ShellViewModel.IsDatasetStageActive}" Value="True">
                <Setter Property="Margin" Value="0" /><Setter Property="Background" Value="{DynamicResource DatasetSurfaceBrush}" />
