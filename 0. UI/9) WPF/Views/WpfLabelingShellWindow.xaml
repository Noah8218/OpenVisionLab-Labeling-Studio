                        <Condition Binding="{Binding ShellViewModel.IsCanvasWorkspaceVisible, ElementName=ShellWindow}" Value="True" />
                        <Condition Binding="{Binding ImageQueueViewModel.IsAnomalyGridActive, ElementName=ShellWindow}" Value="False" />
                    </MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers>
                </Style></local:WpfCanvasPanel.Style>
