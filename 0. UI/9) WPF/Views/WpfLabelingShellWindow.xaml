                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="#283040" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,12,12">
                        <Button x:Name="RecipeImportFooterCloseButton" HorizontalAlignment="Right" Style="{StaticResource RecipePrimaryButtonStyle}" Height="31" MinHeight="30" FontSize="13" Padding="10,5"
                                Content="{Binding LanguageViewModel[ShellSettings.Close]}" Command="{Binding MenuViewModel.CloseShellDialogCommand}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="EnvironmentOverlay" Panel.ZIndex="31" Background="#B305080C" IsVisibleChanged="OnShellDialogVisibilityChanged"
              Visibility="{Binding MenuViewModel.IsEnvironmentOpen, Converter={StaticResource BooleanToVisibilityConverter}}" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.InputBindings><KeyBinding Key="Escape" Command="{Binding MenuViewModel.CloseShellDialogCommand}" /></Grid.InputBindings>
            <Border x:Name="EnvironmentCard" Width="560" MaxHeight="520" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#161B22" BorderBrush="{DynamicResource RecipeButtonBorderBrush}" BorderThickness="1" CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid Margin="20,16,20,10">
                        <TextBlock Text="{Binding LanguageViewModel[ShellSettings.EnvironmentTitle]}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="EnvironmentCloseButton" Style="{StaticResource RecipeQuietButtonStyle}" Content="✕" Command="{Binding MenuViewModel.CloseShellDialogCommand}"
                                Width="30" Height="30" MinHeight="30" Padding="4" HorizontalAlignment="Right" AutomationProperties.Name="{Binding LanguageViewModel[WpfComparisonWorkspace.Cancel]}" AutomationProperties.AutomationId="EnvironmentCloseButton" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="20,6,20,16">
                        <StackPanel>
                            <TextBlock Text="{Binding MenuViewModel.EnvironmentSummaryText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock Text="{Binding LanguageViewModel[ShellSettings.EnvironmentUnknown]}" Foreground="#F5C26B" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />
                            <TextBlock x:Name="EnvironmentReadOnlyText" Text="{Binding LanguageViewModel[ShellSettings.EnvironmentReadOnly]}" Foreground="{DynamicResource RecipeMutedTextBrush}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="{DynamicResource PanelHeaderBrush}" BorderBrush="#283040" BorderThickness="0,1,0,0" Padding="20,12" CornerRadius="0,0,12,12">
                        <Button Style="{StaticResource RecipeSecondaryButtonStyle}" Content="{Binding LanguageViewModel[ShellSettings.EnvironmentSetup]}" Command="{Binding MenuViewModel.OpenEnvironmentSetupCommand}" HorizontalAlignment="Right" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ui:FluentWindow>
