<ui:FluentWindow x:Class="MvcVisionSystem.WpfLabelingShellWindow"
                 x:Name="ShellWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:local="clr-namespace:MvcVisionSystem"
                 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                 xmlns:mvvm="clr-namespace:OpenVisionLab.Mvvm.Behaviors;assembly=OpenVisionLab.Mvvm"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="OpenVisionLab-Labelling Studio"
                 Width="1920"
                 Height="1080"
                 MinWidth="1200"
                 MinHeight="720"
                 Background="{DynamicResource AppBackgroundBrush}"
                 FontFamily="{DynamicResource UiFontFamily}"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 mvvm:WindowLifecycleCommandBehavior.LoadedCommand="{Binding ShellViewModel.LoadedCommand}"
                 mvvm:WindowLifecycleCommandBehavior.ClosedCommand="{Binding ShellViewModel.ClosedCommand}"
                 mvvm:WindowLifecycleCommandBehavior.DeactivatedCommand="{Binding ShellViewModel.DeactivatedCommand}"
                 mvvm:InputCommandBehaviors.PreviewKeyInputCommand="{Binding ShellViewModel.PreviewKeyDownCommand}"
                 mvvm:InputCommandBehaviors.PreviewKeyUpInputCommand="{Binding ShellViewModel.PreviewKeyUpCommand}">
    <ui:FluentWindow.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ui:ThemesDictionary Theme="Dark" />
            <ui:ControlsDictionary />
            <ResourceDictionary Source="../Themes/WpfButtonStateTemplates.xaml" />
        </ResourceDictionary.MergedDictionaries>

        <Style TargetType="{x:Type ToolTip}" BasedOn="{StaticResource DefaultToolTipStyle}">
            <Style.Resources>
                <local:KoreanWordBoundaryConverter x:Key="ToolTipKoreanWordBoundaryConverter" />
                <DataTemplate xmlns:sys="clr-namespace:System;assembly=mscorlib" DataType="{x:Type sys:String}">
                    <TextBlock Text="{Binding Mode=OneWay, Converter={StaticResource ToolTipKoreanWordBoundaryConverter}}"
                               AutomationProperties.Name="{Binding Mode=OneWay}" TextWrapping="Wrap" TextTrimming="None" />
                </DataTemplate>
            </Style.Resources>
        </Style>


        <local:KoreanWordBoundaryConverter x:Key="ShellGuidanceWordBoundaryConverter" />

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0E1116" />
        <SolidColorBrush x:Key="DialogBackdropBrush" Color="#B305080C" />
        <SolidColorBrush x:Key="FrameBrush" Color="#0B0E13" />
        <SolidColorBrush x:Key="PanelBrush" Color="#161B22" />
        <SolidColorBrush x:Key="PanelHeaderBrush" Color="#1B212A" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#0B0E12" />
        <SolidColorBrush x:Key="StatusBarBrush" Color="#0B0E13" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#283040" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6EBF2" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9AA6B6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="InfoBrush" Color="#4C8DFF" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#3CCF8E" />
        <SolidColorBrush x:Key="WarningBrush" Color="#F2B84B" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F06A6A" />
        <SolidColorBrush x:Key="ModelCenterCandidateBrush" Color="#38BDF8" />
        <SolidColorBrush x:Key="ModelCenterDecisionBrush" Color="#F59E0B" />
        <SolidColorBrush x:Key="ModelCenterCandidatePanelBrush" Color="#0D1E28" />
        <SolidColorBrush x:Key="ModelCenterDecisionPanelBrush" Color="#211807" />
        <SolidColorBrush x:Key="ToolbarButtonBrush" Color="#222A35" />
        <SolidColorBrush x:Key="ToolbarButtonBorderBrush" Color="#364152" />
        <SolidColorBrush x:Key="ToolbarButtonHoverBrush" Color="#2A3341" />
        <SolidColorBrush x:Key="ToolbarButtonPressedBrush" Color="#1D1D1D" />
        <SolidColorBrush x:Key="ToolbarButtonDisabledBrush" Color="#1B212A" />
        <SolidColorBrush x:Key="ToolbarButtonDisabledBorderBrush" Color="#283040" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#6F7B8C" />
        <SolidColorBrush x:Key="InputBrush" Color="#11161D" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#364152" />
        <SolidColorBrush x:Key="GridLineBrush" Color="#283040" />
        <SolidColorBrush x:Key="GridHeaderBrush" Color="#161B22" />
        <SolidColorBrush x:Key="RowHoverBrush" Color="#2A3341" />
        <SolidColorBrush x:Key="SelectedRowBrush" Color="#1A2738" />
        <SolidColorBrush x:Key="SelectedRowTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DetectionOverlayBackgroundBrush" Color="#F00B1320" />
        <SolidColorBrush x:Key="DetectionOverlayBorderBrush" Color="#5524D366" />
        <SolidColorBrush x:Key="DetectionOverlayTitleTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DetectionOverlaySummaryTextBrush" Color="#BEEBD0" />
        <SolidColorBrush x:Key="DetectionOverlaySelectedBackgroundBrush" Color="#1F24D366" />
        <SolidColorBrush x:Key="DetectionOverlaySelectedTextBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="DetectionOverlayDetailTextBrush" Color="#C9D4E2" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="ShellMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Command" Value="{Binding Command}" />
            <Setter Property="Header" Value="{Binding Caption}" />
            <Setter Property="ItemsSource" Value="{Binding Children}" />
            <Setter Property="InputGestureText" Value="{Binding Shortcut}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding Id}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Caption}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Reason}" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="mvvm:EventCommandBehavior.EventName" Value="SubmenuOpened" />
            <Setter Property="mvvm:EventCommandBehavior.Command" Value="{Binding DataContext.MenuViewModel.RefreshCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="MenuChrome" Background="{DynamicResource RecipeSurfaceBrush}"
                                    BorderBrush="Transparent" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" FontSize="12"
                                               Foreground="{DynamicResource RecipeMutedTextBrush}" Margin="16,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <StackPanel x:Name="MenuCaptionStack" MinWidth="64" MaxWidth="300" VerticalAlignment="Center">
                                        <AccessText Text="{TemplateBinding Header}" TextWrapping="Wrap"
                                                    Foreground="{TemplateBinding Foreground}" />
                                        <TextBlock x:Name="MenuReason" Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource RecipeMutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <Border x:Name="MenuFocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False">
                                <Border Background="{DynamicResource RecipeSurfaceBrush}" BorderBrush="{DynamicResource RecipeButtonBorderBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="6" MinWidth="336">
                                    <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader"><Setter TargetName="MenuCaptionStack" Property="MinWidth" Value="0" /><Setter TargetName="MenuReason" Property="Visibility" Value="Collapsed" /></Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader"><Setter TargetName="PART_Popup" Property="Placement" Value="Right" /></Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="MenuChrome" Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="MenuFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                                <Setter TargetName="MenuChrome" Property="Background" Value="Transparent" />
                                <Setter TargetName="MenuFocusCue" Property="BorderBrush" Value="Transparent" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WorkflowViewHostTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="WorkflowTabHeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0"
                                Margin="0,0,2,0"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="WorkflowTabHeaderContent"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource SecondaryTextBrush}" TextElement.FontWeight="Normal" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="WorkflowTabHeaderContent" Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="WorkflowTabHeaderContent" Property="TextElement.Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter TargetName="WorkflowTabHeaderContent" Property="TextElement.FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="Background" Value="{DynamicResource ToolbarButtonDisabledBrush}" />
                                <Setter TargetName="WorkflowTabHeaderBorder" Property="BorderBrush" Value="{DynamicResource ToolbarButtonDisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                                <Setter TargetName="WorkflowTabHeaderContent" Property="TextElement.Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShellViewModel.IsRightWorkflowSubNavigationVisible, RelativeSource={RelativeSource AncestorType={x:Type local:WpfLabelingShellWindow}}}"
                             Value="False">
                    <Setter Property="Height" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelCenterTaskTabControlStyle" TargetType="{x:Type TabControl}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Border Background="{DynamicResource ToolbarButtonBrush}"
                                BorderBrush="{DynamicResource ToolbarButtonBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="2">
                            <UniformGrid Rows="1" IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModelCenterTaskTabItemStyle" TargetType="{x:Type TabItem}">
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="5,6" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border x:Name="TaskTabBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TaskTabBorder" Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TaskTabBorder" Property="Background" Value="{DynamicResource PanelBrush}" />
                                <Setter TargetName="TaskTabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OperationsTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource ModelCenterTaskTabItemStyle}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Grid>
                            <Border x:Name="OperationsTabChrome" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <Border x:Name="OperationsTabFocusCue" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OperationsTabChrome" Property="Background" Value="{DynamicResource RecipeButtonHoverBrush}" />
                                <Setter TargetName="OperationsTabChrome" Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="OperationsTabChrome" Property="Background" Value="{DynamicResource RecipeSelectedBrush}" />
                                <Setter TargetName="OperationsTabChrome" Property="BorderBrush" Value="{DynamicResource RecipeSelectedBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeAccentBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="OperationsTabFocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="OperationsTabChrome" Property="Background" Value="{DynamicResource RecipeDisabledBrush}" />
                                <Setter TargetName="OperationsTabChrome" Property="BorderBrush" Value="{DynamicResource RecipeDisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource RecipeDisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TrainingTaskTabItemStyle" TargetType="{x:Type TabItem}" BasedOn="{StaticResource OperationsTabItemStyle}">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="OperationsTabControlStyle" TargetType="{x:Type TabControl}" BasedOn="{StaticResource ModelCenterTaskTabControlStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <Border BorderBrush="{DynamicResource RecipeBorderBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                            <WrapPanel IsItemsHost="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

            <Style x:Key="ShellDatasetLossConfirmationStyle" TargetType="CheckBox" BasedOn="{StaticResource RecipeCheckBoxStyle}">
                <Setter Property="MinHeight" Value="38" />
            </Style>
        <Style x:Key="ShellDatasetInputStyle" TargetType="TextBox" BasedOn="{StaticResource RecipeInputStyle}">
            <Setter Property="MinHeight" Value="38" /><Setter Property="Height" Value="Auto" /><Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="CaretBrush" Value="{DynamicResource RecipeTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" /><Setter Property="AcceptsReturn" Value="False" /><Setter Property="AcceptsTab" Value="False" />
            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonHoverBorderBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                <Trigger Property="IsReadOnly" Value="True"><Setter Property="Foreground" Value="{DynamicResource RecipeMutedTextBrush}" /></Trigger>
                <Trigger Property="Validation.HasError" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ShellDatasetComboStyle" TargetType="ComboBox" BasedOn="{StaticResource RecipeComboBoxStyle}">
            <Setter Property="MinHeight" Value="38" /><Setter Property="Height" Value="Auto" /><Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource RecipePageBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource RecipeButtonBorderBrush}" />
        </Style>
        <Style x:Key="ShellDatasetEvidenceExpanderStyle" TargetType="Expander" BasedOn="{StaticResource DatasetExpanderStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsSelected, ElementName=YoloModelCenterDataTaskTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <DataTemplate x:Key="OperationsMenuActionTemplate">
            <StackPanel Margin="0,0,8,8">
                <ui:Button Content="{Binding Caption}" Command="{Binding Command}"
                           Style="{DynamicResource RecipeSecondaryButtonStyle}"
                           MinWidth="155" MinHeight="38" FontSize="13" HorizontalAlignment="Left" Padding="12,6"
                           AutomationProperties.Name="{Binding Caption}" ToolTip="{Binding Reason}" />
                <TextBlock Text="{Binding Reason}" Foreground="{DynamicResource RecipeMutedTextBrush}"
                           TextWrapping="Wrap" Margin="2,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ModelCenterOverviewTaskVisibilityStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=YoloModelCenterOverviewTaskTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelCenterDataTaskVisibilityStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=YoloModelCenterDataTaskTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelCenterTrainingTaskVisibilityStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=YoloModelCenterTrainingTaskTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModelCenterRuntimeTaskVisibilityStyle" TargetType="{x:Type FrameworkElement}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, ElementName=YoloModelCenterDataTaskTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightWorkflowShortcutButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template" Value="{StaticResource WpfDarkButtonTemplate}" />
            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="FontFamily" Value="{DynamicResource UiFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                    <Setter Property="Opacity" Value="0.65" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RightWorkflowPanelActionButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource RightWorkflowShortcutButtonStyle}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,4" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="RightWorkflowDockButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Template" Value="{StaticResource WpfDarkButtonTemplate}" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Width" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource ToolbarButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ToolbarButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ToolbarButtonHoverBrush}" />
