                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Items.Count, ElementName=AnomalyGridList}" FontSize="13" FontWeight="Bold" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" />
                            <TextBlock Text="{Binding DataContext.LanguageViewModel[WpfImageQueue.Panel.ImageUnit], RelativeSource={RelativeSource AncestorType=Window}}" FontSize="13" FontWeight="Bold" LineHeight="18.85" LineStackingStrategy="BlockLineHeight" />
                        </StackPanel>
                        <TextBlock Text="{Binding AnomalyGridHintText}" FontSize="12" LineHeight="17.4" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" Foreground="#9AA6B6" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <ListBox x:Name="AnomalyGridList" Grid.Row="1" ItemsSource="{Binding AnomalyGridItems}"
                         UseLayoutRounding="False" local:AnomalyGridTileLayoutBehavior.IsEnabled="True" SelectionMode="Extended" Background="Transparent" BorderThickness="0" Padding="12"
                         IsEnabled="{Binding IsAnomalyDecisionAvailable}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="False"
                         AutomationProperties.AutomationId="AnomalyGridList" AutomationProperties.Name="{Binding AnomalyGridTitleText}"
                         mvvm:EventCommandBehavior.EventName="SelectionChanged"
                         mvvm:EventCommandBehavior.Command="{Binding AnomalyGridSelectionChangedCommand}"
                         mvvm:EventCommandBehavior.CommandParameter="{Binding SelectedItems, RelativeSource={RelativeSource Self}}">
                    <ListBox.Template><ControlTemplate TargetType="ListBox">
                        <ScrollViewer x:Name="AnomalyGridScrollViewer" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate></ListBox.Template>
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Margin="0,0,-10,0" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                        <Setter Property="Width" Value="{Binding Path=(local:AnomalyGridTileLayoutBehavior.TileWidth), RelativeSource={RelativeSource AncestorType=ListBox}}" /><Setter Property="Margin" Value="0,0,10,10" />
                        <Setter Property="local:AnomalyGridTileLayoutBehavior.CornerRadius" Value="8" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="IsSelected" Value="{Binding IsAnomalyGridSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding FileName}" />
                        <Setter Property="mvvm:EventCommandBehavior.EventName" Value="MouseDoubleClick" />
                        <Setter Property="mvvm:EventCommandBehavior.Command" Value="{Binding DataContext.OpenAnomalyGridImageCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                        <Setter Property="mvvm:EventCommandBehavior.CommandParameter" Value="{Binding}" />
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="TileBorder" Background="#11161D" BorderBrush="Transparent" BorderThickness="2" CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#4A586D" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#4C8DFF" /></Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="TileBorder" Property="BorderBrush" Value="#8AB4FF" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="{Binding Path=(local:AnomalyGridTileLayoutBehavior.TileImageHeight), RelativeSource={RelativeSource AncestorType=ListBox}}" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Image Source="{Binding GridThumbnailSource}" Stretch="UniformToFill" ClipToBounds="True" />
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="5" Padding="6,0" CornerRadius="4">
                                <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Normal"><Setter Property="Visibility" Value="Visible" /><Setter Property="Background" Value="#CC17402F" /></DataTrigger>
                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Abnormal"><Setter Property="Visibility" Value="Visible" /><Setter Property="Background" Value="#CC46202A" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></Border.Style>
                                <TextBlock x:Name="AnomalyGridVerdictTag" FontSize="11" FontWeight="Bold" LineHeight="15.95" LineStackingStrategy="BlockLineHeight"><TextBlock.Style><Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Normal"><Setter Property="Text" Value="{Binding DataContext.AnomalyNormalStateText, RelativeSource={RelativeSource AncestorType=ListBox}}" /><Setter Property="Foreground" Value="#9BE8C4" /></DataTrigger>
                                        <DataTrigger Binding="{Binding AnomalyReviewState}" Value="Abnormal"><Setter Property="Text" Value="{Binding DataContext.AnomalyAbnormalStateText, RelativeSource={RelativeSource AncestorType=ListBox}}" /><Setter Property="Foreground" Value="#FFB3B3" /></DataTrigger>
                                    </Style.Triggers>
                                </Style></TextBlock.Style></TextBlock>
                            </Border>
                            <Border Grid.Row="1" Background="#151A21" Padding="7,4" CornerRadius="0,0,6,6">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FileName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}" FontSize="11" LineHeight="15.95" LineStackingStrategy="BlockLineHeight" Foreground="#E6EBF2" />
                                    <TextBlock Grid.Column="1" ToolTip="{Binding LocalizedQueueStatusSummary}" FontSize="11" LineHeight="15.95" LineStackingStrategy="BlockLineHeight" Foreground="{Binding ImageReviewStatusBrush}" Margin="6,0,0,0"><Run Text="● " /><Run Text="{Binding LocalizedImageReviewStatusText, Mode=OneWay}" /></TextBlock>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Popup x:Name="AnomalyDecisionNoticePopup" Placement="Custom"
                   AllowsTransparency="True" StaysOpen="True" Focusable="False" FlowDirection="LeftToRight"
                   Tag="{Binding IsLoaded, ElementName=ShellWindow, Mode=OneWay}">
                <Popup.Style>
                    <Style TargetType="Popup">
                        <Setter Property="IsOpen" Value="False" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True" />
                                    <Condition Binding="{Binding IsVisible, ElementName=ShellWindow}" Value="True" />
                                    <Condition Binding="{Binding IsVisible, ElementName=MainWorkspaceGrid}" Value="True" />
                                    <Condition Binding="{Binding ShellViewModel.IsLabelingStageActive, ElementName=ShellWindow}" Value="True" />
                                    <Condition Binding="{Binding ShellViewModel.IsRecipeLibraryVisible, ElementName=ShellWindow}" Value="False" />
                                    <Condition Binding="{Binding IsAnomalyDecisionNoticeVisible}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="IsOpen" Value="True" />
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding WindowState, ElementName=ShellWindow}" Value="Minimized"><Setter Property="IsOpen" Value="False" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Popup.Style>
                <Border x:Name="AnomalyDecisionNotice" FlowDirection="LeftToRight"
                        Visibility="{Binding IsAnomalyDecisionNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Margin="24,16,24,32" Padding="14,7" CornerRadius="7.5"
                        Background="#1F2A3A" BorderBrush="#3C5378" BorderThickness="1">
                    <Border.Effect><DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="24" ShadowDepth="8" Direction="270" /></Border.Effect>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding AnomalyDecisionNoticeText}" FontFamily="{DynamicResource UiFontFamily}" FontSize="12" FontWeight="Normal"
                                   LineHeight="17.4" LineStackingStrategy="BlockLineHeight" Foreground="#E6EFFF" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.AutomationId="AnomalyDecisionNoticeText" />
                        <Button x:Name="UndoAnomalyDecisionNoticeButton" Grid.Column="1"
                                Height="24" MinHeight="24" FontFamily="{DynamicResource UiFontFamily}" FontSize="12" FontWeight="Normal"
                                TextBlock.LineHeight="17.4" TextBlock.LineStackingStrategy="BlockLineHeight" Padding="8,2" Margin="10,0,0,0"
                                Command="{Binding UndoAnomalyDecisionCommand}" Content="{Binding AnomalyUndoText}"
                                Visibility="{Binding IsAnomalyUndoNoticeVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="UndoAnomalyDecisionNoticeButton">
                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource RecipeSecondaryButtonStyle}"><Setter Property="Foreground" Value="#E6EFFF" /></Style></Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="ButtonChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5.5" SnapsToDevicePixels="True">
                                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True" />
                                        </Border>
                                        <Border x:Name="FocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusCue" Property="BorderBrush" Value="{DynamicResource RecipeFocusBrush}" /></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="FocusCue" Property="BorderBrush" Value="Transparent" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>
            </Popup>

