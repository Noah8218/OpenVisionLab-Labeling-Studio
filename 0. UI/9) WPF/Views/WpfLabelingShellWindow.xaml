                               ><RowDefinition.Style><Style TargetType="RowDefinition"><Setter Property="Height" Value="{Binding ShellLogViewModel.LogPaneSeparatorGridLength, ElementName=ShellWindow}" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding ShellViewModel.IsLabelingStageActive, ElementName=ShellWindow}" Value="True" /><Condition Binding="{Binding ShellLogViewModel.IsLogPaneExpanded, ElementName=ShellWindow}" Value="False" /></MultiDataTrigger.Conditions><Setter Property="Height" Value="0" /></MultiDataTrigger><DataTrigger Binding="{Binding ShellViewModel.IsInferenceStageActive, ElementName=ShellWindow}" Value="True"><Setter Property="Height" Value="0" /></DataTrigger></Style.Triggers></Style></RowDefinition.Style></RowDefinition>
