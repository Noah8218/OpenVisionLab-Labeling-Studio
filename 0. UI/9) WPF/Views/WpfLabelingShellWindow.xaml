                <local:WpfImageQueuePanel.Style>
                    <Style TargetType="local:WpfImageQueuePanel">
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ShellViewModel.IsDatasetStageActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Margin" Value="0"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </local:WpfImageQueuePanel.Style>
            </local:WpfImageQueuePanel>

