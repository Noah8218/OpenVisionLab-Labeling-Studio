<Project>
  <PropertyGroup>
    <Authors>최노아 (Noah-Choi)</Authors>
    <Company>Noah-Choi</Company>
    <Product>OpenVisionLab Labeling Studio</Product>
    <PackageId Condition="'$(MSBuildProjectName)' == 'OpenVisionLab.LabelingStudio'">OpenVisionLab.LabelingStudio</PackageId>
    <Copyright>Copyright (c) 2026 최노아 (Noah-Choi)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Noah8218/OpenVisionLab-Labeling-Studio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Noah8218/OpenVisionLab-Labeling-Studio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <OpenCvSharpVersion>4.5.5.20211231</OpenCvSharpVersion>
    <VersionPrefix>0.3.5</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>0.3.5.0</AssemblyVersion>
    <FileVersion>0.3.5.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <OpenVisionLabTestStorageRoot Condition="'$(OpenVisionLabTestStorageRoot)' == '' and '$(OPENVISIONLAB_TEST_STORAGE_ROOT)' != ''">$(OPENVISIONLAB_TEST_STORAGE_ROOT)</OpenVisionLabTestStorageRoot>
    <OpenVisionLabBuildInvocationKey Condition="'$(OpenVisionLabBuildInvocationKey)' == ''">default</OpenVisionLabBuildInvocationKey>
    <BaseIntermediateOutputPath Condition="'$(OpenVisionLabTestStorageRoot)' != ''">$(OpenVisionLabTestStorageRoot)\intermediate\$(OpenVisionLabBuildInvocationKey)\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(OpenVisionLabTestStorageRoot)' != ''">$(OpenVisionLabTestStorageRoot)\build\$(MSBuildProjectName)\</BaseOutputPath>
    <DefaultItemExcludes Condition="'$(OpenVisionLabTestStorageRoot)' != ''">$(DefaultItemExcludes);**\obj\**;**\bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
