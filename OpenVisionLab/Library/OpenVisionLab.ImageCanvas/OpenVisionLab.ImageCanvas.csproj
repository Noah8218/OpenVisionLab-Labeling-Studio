<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>OpenVisionLab.ImageCanvas</RootNamespace>
    <AssemblyName>OpenVisionLab.ImageCanvas</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImageCanvasCopyOpenCvVideoRuntime Condition="'$(ImageCanvasCopyOpenCvVideoRuntime)' == ''">true</ImageCanvasCopyOpenCvVideoRuntime>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="SharpGL">
      <HintPath>..\..\dll\SharpGL\SharpGL.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="SharpGL.WinForms">
      <HintPath>..\..\dll\SharpGL\SharpGL.WinForms.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenCvSharp4" Version="$(OpenCvSharpVersion)" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="$(OpenCvSharpVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenVisionLab.Localization\OpenVisionLab.Localization.csproj" />
    <ProjectReference Include="..\OpenVisionLab.Mvvm\OpenVisionLab.Mvvm.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\dll\OpenCVSharp\opencv_ffmpeg400_64.dll" Condition="'$(ImageCanvasCopyOpenCvVideoRuntime)' == 'true'">
      <Link>opencv_ffmpeg400_64.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
