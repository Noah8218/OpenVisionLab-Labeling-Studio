<UserControl x:Class="OpenVisionLab.Logging.Controls.View.LogPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converter="clr-namespace:OpenVisionLab.Logging.Controls.Converter"
             FlowDirection="LeftToRight"
             Foreground="{DynamicResource PrimaryTextBrush}"
             FontSize="13"
             MinWidth="280"
             MinHeight="80">
    <UserControl.Resources>
        <converter:BooleanToInverseConverter x:Key="BooleanToInverseConverter" />
        <converter:LogToneBrushConverter x:Key="LogToneBrushConverter" />

        <SolidColorBrush x:Key="ShellBrush" Color="#151A22" />
        <SolidColorBrush x:Key="PanelBrush" Color="#1B212B" />
        <SolidColorBrush x:Key="ListBrush" Color="#151A22" />
        <SolidColorBrush x:Key="RowBrush" Color="#151A22" />
        <SolidColorBrush x:Key="LineBrush" Color="#2D3745" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E8EDF5" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5B0C0" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#A5B0C0" />
        <SolidColorBrush x:Key="ActionBrush" Color="#285A70" />
        <SolidColorBrush x:Key="ActionHoverBrush" Color="#20495B" />
        <SolidColorBrush x:Key="ActionPressedBrush" Color="#183744" />
        <SolidColorBrush x:Key="ActionBorderBrush" Color="#4B8DA4" />
        <SolidColorBrush x:Key="InputBrush" Color="#101722" />
        <SolidColorBrush x:Key="BadgeBrush" Color="#232B37" />

        <Style TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="MinWidth" Value="92" />
            <Setter Property="Margin" Value="5,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#142033" />
            <Setter Property="Background" Value="#E8EDF5" />
            <Setter Property="BorderBrush" Value="#6D89A8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="ToolTip" Value="{Binding FilterComboToolTip}" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#142033" />
                        <Setter Property="Background" Value="#E8EDF5" />
                    </Style>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.38" />
                    <Setter Property="Foreground" Value="#546273" />
                    <Setter Property="Background" Value="#CBD4E0" />
                    <Setter Property="BorderBrush" Value="#596779" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="25" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="Margin" Value="5,0,0,0" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource ActionBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ActionBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ActionHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource ActionPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="{StaticResource PanelBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="25" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="#3B4654" />
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="7,2" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource ListBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="{StaticResource ListBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="DetailedOnlyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDetailedMode}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DetailedOnlyTextVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsDetailedMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogMessageTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
        </Style>

        <Style x:Key="EmptyLogTextVisibilityStyle" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasVisibleLogs}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterLabelTextStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEntireStream}" Value="True">
                    <Setter Property="Foreground" Value="#939FAF" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="620" /><Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{StaticResource PanelBrush}" /><Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="12,8" /><Setter Property="FontSize" Value="13" />
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" TextTrimming="None" /></DataTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource ShellBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Border DockPanel.Dock="Right" Width="{Binding HeaderActionWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" Margin="8,0,0,0" />
                    <Button x:Name="LogModeButton" DockPanel.Dock="Right" Style="{DynamicResource ShellLogButtonStyle}" MinWidth="76" Content="{Binding ModeButtonText}" Command="{Binding ToggleDetailCommand}" ToolTip="{Binding ModeToolTip}" AutomationProperties.Name="{Binding ModeButtonText}" />
                    <Border DockPanel.Dock="Right" Background="{StaticResource BadgeBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5" MinWidth="58" Margin="12,5,0,5" Padding="10,4">
                        <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding HeaderText}" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding LatestSummaryText}" ToolTip="{Binding LatestSummaryText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,7,0,0" />
                <DockPanel Grid.Row="2" LastChildFill="True" Style="{StaticResource DetailedOnlyVisibilityStyle}" Margin="0,8,0,0">
                    <Button x:Name="LogClearButton" DockPanel.Dock="Right" Style="{DynamicResource ShellLogButtonStyle}" Content="{Binding ClearText}" Command="{Binding ResetCommand}" ToolTip="{Binding ClearToolTip}" AutomationProperties.Name="{Binding ClearText}" />
                    <Button x:Name="LogFolderButton" DockPanel.Dock="Right" Style="{DynamicResource ShellLogButtonStyle}" Content="{Binding FolderText}" Command="{Binding OpenDirectoryCommand}" ToolTip="{Binding FolderToolTip}" AutomationProperties.Name="{Binding FolderText}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding SearchLabelText}" Margin="0,0,10,0" />
                    <TextBox x:Name="LogSearchBox" Style="{DynamicResource ShellLogInputStyle}" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SearchToolTip}" AutomationProperties.Name="{Binding SearchToolTip}" />
                </DockPanel>
                <WrapPanel Grid.Row="3" Margin="0,8,0,0" Style="{StaticResource DetailedOnlyVisibilityStyle}">
                    <CheckBox x:Name="LogAutoScrollCheck" Style="{DynamicResource ShellDatasetLossConfirmationStyle}" Margin="0,0,12,0" Content="{Binding AutoScrollText}" IsChecked="{Binding AutoScroll}" ToolTip="{Binding AutoScrollToolTip}" />
                    <CheckBox x:Name="LogAllLogsCheck" Style="{DynamicResource ShellDatasetLossConfirmationStyle}" Margin="0,0,12,0" Content="{Binding AllLogsText}" IsChecked="{Binding ShowEntireStream}" ToolTip="{Binding AllLogsToolTip}" />
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding LevelText}" Style="{StaticResource FilterLabelTextStyle}" /><ComboBox x:Name="LogLevelBox" Style="{DynamicResource ShellLogComboStyle}" IsEnabled="{Binding IsFilterControlsEnabled}" ItemsSource="{Binding Levels}" SelectedItem="{Binding SelectedLevel}" ToolTip="{Binding FilterComboToolTip}" AutomationProperties.Name="{Binding LevelText}" /></StackPanel>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding AreaText}" Style="{StaticResource FilterLabelTextStyle}" /><ComboBox x:Name="LogAreaBox" Style="{DynamicResource ShellLogComboStyle}" IsEnabled="{Binding IsFilterControlsEnabled}" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" ToolTip="{Binding FilterComboToolTip}" AutomationProperties.Name="{Binding AreaText}" /></StackPanel>
                </WrapPanel>
                <TextBlock Grid.Row="4" Text="{Binding ClearHintText}" Style="{StaticResource DetailedOnlyTextVisibilityStyle}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="None" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" Background="{StaticResource PanelBrush}" Margin="0,0,0,1" MinHeight="28">
            <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="100" /><ColumnDefinition Width="85" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="{Binding TimeLabelText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,0,0" FontSize="12" />
            <TextBlock Grid.Column="2" Text="{Binding LevelText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock Grid.Column="3" Text="{Binding AreaText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
            <TextBlock Grid.Column="4" Text="{Binding MessageLabelText}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </Grid>
        <Grid Grid.Row="2">
            <ListBox x:Name="LogList" ItemsSource="{Binding FilteredLogs}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource RowBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" ToolTip="{Binding RawText}">
                            <Grid MinHeight="38">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="5" /><ColumnDefinition Width="100" /><ColumnDefinition Width="85" /><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{Binding Level, Converter={StaticResource LogToneBrushConverter}}" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayTime}" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,6,0" FontSize="12" />
                                <TextBlock Grid.Column="2" Text="{Binding Level}" Foreground="{Binding Level, Converter={StaticResource LogToneBrushConverter}}" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Grid.Column="3" Text="{Binding Category}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,8,0" FontSize="12" TextWrapping="Wrap" TextTrimming="None" />
                                <StackPanel Grid.Column="4" Margin="0,6,12,6">
                                    <TextBlock Text="{Binding Source}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Style="{StaticResource DetailedOnlyTextVisibilityStyle}" TextWrapping="Wrap" TextTrimming="None" />
                                    <TextBlock Text="{Binding Message}" Foreground="{Binding Level, Converter={StaticResource LogToneBrushConverter}}" Style="{StaticResource LogMessageTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="LogEmptyText" Text="{Binding EmptyText}" Style="{StaticResource EmptyLogTextVisibilityStyle}" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" TextWrapping="Wrap" TextTrimming="None" Margin="12" />
        </Grid>
    </Grid>
</UserControl>
