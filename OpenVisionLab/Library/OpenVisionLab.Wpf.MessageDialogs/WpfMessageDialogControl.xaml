<UserControl x:Class="OpenVisionLab.Wpf.MessageDialogs.WpfMessageDialogControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420"
             MaxWidth="620">
    <UserControl.Resources>
        <Style x:Key="DialogButtonBaseStyle" TargetType="{x:Type Button}">
            <Setter Property="MinWidth" Value="90" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="8,4,0,0" />
            <Setter Property="MaxWidth" Value="220" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="Segoe UI, Malgun Gothic" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid>
                            <Border x:Name="ButtonChrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <ContentPresenter Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Border>
                            <Border x:Name="FocusCue" BorderBrush="Transparent" BorderThickness="2" CornerRadius="7" IsHitTestVisible="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#303B4B" /><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#697D99" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonChrome" Property="Background" Value="#1B2330" /><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#8CB5FF" /></Trigger>
                            <Trigger Property="IsDefaulted" Value="True"><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#A9C9FF" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusCue" Property="BorderBrush" Value="#A9C9FF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonChrome" Property="Background" Value="#202732" /><Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#333E4F" /><Setter Property="Foreground" Value="#939FAF" /><Setter TargetName="FocusCue" Property="BorderBrush" Value="Transparent" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonBaseStyle}">
            <Setter Property="Background" Value="#285FBC" />
            <Setter Property="BorderBrush" Value="#4276CE" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SecondaryDialogButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource DialogButtonBaseStyle}">
            <Setter Property="Background" Value="#232B37" />
            <Setter Property="BorderBrush" Value="#3C485B" />
            <Setter Property="Foreground" Value="#E8EDF5" />
        </Style>
        <DataTemplate x:Key="DialogButtonContentTemplate"><AccessText Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center" /></DataTemplate>
    </UserControl.Resources>

    <Border x:Name="ShellBorder"
            Background="#1B212B"
            BorderBrush="#3C485B"
            BorderThickness="1"
            CornerRadius="12"
            Padding="22"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="KindBadge"
                    Width="32"
                    Height="32"
                    CornerRadius="7"
                    Background="#3B82F6"
                    Margin="0,0,16,0"
                    VerticalAlignment="Top">
                <TextBlock x:Name="KindGlyph"
                           Text="i"
                           Foreground="White"
                           FontFamily="Segoe UI, Malgun Gothic"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1">
                <Border x:Name="AccentBar" Visibility="Collapsed"
                        Height="3"
                        Width="52"
                        HorizontalAlignment="Left"
                        Background="#3B82F6"
                        CornerRadius="2"
                        Margin="0,0,0,12" />
                <TextBlock x:Name="TitleText"
                           Text="Message"
                           Foreground="#E8EDF5"
                           FontFamily="Segoe UI, Malgun Gothic"
                           FontSize="15" LineHeight="21.75" LineStackingStrategy="BlockLineHeight"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <Grid Margin="0,10,0,0">
                    <ScrollViewer x:Name="MessageScrollViewer" MaxHeight="260" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="2" Focusable="True" IsTabStop="True">
                    <TextBlock x:Name="MessageText"
                               Text=""
                               Foreground="#E8EDF5"
                               FontFamily="Segoe UI, Malgun Gothic"
                               FontSize="13"
                               LineHeight="18.85" LineStackingStrategy="BlockLineHeight"
                               TextWrapping="Wrap"
                               Margin="0" />
                    </ScrollViewer>
                    <Border x:Name="MessageFocusCue" BorderBrush="#A9C9FF" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=MessageScrollViewer}" Value="True"><Setter Property="Opacity" Value="1" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
                <Border x:Name="DetailsContainer"
                        Visibility="Collapsed"
                        Background="#14181F"
                        BorderBrush="#3C485B"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,14,0,0">
                    <StackPanel>
                        <Button x:Name="DetailsToggleButton" Style="{StaticResource SecondaryDialogButtonStyle}" HorizontalAlignment="Left"
                                AutomationProperties.Name="{Binding Text, ElementName=DetailsCaption}" Click="OnDetailsToggleClicked">
                            <StackPanel Orientation="Horizontal"><TextBlock x:Name="DetailsCaption" Text="상세 정보" /><TextBlock x:Name="DetailsChevron" Text="⌄" Margin="8,0,0,0" /></StackPanel>
                        </Button>
                        <TextBox x:Name="DetailsTextBox"
                                 Visibility="Collapsed"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#E8EDF5"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 MaxHeight="180"
                                 Margin="0,8,0,0"
                                 VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <WrapPanel x:Name="ButtonPanel"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0" />
        </Grid>
    </Border>
</UserControl>
