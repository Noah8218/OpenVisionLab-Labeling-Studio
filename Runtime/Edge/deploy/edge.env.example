# Copy to edge.env and set WSL/Linux paths for this machine. Values below are placeholders.
# Model package prepared with ovl_edge.cli.export_onnx / build_engines (contains model_spec.json and engines/).
OVL_MODEL_DIR=/srv/ovl-edge/model
# Keep shared frames on the Linux file system: /mnt/<drive> (9P) added ~5 ms per frame read in M5.
OVL_FRAMES_DIR=/srv/ovl-edge/frames
OVL_RESULTS_DIR=/srv/ovl-edge/results
# Simulator only (profile "sim"): images it sends as requests.
OVL_SIM_IMAGES_DIR=/srv/ovl-edge/sim-images
OVL_RULE_FILE=./rule.demo-coco.json
OVL_RUNTIME=trt-fp16
OVL_BUDGET_MS=50
OVL_SIM_COUNT=3000
OVL_SIM_TICK_MS=10
