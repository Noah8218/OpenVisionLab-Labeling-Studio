{
  "uid": "ovl-edge-p99",
  "title": "OpenVisionLab 엣지 검사 p99",
  "description": "검사 p99 = 요청 측 단조 시계로 잰 검사 요청 → 다음 틱 판정 반영. 값은 Prometheus 히스토그램 버킷 추정값이며, 벤치마크 표의 p99(요청별 저장 시간에서 직접 계산)와 다르다.",
  "tags": ["openvisionlab", "edge"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "templating": {"list": []},
  "annotations": {"list": []},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "검사 p99 (최근 5분)",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(ovl_inspection_e2e_seconds_bucket[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 2, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 40}, {"color": "red", "value": 50}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 2, "type": "stat", "title": "시간 예산",
      "gridPos": {"x": 6, "y": 0, "w": 3, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "1000 * max(ovl_inspection_budget_seconds)"}],
      "fieldConfig": {"defaults": {"unit": "ms", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 3, "type": "stat", "title": "완료 / 전체 요청 (요청 측 시작 이후)",
      "description": "누적 카운터 원값이다. increase()는 창 경계에서 외삽하므로 정확한 건수 표시에 쓰지 않는다(첫 실행에서 3,000건이 3,061건으로 표시됨).",
      "gridPos": {"x": 9, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "완료", "expr": "sum(ovl_inspection_outcomes_total{outcome=~\"applied_.*\"})"},
        {"refId": "B", "legendFormat": "전체", "expr": "sum(ovl_inspection_requests_total)"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "none", "graphMode": "none", "textMode": "value_and_name"}
    },
    {
      "id": 4, "type": "stat", "title": "타임아웃률 (최근 5분)",
      "gridPos": {"x": 15, "y": 0, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(increase(ovl_inspection_outcomes_total{outcome=\"timeout\"}[5m])) or vector(0)) / clamp_min(sum(increase(ovl_inspection_requests_total[5m])), 1)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.001}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 5, "type": "stat", "title": "p99 표본 수 (최근 5분, 추정)",
      "description": "100개 미만이면 p99 추정이 불안정하므로 '표본 부족'으로 표시한다. increase() 외삽 때문에 실제 건수와 몇 % 다를 수 있다.",
      "gridPos": {"x": 19, "y": 0, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "round(sum(increase(ovl_inspection_e2e_seconds_count[5m])))"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0,
        "mappings": [{"type": "range", "options": {"from": 0, "to": 99.999, "result": {"text": "표본 부족", "color": "orange"}}}],
        "color": {"mode": "fixed", "fixedColor": "text"}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "value", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 6, "type": "timeseries", "title": "검사 지연 p50 / p99 (1분 창)과 예산",
      "gridPos": {"x": 0, "y": 5, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "p99", "expr": "1000 * histogram_quantile(0.99, sum by (le) (rate(ovl_inspection_e2e_seconds_bucket[1m])))"},
        {"refId": "B", "legendFormat": "p50", "expr": "1000 * histogram_quantile(0.50, sum by (le) (rate(ovl_inspection_e2e_seconds_bucket[1m])))"},
        {"refId": "C", "legendFormat": "예산", "expr": "1000 * max(ovl_inspection_budget_seconds)"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 2, "fillOpacity": 0}}, "overrides": [
        {"matcher": {"id": "byName", "options": "예산"}, "properties": [{"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [10, 10]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}]}
      ]},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 7, "type": "timeseries", "title": "단계별 p99 (1분 창): 요청 측 대기·틱 대기, 워커 단계",
      "description": "result_wait = 요청 → 결과 확인(폴링·전송·워커 처리 포함), tick_wait = 결과 확인 → 다음 틱 반영. 워커 단계는 컨테이너 안에서 잰 시간이다. 단계별 p99는 합산하지 않는다.",
      "gridPos": {"x": 0, "y": 13, "w": 24, "h": 9},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "요청측 {{phase}}", "expr": "1000 * histogram_quantile(0.99, sum by (le, phase) (rate(ovl_inspection_phase_seconds_bucket[1m])))"},
        {"refId": "B", "legendFormat": "워커 {{stage}}", "expr": "1000 * histogram_quantile(0.99, sum by (le, stage) (rate(ovl_worker_stage_seconds_bucket[1m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms", "custom": {"lineWidth": 1, "fillOpacity": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 8, "type": "timeseries", "title": "결과 구분별 처리 수 (1분당)",
      "gridPos": {"x": 0, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "legendFormat": "{{outcome}}", "expr": "sum by (outcome) (increase(ovl_inspection_outcomes_total[1m]))"}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "bars", "fillOpacity": 60, "stacking": {"mode": "normal"}}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 9, "type": "table", "title": "워커 식별 정보와 오류",
      "gridPos": {"x": 12, "y": 22, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "format": "table", "instant": true, "expr": "ovl_worker_info"},
        {"refId": "B", "format": "table", "instant": true, "expr": "sum by (kind) (ovl_worker_errors_total)"},
        {"refId": "C", "format": "table", "instant": true, "expr": "sum by (reason) (ovl_worker_result_rewrites_total)"},
        {"refId": "D", "format": "table", "instant": true, "expr": "max(ovl_worker_degraded)"},
        {"refId": "E", "format": "table", "instant": true, "expr": "max by (tier) (ovl_worker_active_tier) == 1"},
        {"refId": "F", "format": "table", "instant": true, "expr": "sum by (from_tier, to_tier, kind) (ovl_worker_tier_switches_total)"}
      ],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 10, "type": "table", "title": "발생 중인 알람",
      "description": "Prometheus 알람 규칙(deploy/observability/alerts.yml) 중 지금 발생(firing)한 것. critical은 라인에 영향이 있는 증상, warning은 원인 상태다.",
      "gridPos": {"x": 0, "y": 30, "w": 24, "h": 6},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "format": "table", "instant": true, "expr": "ALERTS{alertstate=\"firing\"}"}],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {}, "overrides": []}
    },
    {
      "id": 11, "type": "stat", "title": "정상 오검출률 (최근 15분)",
      "description": "정답이 정상인 부품 중 Ng로 판정된 비율. 현장에서는 Ng 부품 재검사 결과로 정답이 들어온다.",
      "gridPos": {"x": 0, "y": 36, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(increase(ovl_inspection_quality_total{verdict=\"ng\",truth=\"ok\"}[15m])) / clamp_min(sum(increase(ovl_inspection_quality_total{truth=\"ok\"}[15m])), 1)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.03}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "textMode": "value"}
    },
    {
      "id": 12, "type": "stat", "title": "불량 유출 확인 건수 (누적)",
      "description": "정답이 불량인데 Pass로 판정된 부품. 현장에서는 감사 표본·반품으로 늦게 확인된다. 1건이라도 있으면 critical 알람.",
      "gridPos": {"x": 6, "y": 36, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "sum(ovl_inspection_quality_total{verdict=\"pass\",truth=\"ng\"}) or vector(0)"}],
      "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 13, "type": "stat", "title": "수동 검사 보류 비율 (최근 5분)",
      "gridPos": {"x": 12, "y": 36, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "(sum(increase(ovl_inspection_quality_total{verdict=\"hold\"}[5m])) or vector(0)) / clamp_min(sum(increase(ovl_inspection_quality_total[5m])), 1)"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.05}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "area", "textMode": "value"}
    },
    {
      "id": 14, "type": "stat", "title": "워커 가동률 (최근 1시간)",
      "description": "Prometheus가 워커 지표를 수집한 비율(up). 수집 간격 5초 기준이다.",
      "gridPos": {"x": 18, "y": 36, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [{"refId": "A", "expr": "avg_over_time(up{job=\"edge-worker\"}[1h])"}],
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "color": {"mode": "thresholds"},
        "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.99}, {"color": "green", "value": 0.999}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}
    },
    {
      "id": 15, "type": "timeseries", "title": "GPU 온도·전력·사용률·SM 클럭",
      "gridPos": {"x": 0, "y": 41, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "온도 (°C)", "expr": "ovl_gpu_temperature_celsius"},
        {"refId": "B", "legendFormat": "전력 (W)", "expr": "ovl_gpu_power_watts"},
        {"refId": "C", "legendFormat": "사용률 (%)", "expr": "100 * ovl_gpu_utilization_ratio"},
        {"refId": "D", "legendFormat": "SM 클럭 (100 MHz)", "expr": "ovl_gpu_sm_clock_mhz / 100"}
      ],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 1, "fillOpacity": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"]}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 16, "type": "timeseries", "title": "메모리: GPU 사용량과 워커 프로세스 RSS",
      "gridPos": {"x": 12, "y": 41, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "ovl-prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "GPU 사용", "expr": "ovl_gpu_memory_used_bytes"},
        {"refId": "B", "legendFormat": "GPU 전체", "expr": "ovl_gpu_memory_total_bytes"},
        {"refId": "C", "legendFormat": "워커 RSS", "expr": "ovl_worker_rss_bytes"}
      ],
      "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 1, "fillOpacity": 0}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    }
  ]
}
